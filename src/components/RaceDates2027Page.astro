---
import OrganizerWorkflow from './OrganizerWorkflow.astro';
import { buildPlanningMonthSections, buildPlanningOverview, fetchPlanning2027, formatEventPlanningDate, formatPlanningEventCount, formatPlanningRange, formatPlanningRegion, formatPlanningSurface, formatPlanningUpdated, formatPlanningWeekEventCount, formatPlanningWeekStatus, hasPlanningMonthSection, hasPlanningWeekTarget, planningWeekendsForMonth, type PlanningEvent } from '../utils-planning-2027';
interface Props { lang: 'sl' | 'en'; }
const { lang } = Astro.props; const en = lang === 'en';
const payload = await fetchPlanning2027(); const events = payload?.data ?? [];
const overview = buildPlanningOverview(events); const monthSections = buildPlanningMonthSections(events);
const regions = [...new Set(events.map(e => e.regija).filter(Boolean))].sort((a,b) => a.localeCompare(b, lang));
const surfaces = [...new Set(events.map(e => e.tip_podlage).filter(Boolean))].sort((a,b) => a.localeCompare(b, lang));
const months = en ? ['January','February','March','April','May','June','July','August','September','October','November','December'] : ['Januar','Februar','Marec','April','Maj','Junij','Julij','Avgust','September','Oktober','November','December'];
const statusLabel = (e: PlanningEvent) => e.status === 'potrjeno' ? (en?'Confirmed':'Potrjeno') : e.status === 'termin_znan' ? (en?'Date window known':'Termin znan') : (en?'Expected · STK estimate':'Pričakovano · ocena STK');
const details = (e: PlanningEvent) => [e.kraj || (en?'Location not provided':'Kraj ni naveden'), formatPlanningRegion(e.regija,lang), formatPlanningSurface(e.tip_podlage,lang)].filter(Boolean).join(' · ');
const weekendCount = new Map(overview.weekends.map(w => [w.start,w.total]));
const finderHref=en?'/en/find-races/':'/iskalnik-tekov/'; const formHref=en?'/en/add-or-correct-race/':'/dodaj-ali-popravi-tek/';
---
<main class="race-dates-page" data-planning-root data-lang={lang}>
  <section class="page-hero container"><span class="eyebrow">{en?'FOR ORGANISERS':'ZA ORGANIZATORJE'}</span><h1>{en?'Plan 2027 race dates':'Načrtovanje tekaških terminov 2027'}</h1><p>{en?'Compare the dates STK currently knows, then add or update your race.':'Primerjajte termine, ki jih STK trenutno pozna, nato dodajte ali posodobite svoj tek.'}</p></section>
  <section class="container planning-workflow"><OrganizerWorkflow {lang} active={1} compact /></section>
  <section class="section container planning-intro">
    <ul class="planning-status-guide" aria-label={en?'Date status explanation':'Pojasnilo statusov terminov'}>
      <li><strong>{en?'Confirmed':'Potrjeno'}</strong><span> — {en?'official date':'uradni termin'}</span></li>
      <li><strong>{en?'Date window known':'Termin znan'}</strong><span> — {en?'officially known period':'uradno znano obdobje'}</span></li>
      <li><strong>{en?'Expected · STK estimate':'Pričakovano · ocena STK'}</strong><span> — {en?'an estimate, not organiser-confirmed':'ocena, ni potrditev organizatorja'}</span></li>
    </ul>
    <p class="planning-updated" data-planning-updated hidden={!formatPlanningUpdated(payload?.generated_at ?? '',lang)}>{en?'Last updated:':'Nazadnje osveženo:'} <time>{formatPlanningUpdated(payload?.generated_at ?? '',lang)}</time></p>
  </section>
  <section class="section container planning-browser" aria-labelledby="overview-title">
    <div class="planning-fallback" data-planning-fallback hidden={Boolean(payload)} role="status">{en?'The race date planner is temporarily unavailable. Please try again later.':'Načrtovalnik terminov trenutno ni na voljo. Poskusite znova nekoliko pozneje.'}</div>
    <div data-planning-content hidden={!payload}>
      <form class="planning-filters" aria-label={en?'Filter the planner':'Filtriranje načrtovalnika'}>
        <label><span>{en?'Month':'Mesec'}</span><select name="month" data-planning-filter><option value="">{en?'All months':'Vsi meseci'}</option>{months.map((m,i)=><option value={String(i+1).padStart(2,'0')}>{m}</option>)}</select></label>
        <label><span>{en?'Region':'Regija'}</span><select name="region" data-planning-filter><option value="">{en?'All regions':'Vse regije'}</option>{regions.map(v=><option value={v}>{formatPlanningRegion(v,lang)}</option>)}</select></label>
        <label><span>{en?'Surface':'Tip podlage'}</span><select name="surface" data-planning-filter><option value="">{en?'All surfaces':'Vsi tipi podlage'}</option>{surfaces.map(v=><option value={v}>{formatPlanningSurface(v,lang)}</option>)}</select></label>
        <button type="button" class="planning-clear" data-planning-clear hidden>{en?'Clear filters':'Počisti filtre'}</button>
      </form>
      <div class="section-heading"><h2 id="overview-title">{en?'2027 year overview':'Pregled leta 2027'}</h2></div>
      <div class="year-overview" data-year-overview>{months.map((month,index)=>{const key=String(index+1).padStart(2,'0');return <section class="year-month" data-month={key}>{hasPlanningMonthSection(monthSections,key)?<a href={`#month-${key}`}><strong>{month}</strong></a>:<strong>{month}</strong>}<div>{planningWeekendsForMonth(key).map(w=>{const n=weekendCount.get(w.start)??0; const content=<><span>{new Date(`${w.start}T00:00:00Z`).getUTCDate()}.</span><strong>{n>=3?'3+':n}</strong></>; const label=`${formatPlanningRange(w.start,w.end,lang,false)}: ${formatPlanningEventCount(n,lang)}`; return n>0&&hasPlanningWeekTarget(monthSections,w.start)?<a href={`#week-${w.start}`} class={`weekend-count count-${Math.min(n,3)}`} aria-label={label}>{content}</a>:<span class={`weekend-count count-${Math.min(n,3)}`} role="img" aria-label={label}>{content}</span>})}</div></section>})}</div>
      <p class="planning-zero-note" data-planning-zero-note role="note">{en?'0 events means STK currently has no known event for that weekend. It does not mean the date is available.':'0 dogodkov pomeni, da STK za ta vikend trenutno nima znanega dogodka. To ne pomeni, da je termin prost.'}</p>
      <div class="planning-months" data-planning-weeks>{monthSections.map(({key,weeks})=><section class="planning-month" id={`month-${key}`}><h2>{months[Number(key)-1]}</h2><div>{weeks.map(w=><article class="planning-week" id={`week-${w.weekendStart}`}><h3>{formatPlanningRange(w.start,w.end,lang)}</h3><p class="week-counts"><strong>{formatPlanningWeekEventCount('weekend',w.weekendEvents.length,lang)}</strong><span>{formatPlanningWeekEventCount('weekday',w.weekdayEvents.length,lang)}</span></p><p class="week-statuses">{formatPlanningWeekStatus('potrjeno',w.confirmed,lang)} · {formatPlanningWeekStatus('pričakovano',w.expected,lang)} · {formatPlanningWeekStatus('termin_znan',w.known,lang)}</p><details><summary>{en?'Show':'Prikaži'} {formatPlanningEventCount(w.events.length,lang,'show')}</summary><ul class="planning-events">{w.events.map(e=><li class="planning-event"><div class="planning-event-main"><strong>{e.naziv_prireditve}</strong><span>{details(e)}</span><time>{formatEventPlanningDate(e,lang)}</time><em>{statusLabel(e)}</em></div></li>)}</ul></details></article>)}</div></section>)}</div>
      <p class="planning-empty" data-empty-results hidden>{en?'No dated events match the selected filters.':'Izbranim filtrom ne ustreza noben datiran dogodek.'}</p>
      <details class="planning-undated" data-unknown-events hidden={overview.unknown.length===0}><summary>{en?'Date not yet known':'Datum še ni znan'} · {formatPlanningEventCount(overview.unknown.length,lang)}</summary><ul class="planning-events">{overview.unknown.map(e=><li class="planning-event"><div class="planning-event-main"><strong>{e.naziv_prireditve}</strong><span>{details(e)}</span><time>{formatEventPlanningDate(e,lang)}</time><em>{statusLabel(e)}</em></div></li>)}</ul></details>
    </div>
  </section>
  <section class="section container organizer-final-cta" aria-labelledby="next-action"><h2 id="next-action">{en?'Have you set your race date?':'Ste določili termin svojega teka?'}</h2><div class="cta-row"><a class="button button-primary" href={formHref} data-organizer-action="confirm_race" data-organizer-placement="planner_final">{en?'Add or update a race':'Dodajte ali posodobite tek'}</a><a class="button organizer-dark-button" href={finderHref} data-organizer-action="find_race" data-organizer-placement="planner_final">{en?'Find your race':'Poiščite svoj tek'}</a></div></section>
</main>
<script is:inline type="application/json" id={`planning-2027-data-${lang}`} set:html={JSON.stringify(payload).replace(/</g,'\\u003c')} />
<script>import { initializePlanning2027 } from '../planning-2027-client'; document.querySelectorAll<HTMLElement>('[data-planning-root]').forEach(root=>{const lang=root.dataset.lang==='en'?'en':'sl';initializePlanning2027(root,JSON.parse(document.getElementById(`planning-2027-data-${lang}`)?.textContent??'null'),lang);});</script>
