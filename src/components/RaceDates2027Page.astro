---
interface Props { lang: 'sl' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
// Static demo/prototype data only. It is not loaded from the STK API and does not represent production data.
const weekends = [
  { short: '4.–5. 9.', longSl: '4.–5. september', longEn: '4–5 September', confirmed: 2, expected: 3, levelSl: 'Srednje zaseden', levelEn: 'Moderately busy', tone: 'medium', events: [{ name: 'Mestni tek ob reki', regionSl: 'Osrednjeslovenska', regionEn: 'Central Slovenia', typeSl: 'Cestni tek', typeEn: 'Road race', status: 'confirmed' }] },
  { short: '11.–12. 9.', longSl: '11.–12. september', longEn: '11–12 September', confirmed: 1, expected: 1, levelSl: 'Manj zaseden', levelEn: 'Less busy', tone: 'low', events: [{ name: 'Gozdni krog', regionSl: 'Gorenjska', regionEn: 'Upper Carniola', typeSl: 'Trail tek', typeEn: 'Trail race', status: 'expected' }] },
  { short: '18.–19. 9.', longSl: '18.–19. september', longEn: '18–19 September', confirmed: 3, expected: 4, levelSl: 'Bolj zaseden', levelEn: 'Busier', tone: 'high', events: [{ name: 'Tek med vinogradi', regionSl: 'Podravska', regionEn: 'Drava region', typeSl: 'Cestni tek', typeEn: 'Road race', status: 'confirmed' }, { name: 'Planinski izziv', regionSl: 'Savinjska', regionEn: 'Savinja region', typeSl: 'Gorski tek', typeEn: 'Mountain race', status: 'expected' }] },
  { short: '25.–26. 9.', longSl: '25.–26. september', longEn: '25–26 September', confirmed: 1, expected: 2, levelSl: 'Srednje zaseden', levelEn: 'Moderately busy', tone: 'medium', events: [{ name: 'Kraški jesenski tek', regionSl: 'Obalno-kraška', regionEn: 'Coastal–Karst', typeSl: 'Trail tek', typeEn: 'Trail race', status: 'expected' }] }
];
---
<main class="race-dates-page">
  <section class="page-hero container"><span class="eyebrow">{en ? 'FOR ORGANISERS' : 'ZA ORGANIZATORJE'}</span><h1>{en ? '2027 race date overview' : 'Pregled tekaških terminov 2027'}</h1><p>{en ? 'This overview helps organisers plan their season. Confirmed events have an official published date. Expected events are based on previous editions and are not yet confirmed for 2027.' : 'Pregled je namenjen organizatorjem pri načrtovanju sezone. Potrjeni dogodki imajo objavljen uradni termin. Pričakovani dogodki temeljijo na preteklih izvedbah in še niso potrjeni za 2027.'}</p></section>
  <section class="section container">
    <div class="prototype-notice" role="note"><strong>{en ? 'Prototype · demonstration data' : 'Prototip · demonstracijski podatki'}</strong><p>{en ? 'All weekends, counts and event names below are static examples. They are not production data.' : 'Vsi spodnji vikendi, števila in nazivi dogodkov so statični primeri. Ne gre za produkcijske podatke.'}</p></div>
    <div class="dates-filter-prototype" aria-label={en ? 'Prototype filters' : 'Prototipni filtri'}><span>{en ? 'Filter preview:' : 'Primer filtrov:'}</span><span>{en ? 'All regions' : 'Vse regije'}</span><span>{en ? 'All race types' : 'Vsi tipi teka'}</span><span>{en ? 'September' : 'September'}</span></div>
  </section>
  <section class="section container" aria-labelledby="weekends-title"><div class="section-heading"><h2 id="weekends-title">{en ? 'September weekends' : 'Septembrski vikendi'}</h2></div>
    <div class="dates-table-wrap"><table class="dates-table"><caption class="sr-only">{en ? 'Prototype weekend occupancy overview' : 'Prototipni pregled zasedenosti vikendov'}</caption><thead><tr><th>{en ? 'Weekend' : 'Vikend'}</th><th>{en ? 'Confirmed' : 'Potrjeni'}</th><th>{en ? 'Expected' : 'Pričakovani'}</th><th>{en ? 'Total' : 'Skupaj'}</th><th>{en ? 'Occupancy' : 'Zasedenost'}</th></tr></thead><tbody>{weekends.map((weekend) => <tr><th>{weekend.short}</th><td>{weekend.confirmed}</td><td>{weekend.expected}</td><td>{weekend.confirmed + weekend.expected}</td><td><strong class={`occupancy occupancy-${weekend.tone}`}>{en ? weekend.levelEn : weekend.levelSl}</strong></td></tr>)}</tbody></table></div>
    <div class="dates-mobile-list">{weekends.map((weekend) => <article class="weekend-card"><h3>{en ? weekend.longEn : weekend.longSl}</h3><p>{weekend.confirmed} {en ? 'confirmed' : 'potrjeni'} · {weekend.expected} {en ? 'expected' : 'pričakovani'}</p><strong class={`occupancy occupancy-${weekend.tone}`}>{en ? weekend.levelEn : weekend.levelSl}{en ? ' weekend' : ' vikend'}</strong><details><summary>{en ? 'Show example events' : 'Prikaži primere dogodkov'}</summary><ul class="demo-events">{weekend.events.map((event) => <li><div><strong>{event.name}</strong><span>{en ? event.regionEn : event.regionSl} · {en ? event.typeEn : event.typeSl}</span></div><span class={`event-status event-status-${event.status}`}>{event.status === 'confirmed' ? (en ? 'Confirmed' : 'Potrjeno') : (en ? 'Expected' : 'Pričakovano')}</span></li>)}</ul></details></article>)}</div>
  </section>
  <section class="section container organizer-final-cta"><a class="button organizer-dark-button" href={en ? '/en/for-organizers/' : '/za-organizatorje/'}>{en ? 'Back to organiser information' : 'Nazaj na stran za organizatorje'}</a></section>
</main>
