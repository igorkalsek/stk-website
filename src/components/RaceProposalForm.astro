---
import { googleProposalFormContract } from '../proposal-form/proposal-form-contract';
import { buildGoogleFormsFallbackUrl, readProposalPrefill, basicChangeCategoryValues } from '../proposal-form/proposal-form-controller';
import { proposalFormLocales, proposalTypeOptions } from '../proposal-form/proposal-form-locales';
import type { ProposalLanguage } from '../proposal-form/proposal-form-types';

const { lang = 'sl' } = Astro.props as { lang?: ProposalLanguage };
const emailPattern = String.raw`[^@\s]+@[^@\s]+\.[^@\s]+`;
const copy = proposalFormLocales[lang];
const emptyPrefill = readProposalPrefill(new URLSearchParams(), lang);
const fallbackUrl = buildGoogleFormsFallbackUrl(emptyPrefill);
const typeOptions = proposalTypeOptions(lang);
const additionalValues = googleProposalFormContract.values.additionalData;
const changeLabelFor = (value: string) => copy.labelsForValues.changeCategories[value as keyof typeof copy.labelsForValues.changeCategories];
const changeGroups = [
  { title: lang === 'en' ? 'Basic details' : 'Osnovni podatki', options: [...basicChangeCategoryValues].map((value) => ({ value, label: changeLabelFor(value) })) },
  { title: lang === 'en' ? 'Additional details' : 'Dodatni podatki', options: additionalValues.filter((value) => value !== 'Drugo').map((value) => ({ value, label: changeLabelFor(value) })) },
  { title: lang === 'en' ? 'Other' : 'Drugo', options: ['Drugo'].map((value) => ({ value, label: changeLabelFor(value) })) }
];
---
<section class="page-hero container proposal-hero" aria-labelledby="page-title">
  <span class="eyebrow">{copy.eyebrow}</span>
  <h1 id="page-title">{copy.title}</h1>
  <p>{copy.intro}</p>
  <p class="proposal-note">{copy.notAuto}</p>
</section>

<section class="section container correction-context" aria-labelledby="selected-race-title" data-correction-context hidden>
  <article class="info-card correction-context-card" data-context-card>
    <span class="eyebrow">{copy.contextTitle}</span>
    <h2 id="selected-race-title" data-prefill-title></h2>
    <p data-prefill-meta></p>
    <a class="correction-context-back" href="#" data-prefill-return hidden>{copy.back}</a>
    <div class="context-mini-links">
      <a href={`${copy.cleanPath}?mode=new`} data-context-new-link>{copy.addAnotherRace}</a>
      <a href={`${copy.cleanPath}?mode=other`} data-context-other-link>{copy.sendOther}</a>
    </div>
  </article>
</section>

<section class="section container published-details" aria-labelledby="published-details-title" data-published-details hidden>
  <article class="info-card published-details-card">
    <h2 id="published-details-title">{copy.currentDetails}</h2>
    <div class="published-details-groups" data-published-details-list></div>
    <button type="button" class="button button-secondary-light missing-details-action" data-missing-details-action hidden>{copy.addMissingDetails}</button>
  </article>
</section>

<section class="section container" aria-labelledby="form-title">
  <div class="proposal-panel">
    <div class="section-heading compact-heading">
      <h2 id="form-title" data-form-title>{copy.chooseType}</h2>
      <p>{copy.noSource}</p>
    </div>
    <div class="form-status" data-error-summary hidden tabindex="-1" role="alert"></div>
    <div class="form-status success" data-submit-status aria-live="polite" hidden></div>
    <form class="proposal-form" method="post" action={googleProposalFormContract.responseUrl} target="proposal-form-target" data-proposal-form novalidate>
      <fieldset class="proposal-type-fieldset">
        <legend>{copy.labels.proposalType}<span aria-hidden="true"> *</span></legend>
        <div class="proposal-type-grid">
          {typeOptions.map((option) => (
            <label class="proposal-choice">
              <input type="radio" name="proposal-type-ui" value={option.value} required data-proposal-type-ui data-field-label={copy.labels.proposalType} />
              <span>{option.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <input type="radio" name="proposal-type-ui" value="existing" hidden data-context-existing-radio data-proposal-type-ui data-field-label={copy.labels.proposalType} />
      <input type="hidden" name={googleProposalFormContract.fields.proposalType} value="" data-backend-proposal-type />
      <div data-additional-hidden-inputs></div>
      <div data-date-hidden-inputs></div>

      <div class="form-grid">
        <div data-field-row="date"><label for="proposal-date" data-label-text>{copy.labels.date}</label><span data-required-mark aria-hidden="true"> *</span><input id="proposal-date" name={googleProposalFormContract.fields.date} type="date" required value="" data-field-label={copy.labels.date} data-date-input /></div>
        <div data-field-row="title"><label for="proposal-title" data-label-text>{copy.labels.title}</label><span data-required-mark aria-hidden="true"> *</span><input id="proposal-title" name={googleProposalFormContract.fields.title} required value="" autocomplete="off" data-field-label={copy.labels.title} /></div>
        <div data-field-row="place"><label for="proposal-place" data-label-text>{copy.labels.place}</label><span data-required-mark aria-hidden="true"> *</span><input id="proposal-place" name={googleProposalFormContract.fields.place} required value="" autocomplete="address-level2" data-field-label={copy.labels.place} /></div>
        <div data-field-row="region"><label for="proposal-region" data-label-text>{copy.labels.region}</label><span data-required-mark aria-hidden="true"> *</span><select id="proposal-region" name={googleProposalFormContract.fields.region} required data-field-label={copy.labels.region}><option value=""></option>{googleProposalFormContract.values.regions.map((r) => <option value={r}>{copy.labelsForValues.regions[r]}</option>)}</select></div>
        <div class="full-span" data-field-row="source">
          <label for="proposal-source" data-label-text>{copy.labels.officialSource}</label>
          <input id="proposal-source" name={googleProposalFormContract.fields.officialSource} type="url" inputmode="url" placeholder={copy.placeholders.officialSource} value="" data-source-url data-field-label={copy.labels.officialSource} aria-describedby="proposal-source-helper proposal-source-error proposal-source-warning" />
          <small id="proposal-source-helper" class="field-helper">{copy.helpers.officialSource}</small>
          <small id="proposal-source-error" class="field-error" data-source-error hidden>{copy.sourceError}</small>
          <small id="proposal-source-warning" class="field-warning" data-source-warning hidden>{copy.sourceWarning}</small>
        </div>
        <fieldset class="full-span optional-fieldset" data-additional-section hidden aria-describedby="proposal-additional-helper proposal-additional-error">
          <legend>{copy.labels.additionalData}</legend>
          <p id="proposal-additional-helper" class="field-helper">{copy.helpers.additionalData}</p>
          <details class="change-options-details" data-change-options-details open>
            <summary>{copy.otherCorrectionOptions}</summary>
            <button type="button" class="button button-secondary-light show-all-changes" data-show-all-changes hidden>{copy.showAllChanges}</button>
            {changeGroups.map((group) => (
              <div class="change-category-group">
                <p class="change-category-title">{group.title}</p>
                <div class="checkbox-grid">{group.options.map((option) => <label><input type="checkbox" name="proposal-change-category" value={option.value} data-change-category /> <span>{option.label}</span></label>)}</div>
              </div>
            ))}
          </details>
          <p id="proposal-additional-error" class="field-error" data-additional-error hidden>{copy.changeError}</p>
        </fieldset>
        <div class="change-summary full-span" data-change-summary aria-live="polite" hidden><strong>{copy.selectedChanges}</strong><div class="change-chips" data-change-chips></div></div>
        <div class="full-span" data-field-row="description">
          <label for="proposal-description" data-label-text>{copy.labels.description}</label><span data-required-mark aria-hidden="true"> *</span>
          <textarea id="proposal-description" name={googleProposalFormContract.fields.description} required rows="7" placeholder={copy.placeholders.description} data-field-label={copy.labels.description} aria-describedby="proposal-description-helper"></textarea>
          <small id="proposal-description-helper" class="field-helper" data-description-helper>{copy.helpers.newDescription}</small>
        </div>
        <div class="full-span about-proposal" data-about-proposal><h3>{copy.aboutProposal}</h3><p>{copy.aboutProposalHelper}</p></div><div data-field-row="organizer"><label for="proposal-organizer" data-label-text>{copy.labels.organizer}</label><span data-required-mark aria-hidden="true"> *</span><select id="proposal-organizer" name={googleProposalFormContract.fields.organizer} required data-field-label={copy.labels.organizer}><option value=""></option>{googleProposalFormContract.values.yesNo.map((v) => <option value={v}>{copy.labelsForValues.yesNo[v]}</option>)}</select></div>
        <div data-field-row="announcement"><label for="proposal-announcement" data-label-text>{copy.labels.officialAnnouncement2026}</label><span data-required-mark aria-hidden="true"> *</span><select id="proposal-announcement" name={googleProposalFormContract.fields.officialAnnouncement2026} required data-field-label={copy.labels.officialAnnouncement2026}><option value=""></option>{googleProposalFormContract.values.announcement.map((v) => <option value={v}>{copy.labelsForValues.announcement[v]}</option>)}</select></div>
        <div class="full-span" data-field-row="email">
          <label for="proposal-email" data-label-text>{copy.labels.email}</label><span data-required-mark aria-hidden="true"> *</span>
          <input id="proposal-email" name={googleProposalFormContract.fields.email} type="email" pattern={emailPattern} required autocomplete="email" data-field-label={copy.labels.email} aria-describedby="proposal-email-helper" />
          <small id="proposal-email-helper" class="field-helper">{copy.helpers.email} <a href={lang === 'en' ? '/en/about/' : '/o-projektu-in-zasebnost/'}>{copy.helpers.privacy}</a></small>
        </div>
      </div>
      <div class="cta-row proposal-actions">
        <button class="button button-primary" type="submit" data-submit-button>{copy.submit}</button>
        <button class="button button-secondary-light" type="reset" data-reset-button>{copy.clear}</button>
        <a class="button button-secondary-light" href={copy.cleanPath} data-new-proposal-link hidden>{copy.newProposal}</a>
        <a class="button button-secondary-light" href={copy.calendarPath} data-calendar-link hidden>{copy.backToCalendar}</a>
      </div>
      <p class="proposal-fallback"><a href={fallbackUrl} target="_blank" rel="noopener noreferrer" data-correction-form-link data-analytics-link-type="correction_form">{copy.fallback}</a></p>
    </form>
    <iframe name="proposal-form-target" title="Google Forms submission target" hidden data-submit-target></iframe>
  </div>
</section>
<script>
  // @ts-nocheck
  import { googleProposalFormContract as contract } from '../proposal-form/proposal-form-contract';
  import { proposalFormLocales } from '../proposal-form/proposal-form-locales';
  import { readProposalPrefill, buildGoogleFormsFallbackUrl, parsePreselectedChangeCategories, getProposalFieldRules, parseProposalMode, fieldCategoryMap, basicChangeCategoryValues } from '../proposal-form/proposal-form-controller';

  const form = document.querySelector('[data-proposal-form]');
  const isEnglish = document.documentElement.lang?.startsWith('en') || window.location.pathname.startsWith('/en/');
  const copy = proposalFormLocales[isEnglish ? 'en' : 'sl'];
  const params = new URLSearchParams(window.location.search);
  const prefill = readProposalPrefill(params, isEnglish ? 'en' : 'sl');
  const hasRaceContext = Boolean(prefill.eventKey || (prefill.eventTitle && prefill.date && prefill.place));
  const contextSection = document.querySelector('[data-correction-context]');
  const publishedSection = document.querySelector('[data-published-details]');
  const publishedList = document.querySelector('[data-published-details-list]');
  const missingDetailsButton = document.querySelector('[data-missing-details-action]');
  const showAllChangesButton = document.querySelector('[data-show-all-changes]');
  const changeOptionsDetails = document.querySelector('[data-change-options-details]');
  const button = document.querySelector('[data-submit-button]');
  const status = document.querySelector('[data-submit-status]');
  const newProposalLink = document.querySelector('[data-new-proposal-link]');
  const calendarLink = document.querySelector('[data-calendar-link]');
  const resetButton = document.querySelector('[data-reset-button]');
  const errors = document.querySelector('[data-error-summary]');
  const source = document.querySelector('[data-source-url]');
  const sourceError = document.querySelector('[data-source-error]');
  const sourceWarning = document.querySelector('[data-source-warning]');
  const additionalSection = document.querySelector('[data-additional-section]');
  const additionalError = document.querySelector('[data-additional-error]');
  const additionalHiddenInputs = document.querySelector('[data-additional-hidden-inputs]');
  const dateHiddenInputs = document.querySelector('[data-date-hidden-inputs]');
  const backendProposalType = document.querySelector('[data-backend-proposal-type]');
  const changeSummary = document.querySelector('[data-change-summary]');
  const changeChips = document.querySelector('[data-change-chips]');
  const description = form?.elements.namedItem(contract.fields.description);
  const descriptionLabel = document.querySelector('[data-field-row="description"] [data-label-text]');
  const placeLabel = document.querySelector('[data-field-row="place"] [data-label-text]');
  const descriptionHelper = document.querySelector('[data-description-helper]');
  const formTitle = document.querySelector('[data-form-title]');
  const fallbackLink = document.querySelector('[data-correction-form-link]');
  const contextExistingRadio = document.querySelector('[data-context-existing-radio]');
  const proposalFieldset = document.querySelector('.proposal-type-fieldset');
  const additionalOnlyValues = contract.values.additionalData.filter((value) => value !== 'Drugo');
  const allowedAdditionalValues = contract.values.additionalData;
  let hasSubmittedToGoogle = false;
  let submissionComplete = false;
  let showAllChangeOptions = false;
  let missingDirectCategories = [];
  let commonContextChanges = [...basicChangeCategoryValues];

  const publishedFieldDefinitions = [
    { key: 'date', group: 'basic', labels: { sl: 'Datum', en: 'Date' }, category: fieldCategoryMap.date },
    { key: 'eventTitle', group: 'basic', labels: { sl: 'Naziv', en: 'Name' }, category: fieldCategoryMap.title },
    { key: 'place', group: 'basic', labels: { sl: 'Kraj', en: 'Place' }, category: fieldCategoryMap.place },
    { key: 'region', group: 'basic', labels: { sl: 'Regija', en: 'Region' }, category: fieldCategoryMap.region },
    { key: 'startTime', group: 'basic', labels: { sl: 'Čas začetka', en: 'Start time' }, category: fieldCategoryMap.startTime },
    { key: 'distances', group: 'basic', labels: { sl: 'Razdalje', en: 'Distances' }, category: fieldCategoryMap.distances },
    { key: 'surface', group: 'basic', labels: { sl: 'Vrsta podlage', en: 'Surface' }, category: fieldCategoryMap.surface },
    { key: 'noticeUrl', group: 'basic', linkLabels: { sl: 'Odpri razpis', en: 'Open announcement' }, labels: { sl: 'Uradni razpis', en: 'Official announcement' }, category: fieldCategoryMap.noticeUrl },
    { key: 'registrationUrl', group: 'basic', linkLabels: { sl: 'Odpri prijavo', en: 'Open registration' }, labels: { sl: 'Prijavna povezava', en: 'Registration link' }, category: fieldCategoryMap.registrationUrl },
    { key: 'cup', group: 'basic', labels: { sl: 'Pokal ali serija', en: 'Cup or series' }, category: fieldCategoryMap.cup },
    { key: 'registrationFee', group: 'extra', labels: { sl: 'Prijavnina', en: 'Entry fee' }, category: fieldCategoryMap.registrationFee },
    { key: 'registrationDeadline', group: 'extra', labels: { sl: 'Rok prijave', en: 'Registration deadline' }, category: fieldCategoryMap.registrationDeadline },
    { key: 'earlyRegistrationDeadline', group: 'extra', labels: { sl: 'Rok cenejše prijave', en: 'Cheaper registration deadline' }, category: fieldCategoryMap.earlyRegistrationDeadline },
    { key: 'dayOfRegistration', group: 'extra', labels: { sl: 'Prijave na dan dogodka', en: 'Race-day registration' }, category: fieldCategoryMap.dayOfRegistration },
    { key: 'elevationGain', group: 'extra', labels: { sl: 'Višinski metri', en: 'Elevation gain' }, category: fieldCategoryMap.elevationGain },
    { key: 'routeUrl', group: 'extra', linkLabels: { sl: 'Odpri traso', en: 'Open route' }, labels: { sl: 'Trasa, zemljevid ali GPX', en: 'Route, map or GPX' }, category: fieldCategoryMap.routeUrl }
  ];
  const clean = (value) => value && value !== '-' && value !== 'undefined' ? value : '';
  const valueForPublishedField = (key) => key === 'eventTitle' ? prefill.eventTitle : clean(prefill[key] || '');
  const setFieldValue = (name, value) => { const field = form?.elements.namedItem(name); if (field && 'value' in field) field.value = value || ''; };
  const isSafeInternalReturnUrl = (value) => Boolean(value && value.startsWith('/') && !value.startsWith('//') && !/^https?:\/\//i.test(value));
  const isSafeHttpUrl = (value) => { try { const url = new URL(value); return url.protocol === 'http:' || url.protocol === 'https:'; } catch { return false; } };
  const addProtocol = () => { if (!source) return; const value = source.value.trim(); if (value && !/^[a-z][a-z0-9+.-]*:\/\//i.test(value)) source.value = `https://${value}`; };
  const isStkUrl = () => { try { const url = new URL(source.value); const host = url.hostname.replace(/^www\./, ''); return host === 'tekaski-koledar.si'; } catch { return false; } };
  const validateSource = () => { addProtocol(); const value = source?.value.trim() || ''; const invalid = Boolean(value && !isSafeHttpUrl(value)); source?.setCustomValidity(invalid ? copy.sourceError : ''); if (invalid) source?.setAttribute('aria-invalid', 'true'); else source?.removeAttribute('aria-invalid'); if (sourceError) sourceError.hidden = !invalid; if (sourceWarning) sourceWarning.hidden = !value || !isStkUrl(); updateErrorSummary(); return !invalid; };
  const currentType = () => form?.querySelector('input[name="proposal-type-ui"]:checked')?.value || '';
  const selectedChangeBoxes = () => Array.from(form?.querySelectorAll('input[name="proposal-change-category"]:checked') || []);
  const selectedChangeValues = () => selectedChangeBoxes().map((box) => box.value);
  const selectedChangeLabels = () => selectedChangeBoxes().map((box) => box.closest('label')?.querySelector('span')?.textContent?.trim()).filter(Boolean);
  const mapExistingType = () => { const selected = selectedChangeValues(); return selected.length && selected.every((value) => additionalOnlyValues.includes(value)) ? contract.values.proposalTypes[2] : contract.values.proposalTypes[1]; };
  const backendTypeForCurrentSelection = () => currentType() === 'new' ? contract.values.proposalTypes[0] : currentType() === 'other' ? contract.values.proposalTypes[3] : mapExistingType();
  const setBackendType = () => { if (backendProposalType) backendProposalType.value = backendTypeForCurrentSelection(); };
  const clearAdditionalHiddenInputs = () => { if (additionalHiddenInputs) additionalHiddenInputs.innerHTML = ''; };
  const syncDateHiddenInputs = () => { if (!dateHiddenInputs) return; dateHiddenInputs.innerHTML = ''; const value = form?.elements.namedItem(contract.fields.date)?.value || ''; const [year, month, day] = value.split('-'); const parts = [[contract.fields.dateYear, year], [contract.fields.dateMonth, month], [contract.fields.dateDay, day]]; if (!year || !month || !day) return; for (const [name, part] of parts) { const input = document.createElement('input'); input.type = 'hidden'; input.name = name; input.value = String(Number(part)); dateHiddenInputs.append(input); } };
  const syncAdditionalHiddenInputs = () => { clearAdditionalHiddenInputs(); for (const value of selectedChangeValues().filter((value) => allowedAdditionalValues.includes(value))) { const input = document.createElement('input'); input.type = 'hidden'; input.name = contract.fields.additionalData; input.value = value; additionalHiddenInputs?.append(input); } };
  const listText = (labels) => labels.join('; ');
  const genericChangePlaceholder = () => isEnglish ? 'Enter the missing or correct detail.' : 'Navedite manjkajoči ali pravilen podatek.';
  const buildChangePlaceholder = () => { const labels = selectedChangeLabels(); return labels.length ? labels.map((label) => `${label}:`).join('\n') : genericChangePlaceholder(); };
  const stripStructuredHeader = (value) => value.replace(/^(Izbrane vrste sprememb:|Selected changes:).*?(?:\n\n|$)/s, '').trimStart();
  const buildStructuredDescription = () => { const labels = selectedChangeLabels(); const header = `${isEnglish ? 'Selected changes:' : 'Izbrane vrste sprememb:'} ${listText(labels)}`.trim(); const userText = stripStructuredHeader(description?.value || '').trim(); return userText ? `${header}\n\n${userText}` : header; };
  const updateChangeSummary = () => { const labels = selectedChangeLabels(); if (changeSummary) { changeSummary.hidden = labels.length === 0; if (changeChips) { changeChips.innerHTML = ''; for (const label of labels) { const chip = document.createElement('span'); chip.className = 'change-chip'; chip.textContent = label; changeChips.append(chip); } } } if (description && !description.value && currentType() === 'existing') description.placeholder = buildChangePlaceholder(); setBackendType(); syncAdditionalHiddenInputs(); syncDateHiddenInputs(); };
  const clearChangeError = () => { form?.querySelectorAll('input[name="proposal-change-category"]').forEach((box) => { box.setCustomValidity(''); box.removeAttribute('aria-invalid'); }); if (additionalError) additionalError.hidden = true; };
  const setRow = (key, rule) => { const row = document.querySelector(`[data-field-row="${key}"]`); const control = row?.querySelector('input,select,textarea'); if (!row || !control || !rule) return; row.hidden = !rule.visible; control.required = Boolean(rule.visible && rule.required); control.disabled = Boolean(rule.disabled || (!rule.visible && !rule.keepEnabledWhenHidden)); control.removeAttribute('aria-invalid'); control.setCustomValidity(''); const mark = row.querySelector('[data-required-mark]'); if (mark) mark.hidden = !(rule.visible && rule.required); };
  const getIdentityState = () => ({ date: Boolean(prefill.date), title: Boolean(prefill.eventTitle), place: Boolean(prefill.place), region: Boolean(prefill.region) });
  const computeFieldRules = (type) => { const identity = getIdentityState(); return getProposalFieldRules({ frontendType: type || 'new', hasRaceContext, hasCompleteRaceIdentity: identity.date && identity.title && identity.place && identity.region, identity }); };
  const setDescriptionCopy = (label, helper, placeholder = copy.placeholders.description) => { if (descriptionLabel) descriptionLabel.textContent = label; if (descriptionHelper) descriptionHelper.textContent = helper; if (description) { description.dataset.fieldLabel = label; description.placeholder = placeholder; } };
  const applyTypeUx = () => {
    const type = currentType(); const isNew = type === 'new', isExisting = type === 'existing'; const rules = computeFieldRules(type);
    setRow('date', rules.date); setRow('title', rules.title); setRow('place', rules.place); setRow('region', rules.region);
    setRow('organizer', rules.organizer); setRow('announcement', rules.announcement); setRow('source', rules.source); setRow('description', rules.description); setRow('email', rules.email);
    if (placeLabel) placeLabel.textContent = copy.labels.place;
    const place = form?.elements.namedItem(contract.fields.place); if (place) place.dataset.fieldLabel = placeLabel?.textContent || copy.labels.place;
    if (additionalSection) additionalSection.hidden = !isExisting;
    if (changeOptionsDetails) changeOptionsDetails.open = !hasRaceContext;
    form?.querySelectorAll('input[name="proposal-change-category"]').forEach((box) => { box.disabled = !isExisting; box.required = false; box.removeAttribute('aria-invalid'); box.setCustomValidity(''); });
    if (isNew) setDescriptionCopy(copy.dynamicLabels.newDescription, copy.helpers.newDescription, copy.placeholders.newDescription);
    else if (isExisting) setDescriptionCopy(copy.dynamicLabels.additionalDescription, copy.helpers.additionalDescription, buildChangePlaceholder());
    else setDescriptionCopy(copy.labels.description, copy.placeholders.otherDescription, copy.placeholders.otherDescription);
    if (!isExisting) { clearChangeError(); clearAdditionalHiddenInputs(); if (changeSummary) changeSummary.hidden = true; }
    updateChangeSummary(); setBackendType(); if (errors) errors.hidden = true;
  };
  const labelForField = (field) => field?.dataset?.fieldLabel || field?.closest('fieldset')?.querySelector('legend')?.textContent?.replace('*', '').trim() || '';
  const visibleInvalidFields = () => Array.from(form.querySelectorAll(':invalid')).filter((field) => !field.disabled && !field.closest('[hidden]'));
  const updateErrorSummary = () => { if (!errors || errors.hidden) return; const invalidFields = visibleInvalidFields(); if (!invalidFields.length) { errors.hidden = true; return; } errors.textContent = `${copy.errorTitle} ${[...new Set(invalidFields.map(labelForField).filter(Boolean))].join(', ')}`; };
  const showErrors = (fields) => { const labels = [...new Set(fields.map(labelForField).filter(Boolean))]; if (errors) { errors.hidden = false; errors.textContent = `${copy.errorTitle} ${labels.join(', ')}`; errors.focus(); } for (const field of fields) field?.setAttribute('aria-invalid', 'true'); };
  const updateChangeGroupVisibility = () => {
    document.querySelectorAll('.change-category-group').forEach((group) => {
      const visibleLabels = Array.from(group.querySelectorAll('label')).filter((label) => !label.hidden);
      group.hidden = visibleLabels.length === 0;
    });
  };
  const syncVisibleChangeOptions = () => { form?.querySelectorAll('input[name="proposal-change-category"]').forEach((box) => { const label = box.closest('label'); if (label) label.hidden = false; }); if (showAllChangesButton) showAllChangesButton.hidden = true; updateChangeGroupVisibility(); };
  const selectChangeCategory = (value) => { const box = form?.querySelector(`input[name="proposal-change-category"][value="${CSS.escape(value)}"]`); if (box) { box.closest('label').hidden = false; box.checked = true; } };
  const publishedGroupLabels = { basic: copy.basicDetails, extra: copy.extraDetails };
  const isPublishedUrlField = (definition, value) => Boolean(definition.linkLabels && isSafeHttpUrl(value));
  const updatePublishedDetails = () => {
    if (!publishedList) return;
    publishedList.innerHTML = '';
    const missingRows = [];
    for (const groupKey of ['basic', 'extra']) {
      const groupDefinitions = publishedFieldDefinitions.filter((definition) => definition.group === groupKey);
      const section = document.createElement('section'); section.className = 'published-detail-group';
      const heading = document.createElement('h3'); heading.textContent = publishedGroupLabels[groupKey];
      const list = document.createElement('dl'); list.className = 'published-details-grid';
      section.append(heading, list); publishedList.append(section);
      for (const definition of groupDefinitions) {
        const value = clean(valueForPublishedField(definition.key));
        if (!value) missingRows.push(definition);
        const item = document.createElement('div'); item.className = 'published-detail-item';
        const dt = document.createElement('dt'); dt.textContent = definition.labels[isEnglish ? 'en' : 'sl'];
        const dd = document.createElement('dd');
        if (isPublishedUrlField(definition, value)) { const link = document.createElement('a'); link.href = value; link.title = value; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = definition.linkLabels[isEnglish ? 'en' : 'sl']; dd.append(link); }
        else { dd.textContent = value || copy.missing; }
        if (!value) dd.classList.add('missing-value');
        const action = document.createElement('button'); action.type = 'button'; action.className = 'field-action'; action.dataset.fieldChange = definition.category; action.textContent = value ? copy.correct : copy.add;
        item.append(dt, dd, action); list.append(item);
      }
    }
    missingDirectCategories = [...new Set(missingRows.map((row) => row.category).filter((category) => !['basic-official-source', 'Drugo', 'Popravek napačnega dodatnega podatka'].includes(category)))];
    commonContextChanges = [...new Set([...basicChangeCategoryValues, ...missingRows.filter((row) => ['startTime', 'distances', 'surface', 'noticeUrl', 'registrationUrl', 'cup'].includes(row.key)).map((row) => row.category)])];
    if (missingDetailsButton) missingDetailsButton.hidden = !hasRaceContext || missingDirectCategories.length === 0;
  };
  const applyRuntimeContext = () => {
    setFieldValue(contract.fields.date, prefill.date); setFieldValue(contract.fields.title, prefill.eventTitle); setFieldValue(contract.fields.place, prefill.place); setFieldValue(contract.fields.region, prefill.region); setFieldValue(contract.fields.officialSource, prefill.officialSourceUrl); setFieldValue(contract.fields.description, prefill.description);
    if (formTitle) formTitle.textContent = hasRaceContext ? copy.contextTitle : copy.chooseType;
    if (fallbackLink) fallbackLink.href = buildGoogleFormsFallbackUrl(prefill);
    if (proposalFieldset) proposalFieldset.hidden = hasRaceContext;
    if (contextExistingRadio) contextExistingRadio.checked = hasRaceContext;
    if (contextSection) contextSection.hidden = !hasRaceContext;
    if (publishedSection) publishedSection.hidden = !hasRaceContext;
    const title = document.querySelector('[data-prefill-title]'); const meta = document.querySelector('[data-prefill-meta]'); const back = document.querySelector('[data-prefill-return]');
    if (title) title.textContent = prefill.eventTitle;
    if (meta) meta.textContent = [prefill.date || prefill.year, prefill.place].filter(Boolean).join(' · ');
    if (back) { back.hidden = !prefill.safeReturnUrl; if (prefill.safeReturnUrl) back.href = prefill.safeReturnUrl; }
    updatePublishedDetails();
    const mode = parseProposalMode(params.get('mode'));
    if (!hasRaceContext && mode) { const modeRadio = form?.querySelector(`input[name="proposal-type-ui"][value="${mode}"]`); if (modeRadio) modeRadio.checked = true; }
    for (const value of parsePreselectedChangeCategories(params.get('changes'))) selectChangeCategory(value);
    syncVisibleChangeOptions(); applyTypeUx(); validateSource();
    form?.setAttribute('data-proposal-runtime-ready', 'true');
  };

  showAllChangesButton?.addEventListener('click', () => { showAllChangeOptions = true; syncVisibleChangeOptions(); });
  missingDetailsButton?.addEventListener('click', () => { for (const value of missingDirectCategories) selectChangeCategory(value); clearChangeError(); updateChangeSummary(); syncVisibleChangeOptions(); description?.scrollIntoView({ behavior: 'smooth', block: 'center' }); description?.focus({ preventScroll: true }); });
  publishedList?.addEventListener('click', (event) => { const button = event.target?.closest?.('[data-field-change]'); if (!button) return; selectChangeCategory(button.dataset.fieldChange); clearChangeError(); updateChangeSummary(); syncVisibleChangeOptions(); description?.scrollIntoView({ behavior: 'smooth', block: 'center' }); description?.focus({ preventScroll: true }); });
  form?.querySelectorAll('input[name="proposal-type-ui"]').forEach((radio) => radio.addEventListener('change', applyTypeUx));
  source?.addEventListener('blur', validateSource);
  source?.addEventListener('input', () => { source.setCustomValidity(''); source.removeAttribute('aria-invalid'); if (sourceError) sourceError.hidden = true; if (sourceWarning) sourceWarning.hidden = true; updateErrorSummary(); });
  form?.addEventListener('input', (event) => { const field = event.target; if (field?.matches?.('input,select,textarea')) { field.setCustomValidity?.(''); field.removeAttribute('aria-invalid'); if (field === source) validateSource(); else updateErrorSummary(); } });
  form?.addEventListener('change', (event) => { const field = event.target; if (field?.matches?.('input,select,textarea')) { field.setCustomValidity?.(''); field.removeAttribute('aria-invalid'); } if (field?.name === 'proposal-change-category') { if (selectedChangeValues().length) clearChangeError(); syncVisibleChangeOptions(); updateChangeSummary(); updateErrorSummary(); } else updateErrorSummary(); });
  form?.addEventListener('submit', (event) => {
    if (submissionComplete) { event.preventDefault(); return; }
    validateSource(); form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    if (currentType() === 'existing') { const checked = selectedChangeValues().length; const first = form.querySelector('input[name="proposal-change-category"]'); first?.setCustomValidity(checked ? '' : copy.changeError); if (!checked) { if (additionalError) additionalError.hidden = false; form.querySelectorAll('input[name="proposal-change-category"]').forEach((box) => box.setAttribute('aria-invalid', 'true')); } else { clearChangeError(); } }
    setBackendType(); syncAdditionalHiddenInputs(); syncDateHiddenInputs();
    const invalidFields = visibleInvalidFields(); if (invalidFields.length) { event.preventDefault(); showErrors(invalidFields); invalidFields[0]?.focus(); return; }
    if (currentType() === 'existing' && description) description.value = buildStructuredDescription();
    if (errors) { errors.hidden = true; errors.textContent = ''; } if (button) { button.disabled = true; button.textContent = copy.submitting; } if (resetButton) resetButton.hidden = true; hasSubmittedToGoogle = true; if (status) { status.hidden = false; status.classList.remove('success'); status.textContent = copy.submitting; }
  });
  form?.addEventListener('reset', (event) => { if (hasRaceContext && !window.confirm(copy.resetConfirm)) { event.preventDefault(); return; } setTimeout(() => { hasSubmittedToGoogle = false; submissionComplete = false; if (errors) errors.hidden = true; if (status) { status.hidden = true; status.textContent = ''; } if (resetButton) resetButton.hidden = false; if (button) { button.disabled = false; button.textContent = copy.submit; button.hidden = false; } if (newProposalLink) newProposalLink.hidden = true; if (calendarLink) calendarLink.hidden = true; form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid')); clearAdditionalHiddenInputs(); if (dateHiddenInputs) dateHiddenInputs.innerHTML = ''; applyRuntimeContext(); }, 0); });
  document.querySelector('[data-submit-target]')?.addEventListener('load', () => { if (!hasSubmittedToGoogle) return; submissionComplete = true; if (button) { button.disabled = true; button.hidden = true; } if (resetButton) resetButton.hidden = true; if (newProposalLink) newProposalLink.hidden = false; if (calendarLink) calendarLink.hidden = false; if (errors) { errors.hidden = true; errors.textContent = ''; } if (status) { status.hidden = false; status.classList.add('success'); status.textContent = copy.sent; } });
  applyRuntimeContext();
</script>
