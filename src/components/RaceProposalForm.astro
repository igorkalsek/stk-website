  const syncVisibleChangeOptions = () => { form?.querySelectorAll('input[name="proposal-change-category"]').forEach((box) => { const label = box.closest('label'); if (label) label.hidden = hasRaceContext && Boolean(legacyBasicTargetMap[box.value]); }); if (showAllChangesButton) showAllChangesButton.hidden = true; updateChangeGroupVisibility(); };
  const legacyBasicTargetMap = { 'basic-date-time': 'date', 'basic-title-place': 'title', 'basic-distance-surface': 'distances', 'basic-official-source': 'noticeUrl', 'basic-cup-series': 'cup' };
  const selectChangeCategory = (value) => { if (hasRaceContext && legacyBasicTargetMap[value]) { const field = form?.querySelector(`[data-basic-correction-field="${legacyBasicTargetMap[value]}"]`); field?.closest('[data-basic-card]')?.setAttribute('data-legacy-change-active', 'true'); return; } const box = form?.querySelector(`input[name="proposal-change-category"][value="${CSS.escape(value)}"]`); if (box) { box.closest('label').hidden = false; box.checked = true; } };
  const publishedGroupLabels = { basic: copy.basicDetails, extra: copy.extraDetails };
  const isPublishedUrlField = (definition, value) => Boolean(definition.linkLabels && isSafeHttpUrl(value));
  const updatePublishedDetails = () => {
    if (!publishedList) return;
    publishedList.innerHTML = '';
    const missingRows = [];
    for (const groupKey of ['basic', 'extra']) {
      const groupDefinitions = publishedFieldDefinitions.filter((definition) => definition.group === groupKey);
      const section = document.createElement('section'); section.className = 'published-detail-group';
      const heading = document.createElement('h3'); heading.textContent = publishedGroupLabels[groupKey];
      const list = document.createElement('dl'); list.className = 'published-details-grid';
      section.append(heading, list); publishedList.append(section);
      for (const definition of groupDefinitions) {
        const value = clean(valueForPublishedField(definition.key));
        if (!value) missingRows.push(definition);
        const item = document.createElement('div'); item.className = 'published-detail-item';
        const dt = document.createElement('dt'); dt.textContent = definition.labels[isEnglish ? 'en' : 'sl'];
        const dd = document.createElement('dd');
        if (isPublishedUrlField(definition, value)) { const link = document.createElement('a'); link.href = value; link.title = value; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = definition.linkLabels[isEnglish ? 'en' : 'sl']; dd.append(link); }
        else { dd.textContent = value || copy.missing; }
        if (!value) dd.classList.add('missing-value');
        const action = document.createElement('button'); action.type = 'button'; action.className = 'field-action'; action.dataset.fieldChange = definition.category; if (definition.group === 'basic') action.dataset.basicTarget = definition.key === 'eventTitle' ? 'title' : definition.key; action.textContent = value ? copy.correct : copy.add;
        item.append(dt, dd, action); list.append(item);
      }
    }
    missingDirectCategories = [...new Set(missingRows.map((row) => row.category).filter((category) => !['basic-official-source', 'Drugo', 'Popravek napačnega dodatnega podatka'].includes(category)))];
    commonContextChanges = [...new Set([...basicChangeCategoryValues, ...missingRows.filter((row) => ['startTime', 'distances', 'surface', 'noticeUrl', 'registrationUrl', 'cup'].includes(row.key)).map((row) => row.category)])];
    if (missingDetailsButton) missingDetailsButton.hidden = !hasRaceContext || missingDirectCategories.length === 0;
  };
  const applyRuntimeContext = () => {
    document.querySelectorAll('[data-current-basic]').forEach((el) => { el.textContent = clean(basicCurrentValues()[el.dataset.currentBasic]) || copy.missing; });
    setFieldValue(contract.fields.date, prefill.date); setFieldValue(contract.fields.title, prefill.eventTitle); setFieldValue(contract.fields.place, prefill.place); setFieldValue(contract.fields.region, prefill.region); setFieldValue(contract.fields.officialSource, prefill.officialSourceUrl); setFieldValue(contract.fields.description, hasRaceContext ? '' : prefill.description); basicCorrectionFields().forEach((field) => { field.value = ''; });
    if (formTitle) formTitle.textContent = hasRaceContext ? copy.contextTitle : copy.chooseType;
    if (proposalFieldset) proposalFieldset.hidden = hasRaceContext;
    if (contextExistingRadio) contextExistingRadio.checked = hasRaceContext;
    if (contextSection) contextSection.hidden = !hasRaceContext;
    if (publishedSection) publishedSection.hidden = !hasRaceContext;
    if (resetButton) resetButton.textContent = hasRaceContext ? (isEnglish ? 'Clear entered changes' : 'Počisti vnesene spremembe') : copy.clear;
    const title = document.querySelector('[data-prefill-title]'); const meta = document.querySelector('[data-prefill-meta]'); const back = document.querySelector('[data-prefill-return]');
    if (title) title.textContent = prefill.eventTitle;
    if (meta) meta.textContent = [prefill.date || prefill.year, prefill.place].filter(Boolean).join(' · ');
    if (back) { back.hidden = !prefill.safeReturnUrl; if (prefill.safeReturnUrl) back.href = prefill.safeReturnUrl; }
    updatePublishedDetails();
    const mode = parseProposalMode(params.get('mode'));
    if (!hasRaceContext && mode) { const modeRadio = form?.querySelector(`input[name="proposal-type-ui"][value="${mode}"]`); if (modeRadio) modeRadio.checked = true; }
    for (const value of parsePreselectedChangeCategories(params.get('changes'))) selectChangeCategory(value);
    syncVisibleChangeOptions(); applyTypeUx(); validateSource(); updateFallbackLink();
    form?.setAttribute('data-proposal-runtime-ready', 'true');
  };

  showAllChangesButton?.addEventListener('click', () => { showAllChangeOptions = true; syncVisibleChangeOptions(); updateFallbackLink(); });
  const focusBasicCorrectionField = (key) => { const field = form?.querySelector(`[data-basic-correction-field="${key}"]`); field?.scrollIntoView({ behavior: 'smooth', block: 'center' }); field?.focus({ preventScroll: true }); };
  const focusStructuredField = (category) => { const map = { 'Prijavnina / startnina': 'entryFee', 'Rok prijave': 'registrationDeadline', 'Cenejša prijava / sprememba cene': 'cheaperRegistration', 'Prijave na dan dogodka': 'raceDayRegistration', 'Višinski metri': 'elevationGain', 'Trasa / zemljevid / GPX': 'routeUrl' }; const field = form?.querySelector(`[data-structured-field="${map[category] || 'entryFee'}"]`); field?.scrollIntoView({ behavior: 'smooth', block: 'center' }); field?.focus({ preventScroll: true }); };
  missingDetailsButton?.addEventListener('click', () => { if (additionalSection) additionalSection.hidden = false; clearChangeError(); updateChangeSummary(); focusStructuredField(missingDirectCategories[0]); });
  publishedList?.addEventListener('click', (event) => { const button = event.target?.closest?.('[data-field-change]'); if (!button) return; if (button.dataset.basicTarget) { focusBasicCorrectionField(button.dataset.basicTarget); } else if (allowedAdditionalValues.includes(button.dataset.fieldChange) && button.dataset.fieldChange !== 'Drugo') { if (additionalSection) additionalSection.hidden = false; focusStructuredField(button.dataset.fieldChange); } else { selectChangeCategory(button.dataset.fieldChange); description?.scrollIntoView({ behavior: 'smooth', block: 'center' }); description?.focus({ preventScroll: true }); } clearChangeError(); updateChangeSummary(); syncVisibleChangeOptions(); });
  form?.querySelectorAll('input[name="proposal-type-ui"]').forEach((radio) => radio.addEventListener('change', () => { racePickerMode = 'search'; if (raceSearch) raceSearch.value = ''; closeRaceResults(); applyTypeUx(); }));
  raceSearch?.addEventListener('input', updateRaceSearch);
  raceSearch?.addEventListener('keydown', (event) => {
    if (!racePickerMatches.length && !['Escape'].includes(event.key)) return;
    if (event.key === 'ArrowDown') { event.preventDefault(); racePickerActiveIndex = Math.min(racePickerActiveIndex + 1, racePickerMatches.length - 1); renderRaceResults(); }
    else if (event.key === 'ArrowUp') { event.preventDefault(); racePickerActiveIndex = Math.max(racePickerActiveIndex - 1, 0); renderRaceResults(); }
    else if (event.key === 'Enter' && racePickerActiveIndex >= 0) { event.preventDefault(); selectRace(racePickerMatches[racePickerActiveIndex]); }
    else if (event.key === 'Escape') { closeRaceResults(); }
  });
  raceResults?.addEventListener('click', (event) => { const option = event.target?.closest?.('[data-race-result-index]'); if (!option) return; selectRace(racePickerMatches[Number(option.dataset.raceResultIndex)]); });
  document.addEventListener('click', (event) => { if (racePicker && !racePicker.contains(event.target)) closeRaceResults(); });
  raceManual?.addEventListener('click', () => { racePickerMode = 'manual'; closeRaceResults(); applyTypeUx(); form?.querySelector('[data-field-row="date"] input')?.focus(); });
  raceBack?.addEventListener('click', () => { racePickerMode = 'search'; applyTypeUx(); raceSearch?.focus(); });
  source?.addEventListener('blur', () => { validateSource(); updateFallbackLink(); });
  source?.addEventListener('input', () => { source.setCustomValidity(''); source.removeAttribute('aria-invalid'); if (sourceError) sourceError.hidden = true; if (sourceWarning) sourceWarning.hidden = true; updateErrorSummary(); updateFallbackLink(); });
  form?.addEventListener('input', (event) => { const field = event.target; if (field?.matches?.('input,select,textarea')) { field.setCustomValidity?.(''); field.removeAttribute('aria-invalid'); if (field.dataset?.basicCorrectionField) { const err = document.querySelector(`[data-basic-error="${field.dataset.basicCorrectionField}"]`); if (err) err.hidden = true; } if (field.dataset?.structuredField === 'routeUrl') { const routeError = document.querySelector('[data-route-error]'); if (routeError) routeError.hidden = true; } if (field.dataset?.structuredField === 'elevationGain') { const elevationError = document.querySelector('[data-elevation-error]'); if (elevationError) elevationError.hidden = true; } updateErrorSummary(); updateFallbackLink(); syncDescriptionRequirement(); } });
  form?.addEventListener('change', (event) => { const field = event.target; if (field?.matches?.('input,select,textarea')) { field.setCustomValidity?.(''); field.removeAttribute('aria-invalid'); } if (field?.name === 'proposal-change-category') { if (selectedChangeValues().length) clearChangeError(); syncVisibleChangeOptions(); updateChangeSummary(); updateErrorSummary(); } else { updateErrorSummary(); updateFallbackLink(); syncDescriptionRequirement(); } });
  const setStatus = (message, kind = '') => { if (!errors) return; errors.hidden = !message; errors.textContent = message; errors.classList.toggle('success', kind === 'success'); if (message) errors.focus(); };
  const restoreAfterSubmitFailure = () => { submissionState = 'failed'; armedSubmissionAttempt = 0; window.clearTimeout(submitTimeoutId); if (button) { button.disabled = false; button.textContent = copy.submit; } setStatus(copy.submitError); updateFallbackLink(); };
  const markSubmitted = (attempt) => { if (submissionState !== 'submitting' || attempt !== armedSubmissionAttempt) return; submissionState = 'submitted-unverified'; armedSubmissionAttempt = 0; window.clearTimeout(submitTimeoutId); if (button) { button.disabled = true; button.hidden = true; button.textContent = copy.submit; } if (resetButton) { resetButton.hidden = false; resetButton.textContent = copy.newProposal; } setStatus(copy.submitted, 'success'); };
  submitTarget?.addEventListener('load', () => { if (submissionState !== 'submitting' || !armedSubmissionAttempt) return; markSubmitted(armedSubmissionAttempt); });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (submissionState === 'submitting' || submissionState === 'submitted-unverified') return;
    submissionState = 'validating';
    validateSource(); form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    if (currentType() === 'existing') { const checked = selectedChangeValues().length || hasStructured() || hasBasicCorrections(); const first = form.querySelector('[data-basic-correction-field]') || form.querySelector('input[name="proposal-change-category"]') || form.querySelector('[data-structured-field]'); first?.setCustomValidity(checked ? '' : copy.changeError); if (!checked) { if (additionalError) additionalError.hidden = false; first?.setAttribute('aria-invalid', 'true'); } else { clearChangeError(); } }
    setBackendType();
    const explicitInvalidFields = [...validateExplicitRequiredFields(), ...validateStructuredFields()];
    const hasValidDateParts = syncDateParts();
    if (!hasValidDateParts) { const dateField = form?.elements.namedItem(contract.fields.date); if (dateField && isVisibleField(dateField) && !explicitInvalidFields.includes(dateField)) explicitInvalidFields.unshift(dateField); }
    if (!form.checkValidity() || explicitInvalidFields.length) { submissionState = 'failed'; const invalidFields = [...new Set([...explicitInvalidFields, ...visibleInvalidFields()])]; showErrors(invalidFields); form.reportValidity(); invalidFields[0]?.focus(); return; }
    if (errors) { errors.hidden = true; errors.textContent = ''; errors.classList.remove('success'); }
    updateFallbackLink();
    currentSubmissionAttempt += 1;
    armedSubmissionAttempt = currentSubmissionAttempt;
    if (button) { button.disabled = true; button.textContent = copy.openingGoogleForm; }
    submissionState = 'submitting';
    window.clearTimeout(submitTimeoutId);
    submitTimeoutId = window.setTimeout(() => restoreAfterSubmitFailure(), 12000);
    submitCanonicalEntries(currentGoogleFormsEntries());
  });
  form?.addEventListener('reset', (event) => { if (hasRaceContext && submissionState !== 'submitted-unverified' && !window.confirm(copy.resetConfirm)) { event.preventDefault(); return; } window.clearTimeout(submitTimeoutId); armedSubmissionAttempt = 0; setTimeout(() => { submissionState = 'idle'; if (errors) { errors.hidden = true; errors.classList.remove('success'); } if (resetButton) { resetButton.hidden = false; resetButton.textContent = hasRaceContext ? (isEnglish ? 'Clear entered changes' : 'Počisti vnesene spremembe') : copy.clear; } if (button) { button.disabled = false; button.textContent = copy.submit; button.hidden = false; } form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid')); applyRuntimeContext(); syncDateParts(); updateFallbackLink(); }, 0); });
  applyRuntimeContext();
</script>
