---
import { googleProposalFormContract } from '../proposal-form/proposal-form-contract';
import { buildGoogleFormsFallbackUrl, readProposalPrefill, basicChangeCategoryValues } from '../proposal-form/proposal-form-controller';
import { buildMasterApiPath, SUPPORTED_PUBLIC_YEARS } from '../utils-public-year';
import { proposalFormLocales, proposalTypeOptions } from '../proposal-form/proposal-form-locales';
import type { ProposalLanguage } from '../proposal-form/proposal-form-types';

const { lang = 'sl' } = Astro.props as { lang?: ProposalLanguage };
const emailPattern = String.raw`[^@\s]+@[^@\s]+\.[^@\s]+`;
const copy = proposalFormLocales[lang];
const emptyPrefill = readProposalPrefill(new URLSearchParams(), lang);
const fallbackUrl = buildGoogleFormsFallbackUrl(emptyPrefill);
const typeOptions = proposalTypeOptions(lang);
const changeLabelFor = (value: string) => copy.labelsForValues.changeCategories[value as keyof typeof copy.labelsForValues.changeCategories];
const changeGroups = [
  { title: lang === 'en' ? 'Basic details' : 'Osnovni podatki', basic: true, options: [...basicChangeCategoryValues].map((value) => ({ value, label: changeLabelFor(value) })) },
  { title: lang === 'en' ? 'Other' : 'Drugo', basic: false, options: ['Drugo'].map((value) => ({ value, label: changeLabelFor(value) })) }
];
const pickerCopy = lang === 'en' ? { heading: 'Select a race', label: 'Search by race name or place', placeholder: 'Start typing a race name or place …', loading: 'Loading races …', error: 'Race search could not be loaded. You can still enter details manually.', empty: 'No matching races found.', fallback: 'I cannot find the race – enter details manually', back: 'Back to race search' } : { heading: 'Izberite tek', label: 'Poiščite tek po nazivu ali kraju', placeholder: 'Začnite vnašati naziv ali kraj …', loading: 'Teke nalagamo …', error: 'Iskanja tekov ni bilo mogoče naložiti. Podatke lahko še vedno vnesete ročno.', empty: 'Ni ujemajočih se tekov.', fallback: 'Teka ne najdem – vnesem podatke ročno', back: 'Nazaj na iskanje teka' };
const raceApiPaths = SUPPORTED_PUBLIC_YEARS.map((year) => ({ year, path: buildMasterApiPath(year) }));
const hasInitialRaceContext = Boolean(emptyPrefill.eventKey || (emptyPrefill.eventTitle && emptyPrefill.date && emptyPrefill.place));
---
<section class="page-hero container proposal-hero" aria-labelledby="page-title">
  <span class="eyebrow">{copy.eyebrow}</span>
  <h1 id="page-title">{copy.title}</h1>
  <p>{copy.intro}</p>
  <p class="proposal-note">{copy.notAuto}</p>
</section>

<section class="section container correction-context" aria-labelledby="selected-race-title" data-correction-context hidden>
  <article class="info-card correction-context-card" data-context-card>
    <span class="eyebrow">{copy.contextTitle}</span>
    <h2 id="selected-race-title" data-prefill-title></h2>
    <p data-prefill-meta></p>
    <a class="correction-context-back" href="#" data-prefill-return hidden>{copy.back}</a>
    <div class="context-mini-links">
      <a href={`${copy.cleanPath}?mode=existing`} data-testid="select-another-race" data-context-select-another>{lang === 'en' ? 'Select another race' : 'Izberite drug tek'}</a>
      <a href={`${copy.cleanPath}?mode=new`} data-context-new-link>{copy.addAnotherRace}</a>
      <a href={`${copy.cleanPath}?mode=other`} data-context-other-link>{copy.sendOther}</a>
    </div>
  </article>
</section>

<section class="section container published-details" aria-labelledby="published-details-title" data-published-details hidden>
  <article class="info-card published-details-card">
    <h2 id="published-details-title">{copy.currentDetails}</h2>
    <div class="published-details-groups" data-published-details-list></div>
    <button type="button" class="button button-secondary-light missing-details-action" data-missing-details-action hidden>{copy.addMissingDetails}</button>
  </article>
</section>

<section class="section container" aria-labelledby="form-title">
  <div class="proposal-panel">
    <div class="section-heading compact-heading">
      <h2 id="form-title" data-form-title>{copy.chooseType}</h2>
      <p>{copy.noSource}</p>
    </div>
    <div class="form-status" data-error-summary hidden tabindex="-1" role="alert"></div>
    <p class="proposal-hand-off">{copy.googleFormHandOff}</p>
    <form class="proposal-form" method="post" action={googleProposalFormContract.responseUrl} target="proposal-form-target" data-proposal-form novalidate>
      <fieldset class="proposal-type-fieldset">
        <legend>{copy.labels.proposalType}<span aria-hidden="true"> *</span></legend>
        <div class="proposal-type-grid">
          {typeOptions.map((option) => (
            <label class="proposal-choice">
              <input type="radio" name="proposal-type-ui" value={option.value} required data-proposal-type-ui data-field-label={copy.labels.proposalType} />
              <span>{option.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <input type="radio" name="proposal-type-ui" value="existing" hidden data-context-existing-radio data-proposal-type-ui data-field-label={copy.labels.proposalType} />
      <input type="hidden" name={googleProposalFormContract.fields.proposalType} value="" data-backend-proposal-type />

      <section class="race-picker" data-race-picker data-testid="race-picker" hidden aria-labelledby="race-picker-title">
        <h3 id="race-picker-title">{pickerCopy.heading}</h3>
        <label for="proposal-race-search">{pickerCopy.label}</label>
        <div class="race-picker-combobox" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-owns="proposal-race-results" data-race-combobox>
          <input id="proposal-race-search" data-testid="race-picker-search" type="search" autocomplete="off" placeholder={pickerCopy.placeholder} aria-autocomplete="list" aria-controls="proposal-race-results" aria-describedby="proposal-race-picker-status" data-race-search />
        </div>
        <div id="proposal-race-results" class="race-picker-results" role="listbox" data-testid="race-picker-results" data-race-results hidden></div>
        <p id="proposal-race-picker-status" class="field-helper" role="status" aria-live="polite" data-race-picker-status>{pickerCopy.loading}</p>
        <button type="button" class="button button-secondary-light race-picker-fallback" data-testid="race-picker-manual" data-race-manual>{pickerCopy.fallback}</button>
      </section>
      <button type="button" class="button button-secondary-light race-search-back" data-testid="race-picker-back" data-race-search-back hidden>{pickerCopy.back}</button>
      <input type="hidden" name={googleProposalFormContract.fields.dateYear} value="" data-date-part="year" disabled />
      <input type="hidden" name={googleProposalFormContract.fields.dateMonth} value="" data-date-part="month" disabled />
      <input type="hidden" name={googleProposalFormContract.fields.dateDay} value="" data-date-part="day" disabled />
      <div class="form-grid">
        <div data-field-row="date"><label for="proposal-date" data-label-text>{copy.labels.date}</label><span data-required-mark aria-hidden="true"> *</span><input id="proposal-date" name={googleProposalFormContract.fields.date} type="date" required value="" data-field-label={copy.labels.date} data-date-input /></div>
        <div data-field-row="title"><label for="proposal-title" data-label-text>{copy.labels.title}</label><span data-required-mark aria-hidden="true"> *</span><input id="proposal-title" name={googleProposalFormContract.fields.title} required value="" autocomplete="off" data-field-label={copy.labels.title} /></div>
        <div data-field-row="place"><label for="proposal-place" data-label-text>{copy.labels.place}</label><span data-required-mark aria-hidden="true"> *</span><input id="proposal-place" name={googleProposalFormContract.fields.place} required value="" autocomplete="address-level2" data-field-label={copy.labels.place} /></div>
        <div data-field-row="region"><label for="proposal-region" data-label-text>{copy.labels.region}</label><span data-required-mark aria-hidden="true"> *</span><select id="proposal-region" name={googleProposalFormContract.fields.region} required data-field-label={copy.labels.region}><option value=""></option>{googleProposalFormContract.values.regions.map((r) => <option value={r}>{copy.labelsForValues.regions[r]}</option>)}</select></div>
        <div class="full-span" data-field-row="source">
          <label for="proposal-source" data-label-text>{copy.labels.officialSource}</label>
          <input id="proposal-source" name={googleProposalFormContract.fields.officialSource} type="url" inputmode="url" placeholder={copy.placeholders.officialSource} value="" data-source-url data-field-label={copy.labels.officialSource} aria-describedby="proposal-source-helper proposal-source-error proposal-source-warning" />
          <small id="proposal-source-helper" class="field-helper">{copy.helpers.officialSource}</small>
          <small id="proposal-source-error" class="field-error" data-source-error hidden>{copy.sourceError}</small>
          <small id="proposal-source-warning" class="field-warning" data-source-warning hidden>{copy.sourceWarning}</small>
        </div>
        <fieldset class="full-span optional-fieldset" data-additional-section hidden aria-describedby="proposal-additional-helper proposal-additional-error">
          <legend>{copy.labels.additionalData}</legend>
          <p id="proposal-additional-helper" class="field-helper">{copy.helpers.additionalData}</p>
          <details class="change-options-details" data-change-options-details open>
            <summary>{copy.otherCorrectionOptions}</summary>
            <button type="button" class="button button-secondary-light show-all-changes" data-show-all-changes hidden>{copy.showAllChanges}</button>
            {changeGroups.map((group) => (
              <div class="change-category-group" data-basic-change-group={group.basic ? 'true' : undefined}>
                <p class="change-category-title">{group.title}</p>
                <div class="checkbox-grid">{group.options.map((option) => <label><input type="checkbox" name="proposal-change-category" value={option.value} data-change-category /> <span>{option.label}</span></label>)}</div>
              </div>
            ))}
          </details>

          <section class="structured-basic" data-structured-basic data-testid="structured-basic-section" aria-labelledby="structured-basic-title" hidden>
            <h3 id="structured-basic-title">{lang === 'en' ? 'Basic corrections' : 'Osnovni popravki'}</h3>
            <p class="field-helper">{lang === 'en' ? 'Enter only the new or correct values. Empty fields mean that the detail is not being changed.' : 'Vnesite samo nove ali pravilne vrednosti. Prazna polja pomenijo, da podatka ne spreminjate.'}</p>
            <div class="structured-grid">
              <div class="structured-field" data-basic-card="date"><label for="proposal-basic-date">{lang === 'en' ? 'Date' : 'Datum'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="date"></span></small><input id="proposal-basic-date" data-testid="basic-correction-date" data-basic-correction-field="date" type="date" data-field-label={lang === 'en' ? 'Date' : 'Datum'} aria-describedby="proposal-basic-date-error" /><small id="proposal-basic-date-error" class="field-error" data-basic-error="date" hidden>{copy.dateError}</small></div>
              <div class="structured-field" data-basic-card="title"><label for="proposal-basic-title">{lang === 'en' ? 'Race title' : 'Naziv'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="title"></span></small><input id="proposal-basic-title" data-testid="basic-correction-title" data-basic-correction-field="title" type="text" data-field-label={lang === 'en' ? 'Race title' : 'Naziv'} /></div>
              <div class="structured-field" data-basic-card="place"><label for="proposal-basic-place">{lang === 'en' ? 'Place' : 'Kraj'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="place"></span></small><input id="proposal-basic-place" data-testid="basic-correction-place" data-basic-correction-field="place" type="text" data-field-label={lang === 'en' ? 'Place' : 'Kraj'} /></div>
              <div class="structured-field" data-basic-card="region"><label for="proposal-basic-region">{lang === 'en' ? 'Region' : 'Regija'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="region"></span></small><select id="proposal-basic-region" data-testid="basic-correction-region" data-basic-correction-field="region" data-field-label={lang === 'en' ? 'Region' : 'Regija'}><option value=""></option>{googleProposalFormContract.values.regions.map((r) => <option value={r}>{copy.labelsForValues.regions[r]}</option>)}</select></div>
              <div class="structured-field" data-basic-card="startTime"><label for="proposal-basic-start-time">{lang === 'en' ? 'Start time' : 'Čas začetka'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="startTime"></span></small><input id="proposal-basic-start-time" data-testid="basic-correction-start-time" data-basic-correction-field="startTime" type="text" placeholder="18:00" data-field-label={lang === 'en' ? 'Start time' : 'Čas začetka'} /></div>
              <div class="structured-field" data-basic-card="distances"><label for="proposal-basic-distances">{lang === 'en' ? 'Distances' : 'Razdalje'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="distances"></span></small><input id="proposal-basic-distances" data-testid="basic-correction-distances" data-basic-correction-field="distances" type="text" data-field-label={lang === 'en' ? 'Distances' : 'Razdalje'} /></div>
              <div class="structured-field" data-basic-card="surface"><label for="proposal-basic-surface">{lang === 'en' ? 'Surface' : 'Vrsta podlage'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="surface"></span></small><input id="proposal-basic-surface" data-testid="basic-correction-surface" data-basic-correction-field="surface" type="text" data-field-label={lang === 'en' ? 'Surface' : 'Vrsta podlage'} /></div>
              <div class="structured-field" data-basic-card="noticeUrl"><label for="proposal-basic-notice-url">{lang === 'en' ? 'Official announcement URL' : 'Uradni razpis'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="noticeUrl"></span></small><input id="proposal-basic-notice-url" data-testid="basic-correction-notice-url" data-basic-correction-field="noticeUrl" type="url" inputmode="url" data-field-label={lang === 'en' ? 'Official announcement URL' : 'Uradni razpis'} aria-describedby="proposal-basic-notice-url-error" /><small id="proposal-basic-notice-url-error" class="field-error" data-basic-error="noticeUrl" hidden>{copy.sourceError}</small></div>
              <div class="structured-field" data-basic-card="registrationUrl"><label for="proposal-basic-registration-url">{lang === 'en' ? 'Registration URL' : 'Prijavna povezava'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="registrationUrl"></span></small><input id="proposal-basic-registration-url" data-testid="basic-correction-registration-url" data-basic-correction-field="registrationUrl" type="url" inputmode="url" data-field-label={lang === 'en' ? 'Registration URL' : 'Prijavna povezava'} aria-describedby="proposal-basic-registration-url-error" /><small id="proposal-basic-registration-url-error" class="field-error" data-basic-error="registrationUrl" hidden>{copy.sourceError}</small></div>
              <div class="structured-field" data-basic-card="cup"><label for="proposal-basic-cup">{lang === 'en' ? 'Cup or series' : 'Pokal ali serija'}</label><small>{lang === 'en' ? 'Current:' : 'Trenutno:'} <span data-current-basic="cup"></span></small><input id="proposal-basic-cup" data-testid="basic-correction-cup" data-basic-correction-field="cup" type="text" data-field-label={lang === 'en' ? 'Cup or series' : 'Pokal ali serija'} /></div>
            </div>
          </section>
          <section class="structured-additional" data-structured-additional data-testid="structured-additional-section" aria-labelledby="structured-additional-title">
            <h3 id="structured-additional-title">{lang === 'en' ? 'Additional race details' : 'Dodatni podatki o teku'}</h3>
            <div class="structured-field full-span" data-structured-card><label for="proposal-correction-intent">{lang === 'en' ? 'Correction intent' : 'Vrsta dopolnitve'}</label><select id="proposal-correction-intent" data-testid="additional-correction-intent" data-structured-field="correctionIntent" data-field-label={lang === 'en' ? 'Correction intent' : 'Vrsta dopolnitve'} aria-describedby="proposal-correction-intent-error"><option value=""></option><option value="missing">{lang === 'en' ? 'Adding missing details' : 'Dodajam manjkajoče podatke'}</option><option value="correcting">{lang === 'en' ? 'Correcting published details' : 'Popravljam že objavljene podatke'}</option></select><small id="proposal-correction-intent-error" class="field-error" data-correction-intent-error hidden>{lang === 'en' ? 'Choose whether you are adding missing details or correcting published details.' : 'Izberite, ali dodajate manjkajoče podatke ali popravljate objavljene podatke.'}</small></div>
            <div class="structured-grid">
              <div class="structured-field" data-structured-card><label for="proposal-entry-fee">{lang === 'en' ? 'Entry fee' : 'Prijavnina / startnina'}</label><input id="proposal-entry-fee" data-testid="additional-entry-fee" data-structured-field="entryFee" type="text" placeholder={lang === 'en' ? 'e.g. €20 until 1 August, then €25' : 'npr. 20 € do 1. avgusta, nato 25 €'} /></div>
              <div class="structured-field" data-structured-card><label for="proposal-registration-deadline">{lang === 'en' ? 'Registration deadline' : 'Rok prijave'}</label><input id="proposal-registration-deadline" data-testid="additional-registration-deadline" data-structured-field="registrationDeadline" type="text" placeholder={lang === 'en' ? 'e.g. 2026-08-10 or until sold out' : 'npr. 2026-08-10 ali do zapolnitve mest'} /></div>
              <div class="structured-field" data-structured-card><label for="proposal-cheaper-registration">{lang === 'en' ? 'Cheaper registration deadline or price change' : 'Rok cenejše prijave ali sprememba cene'}</label><input id="proposal-cheaper-registration" data-testid="additional-cheaper-registration" data-structured-field="cheaperRegistration" type="text" placeholder={lang === 'en' ? 'e.g. lower price until 2026-07-31' : 'npr. nižja cena do 2026-07-31'} /></div>
              <div class="structured-field" data-structured-card><label for="proposal-race-day-registration">{lang === 'en' ? 'Race-day registration' : 'Prijave na dan dogodka'}</label><select id="proposal-race-day-registration" data-testid="additional-race-day-registration" data-structured-field="raceDayRegistration"><option value=""></option><option value="Da">{lang === 'en' ? 'Yes' : 'Da'}</option><option value="Ne">{lang === 'en' ? 'No' : 'Ne'}</option><option value="Ne vem">{lang === 'en' ? 'I do not know' : 'Ne vem'}</option></select></div>
              <div class="structured-field" data-structured-card><label for="proposal-elevation-gain">{lang === 'en' ? 'Elevation gain' : 'Višinski metri'}</label><div class="suffix-input"><input id="proposal-elevation-gain" data-testid="additional-elevation" data-structured-field="elevationGain" type="number" min="0" step="1" aria-describedby="proposal-elevation-error" /><span>m+</span></div><small id="proposal-elevation-error" class="field-error" data-elevation-error hidden>{lang === 'en' ? 'Enter a non-negative whole number.' : 'Vnesite celo število 0 ali več.'}</small></div>
              <div class="structured-field" data-structured-card><label for="proposal-route-url">{lang === 'en' ? 'Route, map or GPX' : 'Trasa, zemljevid ali GPX'}</label><input id="proposal-route-url" data-testid="additional-route-url" data-structured-field="routeUrl" type="url" inputmode="url" aria-describedby="proposal-route-error" /><small id="proposal-route-error" class="field-error" data-route-error hidden>{copy.sourceError}</small></div>
              <div class="structured-field full-span" data-structured-card><label for="proposal-other-details">{lang === 'en' ? 'Other additional details' : 'Drugi dodatni podatki'}</label><textarea id="proposal-other-details" data-testid="additional-other" data-structured-field="otherDetails" rows="3"></textarea></div>
            </div>
          </section>
          <p id="proposal-additional-error" class="field-error" data-additional-error hidden>{copy.changeError}</p>
        </fieldset>
        <div class="change-summary full-span" data-change-summary aria-live="polite" hidden><strong>{copy.selectedChanges}</strong><div class="change-chips" data-change-chips></div></div>
        <div class="full-span" data-field-row="description">
          <label for="proposal-description" data-label-text>{copy.labels.description}</label><span data-required-mark aria-hidden="true"> *</span>
          <textarea id="proposal-description" name={googleProposalFormContract.fields.description} required rows="7" placeholder={copy.placeholders.description} data-testid="optional-explanation" data-field-label={copy.labels.description} aria-describedby="proposal-description-helper"></textarea>
          <small id="proposal-description-helper" class="field-helper" data-description-helper>{copy.helpers.newDescription}</small>
        </div>
        <div class="full-span about-proposal" data-about-proposal><h3>{copy.aboutProposal}</h3><p>{copy.aboutProposalHelper}</p></div><div data-field-row="organizer"><label for="proposal-organizer" data-label-text>{copy.labels.organizer}</label><span data-required-mark aria-hidden="true"> *</span><select id="proposal-organizer" name={googleProposalFormContract.fields.organizer} required data-field-label={copy.labels.organizer}><option value=""></option>{googleProposalFormContract.values.yesNo.map((v) => <option value={v}>{copy.labelsForValues.yesNo[v]}</option>)}</select></div>
        <div data-field-row="announcement"><label for="proposal-announcement" data-label-text>{copy.labels.officialAnnouncement2026}</label><span data-required-mark aria-hidden="true"> *</span><select id="proposal-announcement" name={googleProposalFormContract.fields.officialAnnouncement2026} required data-field-label={copy.labels.officialAnnouncement2026}><option value=""></option>{googleProposalFormContract.values.announcement.map((v) => <option value={v}>{copy.labelsForValues.announcement[v]}</option>)}</select></div>
        <div class="full-span" data-field-row="email">
          <label for="proposal-email" data-label-text>{copy.labels.email}</label><span data-required-mark aria-hidden="true"> *</span>
          <input id="proposal-email" name={googleProposalFormContract.fields.email} type="email" pattern={emailPattern} required autocomplete="email" data-field-label={copy.labels.email} aria-describedby="proposal-email-helper" />
          <small id="proposal-email-helper" class="field-helper">{copy.helpers.email} <a href={lang === 'en' ? '/en/about/' : '/o-projektu-in-zasebnost/'}>{copy.helpers.privacy}</a></small>
        </div>
      </div>
      <div class="cta-row proposal-actions">
        <button class="button button-primary" type="submit" data-submit-button>{copy.submit}</button>
        <button class="button button-secondary-light" type="reset" data-reset-button>{hasInitialRaceContext ? (lang === 'en' ? 'Clear entered changes' : 'Počisti vnesene spremembe') : copy.clear}</button>
      </div>
      <p class="proposal-fallback"><a href={fallbackUrl} target="_blank" rel="noopener noreferrer" data-correction-form-link data-analytics-link-type="correction_form" data-analytics-redact-target-url="true">{copy.fallback}</a></p>
    </form>
    <iframe name="proposal-form-target" title="" data-submit-target hidden aria-hidden="true"></iframe>
    <form method="post" action={googleProposalFormContract.responseUrl} target="proposal-form-target" data-backend-submit-form hidden aria-hidden="true"></form>
  </div>
</section>
<script type="application/json" data-race-api-paths set:html={JSON.stringify(raceApiPaths)}></script>
<script>
  // @ts-nocheck
  import { googleProposalFormContract as contract } from '../proposal-form/proposal-form-contract';
  import { proposalFormLocales } from '../proposal-form/proposal-form-locales';
  import { readProposalPrefill, buildGoogleFormsSubmissionEntries, buildGoogleFormsSubmissionUrl, parsePreselectedChangeCategories, getProposalFieldRules, parseProposalMode, fieldCategoryMap, basicChangeCategoryValues, additionalDataValuesForStructuredDetails, hasStructuredAdditionalDetails, hasStructuredBasicCorrections, combineCorrectionDescription, isValidStructuredRouteUrl, isValidElevationGain, isValidStructuredBasicDate, isValidStructuredBasicUrl } from '../proposal-form/proposal-form-controller';
  import { attachAdditionalDataByMasterRow, fetchAdditionalEventData } from '../utils-additional';
  import { mapPublicRaceEvent, toApiRecords } from '../utils-event-detail';
  import { buildRaceCorrectionContextUrl, searchPublicRaces } from '../proposal-form/race-correction-context';

  const form = document.querySelector('[data-proposal-form]');
  const isEnglish = document.documentElement.lang?.startsWith('en') || window.location.pathname.startsWith('/en/');
  const copy = proposalFormLocales[isEnglish ? 'en' : 'sl'];
  const raceApiPaths = JSON.parse(document.querySelector('[data-race-api-paths]')?.textContent || '[]');
  const params = new URLSearchParams(window.location.search);
  const prefill = readProposalPrefill(params, isEnglish ? 'en' : 'sl');
  const hasRaceContext = Boolean(prefill.eventKey || (prefill.eventTitle && prefill.date && prefill.place));
  const contextSection = document.querySelector('[data-correction-context]');
  const publishedSection = document.querySelector('[data-published-details]');
  const publishedList = document.querySelector('[data-published-details-list]');
