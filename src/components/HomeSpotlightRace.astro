---
import { buildEnglishEventDetailPath, buildEventDetailPath, getStableEventId } from '../utils-event-detail';
import type { PublicRaceEvent } from '../utils-event-detail';
import { formatEnglishSurface } from '../utils-english';
interface Props { lang: 'sl' | 'en'; initialRace: PublicRaceEvent | null; }
const { lang, initialRace } = Astro.props;
const en = lang === 'en';
const detailHref = initialRace
  ? (en ? buildEnglishEventDetailPath(initialRace) : buildEventDetailPath(initialRace))
  : (en ? '/en/find-races/' : '/iskalnik-tekov/');
const dateLabel = initialRace
  ? new Intl.DateTimeFormat(en ? 'en-GB' : 'sl-SI', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Ljubljana' })
    .format(new Date(initialRace.date + 'T12:00:00Z'))
  : '';
---
<aside
  class="home-spotlight-card"
  data-home-spotlight
  data-language={lang}
  data-selection-mode="pending"
  data-analytics-featured-impression="false"
  data-analytics-placement="home_featured"
  data-analytics-event-id={initialRace ? getStableEventId(initialRace) : undefined}
  data-analytics-event-name={initialRace?.displayTitle}
  data-analytics-event-date={initialRace?.date}
  data-analytics-event-year={initialRace?.year}
  aria-label={en ? 'STK race spotlight' : 'Tek v ospredju STK'}
  hidden
>
  <span class="home-spotlight-kicker" data-spotlight-label>{en ? 'STK EDITORIAL PICK' : 'UREDNIŠKI IZBOR STK'}</span>
  <h2>{en ? 'In the spotlight' : 'V ospredju'}</h2>
  <div class="home-spotlight-meta">
    <time data-spotlight-date datetime={initialRace?.date ?? ''}>{dateLabel}</time>
    <span data-spotlight-place hidden={!initialRace?.place}>{initialRace?.place ?? ''}</span>
  </div>
  <h3><a data-spotlight-title href={detailHref}>{initialRace?.displayTitle ?? ''}</a></h3>
  <span class="home-spotlight-surface" data-spotlight-surface hidden={!initialRace?.surface}>{en ? formatEnglishSurface(initialRace?.surface ?? '') : initialRace?.surface ?? ''}</span>
  <a class="home-spotlight-cta" data-spotlight-cta href={detailHref}>
    <span>{en ? 'Explore this race' : 'Oglejte si tek'}</span><span aria-hidden="true">↗</span>
  </a>
</aside>

<script>
  import { fetchPublicMaster } from '../utils-public-master';
  import { SUPPORTED_PUBLIC_YEARS } from '../utils-public-year';
  import { getStableEventId, buildEventDetailPath, buildEnglishEventDetailPath } from '../utils-event-detail';
  import { getTodayIsoInLjubljana } from '../utils-date';
  import { fetchSpotlightControl, resolveHomepageSpotlight, spotlightLabel, spotlightRead, millisecondsToNextLjubljanaDay } from '../utils-home-spotlight';
  import type { SpotlightSelection } from '../utils-home-spotlight';
  import { initializeFeaturedRaceImpressionTracking } from '../lib/stkAnalytics';
  import { formatEnglishSurface } from '../utils-english';

  const slot = document.querySelector<HTMLElement>('[data-home-spotlight]');
  if (slot) {
    const hero = slot.closest<HTMLElement>('.home-hero-card');
    const en = slot.dataset.language === 'en';
    const close = () => {
      slot.hidden = true;
      slot.dataset.analyticsFeaturedImpression = 'false';
      slot.dataset.selectionMode = 'pending';
      hero?.classList.remove('home-hero-with-featured');
    };
    const show = ({ race, mode }: SpotlightSelection) => {
      const label = slot.querySelector<HTMLElement>('[data-spotlight-label]');
      if (label) label.textContent = spotlightLabel(mode, en);
      slot.dataset.selectionMode = mode;
      const href = en ? buildEnglishEventDetailPath(race) : buildEventDetailPath(race);
      const name = slot.querySelector<HTMLAnchorElement>('[data-spotlight-title]');
      const cta = slot.querySelector<HTMLAnchorElement>('[data-spotlight-cta]');
      const date = slot.querySelector<HTMLTimeElement>('[data-spotlight-date]');
      const place = slot.querySelector<HTMLElement>('[data-spotlight-place]');
      const surface = slot.querySelector<HTMLElement>('[data-spotlight-surface]');
      if (!name || !cta || !date || !place || !surface) return close();
      name.textContent = race.displayTitle;
      name.href = href;
      cta.href = href;
      date.dateTime = race.date;
      date.textContent = new Intl.DateTimeFormat(en ? 'en-GB' : 'sl-SI', {
        day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Ljubljana'
      }).format(new Date(race.date + 'T12:00:00Z'));
      place.textContent = race.place;
      place.hidden = !race.place;
      surface.textContent = en ? formatEnglishSurface(race.surface) : race.surface;
      surface.hidden = !race.surface;
      slot.dataset.analyticsEventId = getStableEventId(race);
      slot.dataset.analyticsEventName = race.displayTitle;
      slot.dataset.analyticsEventDate = race.date;
      slot.dataset.analyticsEventYear = race.year;
      slot.dataset.analyticsFeaturedImpression = 'true';
      slot.hidden = false;
      hero?.classList.add('home-hero-with-featured');
      initializeFeaturedRaceImpressionTracking(hero ?? document);
    };

    // Static Astro markup stays hidden until BOTH live reads settle. Never flash or
    // track the build-time automatic choice while a manual choice is being checked.
    let pending = false;
    let revision = 0;
    let dayTimer: ReturnType<typeof setTimeout>;
    const refresh = async () => {
      if (pending) return;
      pending = true;
      const current = ++revision;
      close();
      clearTimeout(dayTimer);
      // Hide/recheck at midnight even if a request is slow across the boundary.
      dayTimer = setTimeout(() => { revision++; pending = false; close(); void refresh(); }, millisecondsToNextLjubljanaDay());
      try {
        const [masters, control] = await Promise.all([
          Promise.allSettled(SUPPORTED_PUBLIC_YEARS.map(year => spotlightRead(fetchPublicMaster(year)))),
          spotlightRead(fetchSpotlightControl()).catch(() => null)
        ]);
        if (current !== revision || document.hidden) return;
        const sources = masters.flatMap((entry, index) => entry.status === 'fulfilled'
          ? [{ year: SUPPORTED_PUBLIC_YEARS[index], payload: entry.value }] : []);
        const selected = resolveHomepageSpotlight(sources, control, getTodayIsoInLjubljana());
        if (selected) show(selected);
      } catch { close(); }
      finally { if (current === revision) pending = false; }
    };
    window.addEventListener('focus', () => { void refresh(); });
    window.addEventListener('pageshow', event => { if (event.persisted) void refresh(); });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { revision++; pending = false; close(); }
      else void refresh();
    });
    window.addEventListener('pagehide', () => { revision++; pending = false; close(); clearTimeout(dayTimer); });
    void refresh();
  }
</script>
