---
import type { RelatedRaceCard, RelatedRaceLanguage } from '../utils-related-races';
import { formatRaceDistances } from '../utils-distance-format';

type Props = { races: RelatedRaceCard[]; language: RelatedRaceLanguage };
const { races, language } = Astro.props as Props;
const copy = language === 'en'
  ? { heading: 'You may also be interested in', view: 'View race', aria: 'Related races', at: 'at', save: 'Save race', reasons: 'Why it is related' }
  : { heading: 'Morda vas zanimajo tudi', view: 'Poglejte tek', aria: 'Sorodni teki', at: 'v kraju', save: 'Shrani tek', reasons: 'Zakaj je sorodno' };
const getMetaParts = (race: RelatedRaceCard) => [race.place, race.region, race.surface, race.distances ? formatRaceDistances(race.distances, language) : ''].filter(Boolean);
const headingId = `related-races-${language}`;
const formatDate = (value: string) => new Intl.DateTimeFormat(language === 'en' ? 'en-GB' : 'sl-SI', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(`${value}T00:00:00`));
---
{races.length > 0 && (
  <section class="related-races-section" aria-labelledby={headingId}>
    <h2 id={headingId}>{copy.heading}</h2>
    <ul class="related-races-grid" aria-label={copy.aria}>
      {races.map((race) => (
        <li class="related-race-item">
          <article class="related-race-card" data-stk-event-id={race.id} data-stk-event-name={race.title} data-stk-event-date={race.date} data-stk-event-year={race.year} data-analytics-placement="related_races">
            <time class="related-race-date" datetime={race.date}>{formatDate(race.date)}</time>
            <h3 class="related-race-title">
              <a
                class="related-race-card-link"
                href={race.detailPath}
                aria-label={`${copy.view}: ${race.title}${race.place ? ` ${copy.at} ${race.place}` : ''}`}
              >
                {race.title}
              </a>
            </h3>
            {getMetaParts(race).length > 0 && (
              <div class="related-race-meta" aria-label={language === 'en' ? 'Race details' : 'Podatki o teku'}>
                {getMetaParts(race).map((part) => <span>{part}</span>)}
              </div>
            )}
            {race.reasonLabels.length > 0 && (
              <div class="related-race-reasons" aria-label={copy.reasons}>
                {race.reasonLabels.map((label) => <span class="related-race-reason">{label}</span>)}
              </div>
            )}
            <div class="related-race-footer">
              <a class="related-race-view" href={race.detailPath} aria-label={`${copy.view}: ${race.title}`}>
                {copy.view} <span aria-hidden="true">→</span>
              </a>
              {race.stableEventId && (
                <button class="button button-small button-secondary-light saved-race-button" type="button" data-saved-race-button data-event-id={race.stableEventId} data-event-year={race.year} data-event-date={race.date} data-event-title={race.title} data-language={language} aria-pressed="false" aria-label={copy.save}><span class="action-icon" aria-hidden="true">☆</span><span data-saved-race-label>{copy.save}</span></button>
              )}
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>
)}
