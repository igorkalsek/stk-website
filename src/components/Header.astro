---
import { slovenianNavItems, type NavItem } from '../navigation';

interface Props {
  navItems?: NavItem[];
  brandHref?: string;
  brandLabel?: string;
  navLabel?: string;
  menuLabel?: string;
  languageSwitchHref?: string;
}

// Source contract: the Slovenian secondary menu keeps the full label: 'Osebni koledar'.
const defaultNavItems = slovenianNavItems;

const {
  navItems = defaultNavItems,
  brandHref = '/',
  brandLabel = 'Slovenski Tekaški Koledar - domov',
  navLabel = 'Glavna navigacija',
  menuLabel = 'Meni',
  languageSwitchHref
} = Astro.props;

const languagePairs = new Map<string, string>([
  ['/', '/en/'],
  ['/iskalnik-tekov/', '/en/find-races/'],
  ['/moji-teki/', '/en/my-races/'],
  ['/druzinam-prijazni-teki/', '/en/family-friendly-races/'],
  ['/skupinski-teki/', '/en/group-runs/'],
  ['/najbolj-glasovani-teki/', '/en/most-voted-races/'],
  ['/osebni-koledar/', '/en/personal-calendar/'],
  ['/stk-tekobot/', '/en/stk-tekobot/']
]);

const normalizePath = (path: string) => (path === '/' ? '/' : `${path.replace(/\/$/, '')}/`);
const currentPath = normalizePath(Astro.url.pathname);
const isEnglishPage = currentPath.startsWith('/en/');
const currentSlovenianPath = isEnglishPage
  ? [...languagePairs.entries()].find(([, englishPath]) => englishPath === currentPath)?.[0]
  : currentPath;
const currentEnglishPath = isEnglishPage ? currentPath : languagePairs.get(currentPath);
const slovenianHref = isEnglishPage && languageSwitchHref
  ? languageSwitchHref
  : currentSlovenianPath && languagePairs.has(currentSlovenianPath) ? currentSlovenianPath : '/';
const englishHref = !isEnglishPage && languageSwitchHref ? languageSwitchHref : currentEnglishPath ?? '/en/';
const isItemActive = (item: NavItem) => currentPath === normalizePath(item.href);
const isGroupActive = (item: NavItem) => item.children?.some((child) => isItemActive(child)) ?? false;
const groupActiveLabel = isEnglishPage ? 'current section' : 'trenutno izbrana skupina';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={brandHref} aria-label={brandLabel}>
      <img class="brand-logo" src="/stk-logo.jpeg" alt="Slovenski Tekaški Koledar" />
      <span class="brand-name">Slovenski Tekaški Koledar</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
      {menuLabel}
    </button>
    <nav id="site-navigation" class="site-nav" data-open="false" aria-label={navLabel}>
      {navItems.map((item) => item.children?.length ? (
        <details class:list={["nav-more", item.variant && `nav-item-${item.variant}`, isGroupActive(item) && 'is-active']}>
          <summary aria-label={isGroupActive(item) ? `${item.label} - ${groupActiveLabel}` : item.label}>
            <span>{item.label}</span>
          </summary>
          <div class="nav-more-menu">
            {item.children.map((child) => (
              <a href={child.href} aria-current={isItemActive(child) ? 'page' : undefined}>
                {child.label}
              </a>
            ))}
          </div>
        </details>
      ) : (
        <a class:list={[item.variant && `nav-item-${item.variant}`]} href={item.href} aria-current={isItemActive(item) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <div class="language-switcher" aria-label={isEnglishPage ? 'Language switcher' : 'Izbira jezika'}>
        {isEnglishPage ? (
          <a
            class="language-link"
            href={slovenianHref}
            hreflang="sl"
            data-language-switch
            aria-label="Switch to Slovenian"
          >🇸🇮 SL</a>
        ) : (
          <span
            class="language-link is-active"
            aria-label="Current language: Slovenian"
            aria-current="true"
          >🇸🇮 SL</span>
        )}
        <span class="language-separator" aria-hidden="true">|</span>
        {isEnglishPage ? (
          <span
            class="language-link is-active"
            aria-label="Current language: English"
            aria-current="true"
          >🇬🇧 EN</span>
        ) : (
          <a
            class="language-link"
            href={englishHref}
            hreflang="en"
            data-language-switch
            aria-label="Switch to English"
          >🇬🇧 EN</a>
        )}
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.site-nav');

  const closeDropdowns = () => {
    document.querySelectorAll<HTMLDetailsElement>('.nav-more[open]').forEach((details) => {
      details.open = false;
    });
  };

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.getAttribute('data-open') === 'true';
    nav?.setAttribute('data-open', String(!isOpen));
    toggle.setAttribute('aria-expanded', String(!isOpen));
    if (isOpen) closeDropdowns();
  });

  nav?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement) {
      closeDropdowns();
      nav.setAttribute('data-open', 'false');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDropdowns();
  });
</script>
