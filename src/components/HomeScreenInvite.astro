---
interface Props { lang: 'sl' | 'en' }
const { lang } = Astro.props;
const copy = lang === 'en' ? {
  title: 'STK at your fingertips',
  description: 'Add the race calendar to your phone’s Home Screen and open it as an app.',
  how: 'How to add it?',
  install: 'Install STK',
  androidSteps: ['Open STK in your Android browser.', 'In the browser menu, choose Install app or Add to Home screen (wording varies by browser).', 'Confirm the addition. If neither option is available, try Chrome.'],
  dismiss: 'Dismiss STK Home Screen invitation for 90 days',
  steps: ['Open STK in Safari.', 'Choose Share → Add to Home Screen.', 'Make sure “Open as Web App” is enabled, then tap Add.'],
  note: 'Your saved “My races” may not transfer automatically between your browser and the installed web app.'
} : {
  title: 'STK vedno pri roki',
  description: 'Dodajte tekaški koledar na začetni zaslon telefona in ga odpirajte kot aplikacijo.',
  how: 'Kako dodati?',
  install: 'Namesti STK',
  androidSteps: ['Odprite STK v brskalniku na Androidu.', 'V meniju brskalnika izberite Namesti aplikacijo ali Dodaj na začetni zaslon (poimenovanje je odvisno od brskalnika).', 'Potrdite dodajanje. Če možnosti ni, poskusite v Chromu.'],
  dismiss: 'Skrij povabilo za dodajanje STK na začetni zaslon za 90 dni',
  steps: ['Odprite STK v Safariju.', 'Izberite Deli → Dodaj na začetni zaslon.', 'Preverite, da je vključeno »Open as Web App«, in tapnite Dodaj.'],
  note: 'Shranjeni »Moji teki« se morda ne prenesejo samodejno med brskalnikom in nameščeno spletno aplikacijo.'
};
---

<article class="home-utility-card home-screen-invite" data-home-screen-invite hidden aria-labelledby="home-screen-invite-title">
  <span class="home-utility-mark" aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false"><rect x="9" y="3" width="14" height="26" rx="3"/><path d="M14 7h4M15 25h2M16 12v8M12 16h8"/></svg></span>
  <h3 id="home-screen-invite-title">{copy.title}</h3>
  <p>{copy.description}</p>
  <div class="home-screen-actions">
  <button class="home-utility-link home-screen-install" type="button" data-install-stk hidden>{copy.install}</button>
  <details>
    <summary class="home-utility-link">{copy.how}</summary>
    <ol data-install-platform="iphone" hidden>{copy.steps.map(step => <li>{step}</li>)}</ol>
    <ol data-install-platform="android" hidden>{copy.androidSteps.map(step => <li>{step}</li>)}</ol>
    <p class="home-screen-note">{copy.note}</p>
  </details>
  </div>
  <button class="home-screen-dismiss" type="button" data-dismiss-home-screen-invite aria-label={copy.dismiss}>×</button>
</article>

<!-- The shared head script has checked this visit before any card can be shown. -->
<script is:inline>window.stkConnectHomeScreenInvite?.();</script>

<style>
  .home-screen-invite[hidden] { display: none !important; }
  .home-screen-invite { position: relative; padding-right: 54px; }
  .home-screen-actions { grid-column: 2; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0 12px; min-width: 0; }
  .home-screen-invite details { min-width: 0; }
  .home-screen-invite details[open] { flex-basis: 100%; }
  .home-screen-actions:has(details[open]) .home-screen-install { display: none; }
  .home-screen-invite summary { cursor: pointer; min-height: 44px; padding: 10px 0; }
  .home-screen-install { margin-top: 0; min-height: 44px; border: 0; background: transparent; padding: 10px 0; font: inherit; font-weight: 850; cursor: pointer; }
  .home-screen-invite [hidden] { display: none !important; }
  .home-screen-invite ol { margin: 10px 0; padding-left: 20px; }
  .home-screen-invite li + li { margin-top: 6px; }
  .home-screen-invite .home-screen-note { font-size: 0.875rem; margin-bottom: 0; }
  .home-screen-dismiss {
    position: absolute; top: 7px; right: 3px;
    width: 44px; height: 44px; padding: 0;
    border: 0; border-radius: 8px; background: transparent;
    color: var(--deep-teal); font-size: 1.5rem; cursor: pointer;
  }
  .home-screen-dismiss:focus-visible, summary:focus-visible, .home-screen-install:focus-visible {
    outline: 2px solid var(--deep-teal); outline-offset: 3px;
  }
  @media (min-width: 720px) { .home-screen-invite { grid-column: 1 / -1; } }
</style>
