---
import BaseLayout from '../../../layouts/BaseLayout.astro';

---

<BaseLayout title="My races | Slovenski Tekaški Koledar" description="A list of races saved in this browser." lang="en" languageSwitchHref="/moji-teki/" brandHref="/en/" brandLabel="Slovenski Tekaški Koledar - English home" navLabel="Main navigation" menuLabel="Menu">
  <main class="page-section my-races-page">
    <div class="container narrow-container">
      <h1>My races</h1>
      <p class="lead">These are the races you saved while browsing the calendar.</p>
      <div class="my-races-tabs" role="tablist" aria-label="My races views">
        <button type="button" role="tab" aria-selected="true" data-my-races-tab="plan">Plan</button>
        <button type="button" role="tab" aria-selected="false" data-my-races-tab="season">My season</button>
      </div>
      <div role="tabpanel" data-my-races-panel="plan"><div data-my-races-app data-language="en" class="my-races-app" aria-live="polite"></div></div>
      <div role="tabpanel" data-my-races-panel="season" hidden><div data-my-season-app class="my-season-app" aria-live="polite"></div></div>
    </div>
  </main>
</BaseLayout>

<script>
  import { initMyRacesPage, initMyRacesTabs } from '../../../my-races-client';
  initMyRacesTabs();
  initMyRacesPage();
</script>
