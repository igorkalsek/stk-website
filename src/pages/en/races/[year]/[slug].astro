---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { attachAdditionalDataByMasterRow, fetchAdditionalEventData, type AdditionalEventData } from '../../../../utils-additional';
import { buildGoogleCalendarEventUrl, buildIcsDataUrl, buildIcsFilename, buildOutlookCalendarEventUrl } from '../../../../utils-calendar';
import { buildEnglishEventDetailPath, buildEventDetailPath, buildEventDetailSlug, mapPublicRaceEvent, slugMatchesEvent, toApiRecords, type PublicRaceEvent } from '../../../../utils-event-detail';
import { buildMasterApiPath, isAdditionalDataEnabledForYear, SUPPORTED_PUBLIC_YEARS, type PublicYear } from '../../../../utils-public-year';
import { formatSloveneDistances } from '../../../../utils-slovenian';
import { formatEnglishSurface } from '../../../../utils-english';
import { enrichEventsWithVoteUrls, isVoteUrlSafeForEvent } from '../../../../utils-vote';
import { getCanonicalOrigin } from '../../../../utils-site-url';

type DetailEvent = PublicRaceEvent & { additionalData?: AdditionalEventData | null };

const API_BASE = 'https://stk-master-api.igor-kalsek.workers.dev';
const TOP_API_URL = `${API_BASE}/top?scope=upcoming&limit=1000`;

export async function getStaticPaths() {
  const paths = [];
  for (const year of SUPPORTED_PUBLIC_YEARS) {
    let response: Response;
    try {
      response = await fetch(`https://stk-master-api.igor-kalsek.workers.dev${buildMasterApiPath(year)}`, { headers: { Accept: 'application/json' } });
    } catch (error) {
      console.warn(`English detail pages getStaticPaths skipped ${year}`, error);
      continue;
    }
    if (!response.ok) continue;
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
    const events = toApiRecords(await response.json())
      .map((item) => mapPublicRaceEvent(item, year, today))
      .filter((event): event is PublicRaceEvent => Boolean(event))
      .sort((a, b) => a.dateValue - b.dateValue || a.title.localeCompare(b.title, 'sl-SI'));
    paths.push(...events.map((event) => ({
      params: { year, slug: buildEventDetailSlug(event) },
      props: { event, year }
    })));
  }
  return paths;
}

const { event: baseEvent, year } = Astro.props as { event?: PublicRaceEvent; year?: PublicYear };
const slug = Astro.params.slug ?? '';
const isValidYear = SUPPORTED_PUBLIC_YEARS.includes(year as PublicYear);
const eventYear = isValidYear ? year as PublicYear : undefined;
let event: DetailEvent | null = baseEvent && isValidYear && slugMatchesEvent(slug, baseEvent) ? baseEvent : null;

if (event && eventYear && isAdditionalDataEnabledForYear(eventYear)) {
  try {
    const [withAdditional] = attachAdditionalDataByMasterRow([event], await fetchAdditionalEventData());
    event = withAdditional;
  } catch (error) {
    console.warn('English detail pages additional data skipped', error);
  }
}

if (event && year === '2026') {
  try {
    const topResponse = await fetch(TOP_API_URL, { headers: { Accept: 'application/json' } });
    if (topResponse.ok) {
      const [withVoteUrl] = enrichEventsWithVoteUrls([event], toApiRecords(await topResponse.json()));
      event = withVoteUrl;
    }
  } catch (error) {
    console.warn('English detail pages vote enrichment skipped', error);
  }
}

const formatDate = (value: string) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${value}T00:00:00`));
const formatStartTime = (value: string) => {
  const match = value.trim().match(/^(\d{1,2}):(\d{2})(.*)$/);
  return match ? `${match[1].padStart(2, '0')}:${match[2]}${match[3] ?? ''}` : value.trim();
};
const formatSurface = formatEnglishSurface;
const calendarOptions = event ? {
  googleUrl: buildGoogleCalendarEventUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl, language: 'en' }),
  icsUrl: buildIcsDataUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl, language: 'en' }),
  icsFilename: buildIcsFilename({ title: event.title, date: event.date }),
  outlookUrl: buildOutlookCalendarEventUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl, language: 'en' })
} : null;
const voteUrl = event?.voteUrl && isVoteUrlSafeForEvent(event, event.voteUrl).safe ? event.voteUrl : '';
const description = event
  ? `${event.title} – ${formatDate(event.date)}${event.place ? `, ${event.place}` : ''}. Distances: ${event.distances ? formatSloveneDistances(event.distances) : 'not listed'}. Details, official notice, registration and calendar links on Slovenski Tekaški Koledar.`
  : 'Race details are currently unavailable. Check the race finder.';
const title = event ? `${event.title} | Run Slovenia Race Calendar` : 'Race not found | Run Slovenia Race Calendar';
const canonicalPath = event ? buildEnglishEventDetailPath(event) : `/en/find-races/${year === '2027' ? '?year=2027' : ''}`;
const searchPath = year === '2027' ? '/en/find-races/?year=2027' : '/en/find-races/';
const canonicalOrigin = getCanonicalOrigin(Astro.url.origin);
const shareUrl = event ? new URL(buildEnglishEventDetailPath(event), canonicalOrigin).href : '';
const correctionUrl = event ? `/dodaj-ali-popravi-tek/?event=${encodeURIComponent(event.title)}&year=${encodeURIComponent(event.year)}` : '/dodaj-ali-popravi-tek/';
const slovenePath = event ? buildEventDetailPath(event) : searchPath;

const getDateStatus = (value: string) => {
  const eventTime = new Date(`${value}T00:00:00`).getTime();
  const now = new Date();
  const todayTime = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  if (!Number.isFinite(eventTime)) return '';
  const days = Math.round((eventTime - todayTime) / 86_400_000);
  if (days === 0) return 'Today';
  if (days > 0) return `Coming in ${days} ${days === 1 ? 'day' : 'days'}`;
  return 'This race has already passed';
};
const formatContextualDeadline = (label: string, value: string, expiredLabel: string) => {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return value ? `${label}: ${value}` : '';
  const deadlineTime = new Date(`${value}T00:00:00`).getTime();
  const now = new Date();
  const todayTime = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  const formatted = formatDate(value);
  return deadlineTime < todayTime ? `${expiredLabel}: ${formatted}` : `${label}: ${formatted}`;
};
const locationQuery = event ? [event.place, event.region].filter(Boolean).join(', ') : '';
const locationUrl = locationQuery ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(locationQuery)}` : '';
const eventStatus = event ? getDateStatus(event.date) : '';
const shareText = event ? `${event.title} – ${formatDate(event.date)}${event.place ? `, ${event.place}` : ''}. More on Slovenski Tekaški Koledar:` : 'Slovenski Tekaški Koledar:';
const encodedShareUrl = encodeURIComponent(shareUrl);
const encodedShareText = encodeURIComponent(`${shareText} ${shareUrl}`);
const encodedShareTitle = encodeURIComponent(event?.title ?? 'Slovenski Tekaški Koledar');
const shareLinks = shareUrl ? {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedShareUrl}`,
  whatsapp: `https://wa.me/?text=${encodedShareText}`,
  twitter: `https://twitter.com/intent/tweet?text=${encodedShareText}`,
  email: `mailto:?subject=${encodedShareTitle}&body=${encodedShareText}`
} : null;

const parseRegistrationAmount = (value: string) => {
  if (!value) return null;
  const amount = Number(value.replace(',', '.').replace(/[^\d.-]/g, ''));
  return Number.isFinite(amount) ? amount : null;
};

const heroBadges = event ? [
  event.surface ? { label: 'Surface', value: formatSurface(event.surface) } : null,
  event.distances ? { label: 'Distances', value: formatSloveneDistances(event.distances) } : null,
  event.startTime ? { label: 'Start', value: `Start ${formatStartTime(event.startTime)}` } : null,
  event.cup ? { label: 'Series', value: event.cup } : null
].filter((item): item is { label: string; value: string } => Boolean(item)) : [];

const hasText = (value: string | undefined | null) => Boolean(value?.trim());
const formatMoneyRange = (minValue = '', maxValue = '') => {
  const normalizeAmount = (value: string) => {
    const amount = Number(value.replace(',', '.').replace(/[^\d.-]/g, ''));
    return Number.isFinite(amount) ? amount : null;
  };
  const formatAmount = (amount: number) => amount.toLocaleString('sl-SI', { maximumFractionDigits: 2, minimumFractionDigits: Number.isInteger(amount) ? 0 : 2 });
  const min = normalizeAmount(minValue);
  const max = normalizeAmount(maxValue);
  if (min === null && max === null) return '';
  if (min !== null && max !== null && min !== max) return `${formatAmount(min)}–${formatAmount(max)} €`;
  return `${formatAmount(min ?? max ?? 0)} €`;
};
const formatYesNo = (value: string) => {
  const normalized = value.trim().toLocaleLowerCase('sl-SI');
  if (['da', 'yes', 'true'].includes(normalized)) return 'Yes';
  if (['ne', 'no', 'false'].includes(normalized)) return 'No';
  return value.trim();
};
const formatEnglishPublicNotes = (value: string) => value
  .replace(/družinam prijazno:/giu, 'Family-friendly:')
  .replace(/otroški teki brezplačni/giu, 'children’s races are free')
  .replace(/otroški teki/giu, 'children’s races');
const detailItems = event ? [
  { icon: '📅', label: 'Date', value: formatDate(event.date) },
  { icon: '📍', label: 'Location', value: [event.place, event.region].filter(Boolean).join(' · ') },
  { icon: '👟', label: 'Distances', value: event.distances ? formatSloveneDistances(event.distances) : '' },
  { icon: '🕘', label: 'Start', value: event.startTime ? formatStartTime(event.startTime) : '' },
  { icon: '🏆', label: 'Cup/series', value: event.cup }
].filter((item) => hasText(item.value)) : [];
const registrationItems = event?.additionalData ? [
  { label: 'Entry fee', value: formatMoneyRange(event.additionalData.registrationMinEur, event.additionalData.registrationMaxEur) },
  { label: 'Registration deadline', value: formatContextualDeadline('Registration deadline', event.additionalData.registrationDeadline, 'Registration deadline has passed') },
  { label: 'Cheaper entry', value: formatContextualDeadline('Cheaper entry until', event.additionalData.earlyRegistrationDeadline, 'Cheaper-entry deadline has passed') },
  { label: 'Race-day registration', value: formatYesNo(event.additionalData.dayOfRegistration) === 'Yes' ? 'Race-day registration is available' : formatYesNo(event.additionalData.dayOfRegistration) }
].filter((item) => hasText(item.value)) : [];
const routeItems = event?.additionalData ? [
  { label: 'GPX / map', value: event.additionalData.routeUrl },
  { label: 'Elevation gain', value: event.additionalData.elevationGain ? `${event.additionalData.elevationGain.trim()} m+` : '' }
].filter((item) => hasText(item.value)) : [];
const offerPrice = event?.additionalData ? parseRegistrationAmount(event.additionalData.registrationMinEur || event.additionalData.registrationMaxEur) : null;
const jsonLd = event ? {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.date,
  endDate: event.date,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  ...(event.place ? {
    location: {
      '@type': 'Place',
      name: event.place,
      address: [event.place, event.region, 'Slovenia'].filter(Boolean).join(', ')
    }
  } : {}),
  url: shareUrl,
  description,
  ...(offerPrice !== null ? {
    offers: {
      '@type': 'Offer',
      price: offerPrice,
      priceCurrency: 'EUR',
      url: event.registrationUrl || event.noticeUrl || shareUrl,
      availability: 'https://schema.org/InStock'
    }
  } : {})
} : null;

---

<BaseLayout title={title} description={description} lang="en" canonicalPath={canonicalPath} canonicalUrl={event ? shareUrl : undefined} alternateLinks={event ? [{ lang: 'sl', href: slovenePath }, { lang: 'en', href: buildEnglishEventDetailPath(event) }] : []} navItems={[{ href: '/en/', label: 'Home' }, { href: '/en/find-races/', label: 'Find' }, { href: '/en/family-friendly-races/', label: 'Family-friendly' }, { href: '/en/group-runs/', label: 'Group runs' }, { href: '/en/most-voted-races/', label: 'Most voted' }, { href: '/en/personal-calendar/', label: 'Calendar' }, { href: '/en/stk-tekobot/', label: 'STK Tekobot' }]} brandHref="/en/" brandLabel="Slovenski Tekaški Koledar - English home" navLabel="Main navigation" menuLabel="Menu">
  {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <main>
    {event ? (
      <>
        <section class="section container event-detail-top-section" aria-labelledby="event-detail-title">
          <div class="event-detail-profile-hero">
            <nav class="event-detail-breadcrumb" aria-label="Navigation">
              <a href={searchPath}>Race finder</a>
              <span aria-hidden="true">›</span>
              <span>{event.title}</span>
            </nav>
            <div class="event-detail-language-switch"><span class="eyebrow">Race profile · {year}</span><a href={slovenePath} hreflang="sl">Slovenščina</a></div>
            <h1 id="event-detail-title">{event.title}</h1>
            <p class="event-detail-date-line">
              <time datetime={event.date}>{formatDate(event.date)}</time>{event.place && <> · {event.place}</>}{event.region && <> · {event.region}</>}
            </p>
            {heroBadges.length > 0 && (
              <div class="event-detail-hero-badges" aria-label="Race summary">
                {heroBadges.map((badge) => (
                  <span class="event-chip event-detail-hero-chip" aria-label={`${badge.label}: ${badge.value}`}>{badge.value}</span>
                ))}
              </div>
            )}
            <div class="event-detail-status-row">
              {eventStatus && <span class="pill event-detail-status-pill">{eventStatus}</span>}
              {event.familyFriendly && <span class="pill pill-family">Family-friendly</span>}
            </div>
          </div>
        </section>

        <section class="section container event-detail-section" aria-label="Race details">
          <div class="event-detail-page-grid" data-event-row={event.row} data-analytics-event-id={event.id} data-analytics-event-name={event.title} data-analytics-event-date={event.date}>
            <div class="event-detail-main-column">
              <article class="info-card event-detail-panel">
                <h2><span aria-hidden="true">⚡</span> Quick facts</h2>
                <div class="event-detail-summary-grid" aria-label="Short race summary">
                  {detailItems.map((item) => (
                    <div class="event-detail-summary-item">
                      <span class="event-detail-summary-icon" aria-hidden="true">{item.icon}</span>
                      <span class="event-detail-summary-content">
                        <span class="event-detail-summary-label">{item.label}</span>
                        <strong>{item.value}</strong>
                      </span>
                    </div>
                  ))}
                </div>
              </article>

              <article class="info-card event-detail-panel">
                <h2><span aria-hidden="true">🎟</span> Registration and fees</h2>
                {registrationItems.length > 0 ? (
                  <dl class="event-detail-list">
                    {registrationItems.map((item) => (
                      <div>
                        <dt>{item.label}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                  </dl>
                ) : <p>Entry fee and registration deadline details are not listed yet.</p>}
              </article>

              <article class="info-card event-detail-panel">
                <h2><span aria-hidden="true">🗺</span> Course</h2>
                {routeItems.length > 0 ? (
                  <dl class="event-detail-list">
                    {routeItems.map((item) => (
                      <div>
                        <dt>{item.label}</dt>
                        <dd>{item.label === 'GPX / map' ? <a class="button button-small button-secondary-light event-detail-inline-action event-detail-icon-button" href={item.value} target="_blank" rel="noopener noreferrer" data-analytics-link-type="trasa" aria-label="Open GPX or course map"><span aria-hidden="true">🗺</span></a> : item.value}</dd>
                      </div>
                    ))}
                  </dl>
                ) : <p>Course details are not listed yet. The organizer can send a GPX file or course link.</p>}
              </article>

              <article class="info-card event-detail-panel">
                <h2><span aria-hidden="true">ℹ️</span> Notes and source</h2>
                {event.publicNotes ? <p>{formatEnglishPublicNotes(event.publicNotes)}</p> : <p>Public notes are not listed.</p>}
                <p class="data-note">The calendar is informative. Always check the organizer's official information before registering.</p>
                {event.noticeUrl && <p class="data-note">Source: organizer's official notice.</p>}
              </article>
            </div>

            <aside class="info-card event-detail-action-panel" aria-label="Main links">
              <div>
                <h2>Main links</h2>
                <div class="event-detail-action-list">
                  {event.noticeUrl && <a class="button button-primary" href={event.noticeUrl} target="_blank" rel="noopener noreferrer" data-analytics-link-type="razpis"><span class="action-icon" aria-hidden="true">📄</span><span>Official notice</span></a>}
                  {event.registrationUrl && <a class="button button-primary" href={event.registrationUrl} target="_blank" rel="noopener noreferrer" data-analytics-link-type="prijava"><span class="action-icon" aria-hidden="true">✍️</span><span>Registration</span></a>}
                  {voteUrl && <a class="button button-secondary-light" href={voteUrl} target="_blank" rel="noopener noreferrer" data-analytics-action="vote" aria-label={`Vote for ${event.title}`}><span class="action-icon" aria-hidden="true">👍</span><span>Vote</span></a>}
                </div>
              </div>

              <div class="event-detail-organizer-panel">
                <h2>Are you the organizer of this race?</h2>
                <p>Help keep the race details accurate and useful.</p>
                <div class="event-detail-organizer-actions">
                  <a class="button button-small button-secondary-light" href={correctionUrl}>Suggest a correction or update</a>
                </div>
              </div>

              {shareLinks && (
                <div class="event-detail-share-panel">
                  <h2>Share race</h2>
                  <div class="event-detail-share-options" aria-label="Sharing options">
                    <button class="button button-small button-secondary-light event-detail-icon-button" type="button" data-copy-share-url={shareUrl} aria-label="Copy link"><span aria-hidden="true">🔗</span></button>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook"><span aria-hidden="true">f</span></a>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp"><span aria-hidden="true">WA</span></a>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" aria-label="Share on X"><span aria-hidden="true">𝕏</span></a>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.email} aria-label="Send by email"><span aria-hidden="true">✉</span></a>
                  </div>
                  <p class="event-detail-share-feedback" data-share-feedback role="status" aria-live="polite"></p>
                </div>
              )}

              {calendarOptions && (calendarOptions.googleUrl || calendarOptions.icsUrl || calendarOptions.outlookUrl) && (
                <div class="event-detail-calendar-panel">
                  <h2>Add to your calendar</h2>
                  <div class="event-detail-calendar-actions">
                    {calendarOptions.googleUrl && <a class="button button-small button-secondary-light event-detail-icon-button" href={calendarOptions.googleUrl} target="_blank" rel="noopener noreferrer" data-analytics-calendar-type="google" aria-label="Add to Google Calendar"><span aria-hidden="true">G</span></a>}
                    {calendarOptions.icsUrl && <a class="button button-small button-secondary-light event-detail-icon-button" href={calendarOptions.icsUrl} download={calendarOptions.icsFilename} data-analytics-calendar-type="ics" aria-label="Download iCal file"><span aria-hidden="true"></span></a>}
                    {calendarOptions.outlookUrl ? <a class="button button-small button-secondary-light event-detail-icon-button" href={calendarOptions.outlookUrl} target="_blank" rel="noopener noreferrer" data-analytics-calendar-type="outlook" aria-label="Add to Outlook"><span aria-hidden="true">O</span></a> : calendarOptions.icsUrl && <a class="button button-small button-secondary-light event-detail-icon-button" href={calendarOptions.icsUrl} download={calendarOptions.icsFilename} data-analytics-calendar-type="ics" aria-label="Download Outlook iCal file"><span aria-hidden="true">O</span></a>}
                  </div>
                </div>
              )}

              {locationUrl && (
                <div class="event-detail-location-panel">
                  <h2>Location</h2>
                  <a class="button button-small button-secondary-light event-detail-icon-button" href={locationUrl} target="_blank" rel="noopener noreferrer" aria-label="Open location"><span aria-hidden="true">📍</span></a>
                </div>
              )}
            </aside>
          </div>
          <p class="event-detail-back"><a class="button button-secondary-light" href={searchPath}>Back to race finder</a></p>
        </section>
      </>
    ) : (
      <section class="page-hero container" aria-labelledby="event-not-found-title">
        <span class="eyebrow">Race not found</span>
        <h1 id="event-not-found-title">We cannot show this race</h1>
        <p>The race does not exist, is not public, or the link is incorrect. Data for another year is not shown under this URL.</p>
        <a class="button button-primary" href={searchPath}>Back to race finder</a>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-share-url]');
  const feedback = document.querySelector<HTMLElement>('[data-share-feedback]');

  const setShareFeedback = (message: string) => {
    if (feedback) feedback.textContent = message;
  };

  const copyWithFallback = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return true;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'absolute';
    textarea.style.left = '-9999px';
    document.body.appendChild(textarea);
    textarea.select();

    const copied = document.execCommand('copy');
    textarea.remove();

    if (!copied) throw new Error('copy failed');
    return true;
  };

  copyButtons.forEach((copyButton) => {
    copyButton.addEventListener('click', async () => {
      const shareUrl = copyButton.getAttribute('data-copy-share-url') || window.location.href;
      try {
        await copyWithFallback(shareUrl);
        setShareFeedback('Link copied.');
      } catch {
        setShareFeedback('Could not copy the link.');
      }
    });
  });
</script>
