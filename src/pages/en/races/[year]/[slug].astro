---
import RelatedRaceCards from '../../../../components/RelatedRaceCards.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { type AdditionalEventData } from '../../../../utils-additional';
import { buildGoogleCalendarEventUrl, buildIcsDataUrl, buildIcsFilename, buildOutlookCalendarEventUrl } from '../../../../utils-calendar';
import { buildEnglishEventDetailPath, buildEventDetailPath, getStableEventId, slugMatchesEvent, type PublicRaceEvent } from '../../../../utils-event-detail';
import { isAdditionalDataEnabledForYear, SUPPORTED_PUBLIC_YEARS, type PublicYear } from '../../../../utils-public-year';
import { formatSloveneDistances } from '../../../../utils-slovenian';
import { isVoteUrlSafeForEvent } from '../../../../utils-vote';
import { buildRaceCopyDescription } from '../../../../utils-race-copy';
import { buildRaceShareUrls } from '../../../../utils-race-share';
import { type RelatedRaceCard } from '../../../../utils-related-races';
import { attachAdditionalDataCached, enrichEventsWithVoteUrlsCached, getDetailStaticPaths, maybePrintBuildTiming } from '../../../../utils-build-data';
import { buildCourseHeading, buildCourseRows, buildFamilyInfo, buildKeyFacts, buildPrimaryActions, buildRaceHighlights, buildPublicNotes, buildRegistrationRows, formatDetailSurface } from '../../../../utils-race-detail-view';

type DetailEvent = PublicRaceEvent & { additionalData?: AdditionalEventData | null };

export async function getStaticPaths() {
  return getDetailStaticPaths('en');
}

const { event: baseEvent, year, relatedRaces = [] } = Astro.props as { event?: PublicRaceEvent; year?: PublicYear; relatedRaces?: RelatedRaceCard[] };
const slug = Astro.params.slug ?? '';
const isValidYear = SUPPORTED_PUBLIC_YEARS.includes(year as PublicYear);
const eventYear = isValidYear ? year as PublicYear : undefined;
let event: DetailEvent | null = baseEvent && isValidYear && slugMatchesEvent(slug, baseEvent) ? baseEvent : null;

if (event && eventYear && isAdditionalDataEnabledForYear(eventYear)) {
  try {
    const [withAdditional] = await attachAdditionalDataCached([event]);
    event = withAdditional;
  } catch (error) {
    console.warn('English detail pages additional data skipped', error);
  }
}

if (event && year === '2026') {
  try {
    const [withVoteUrl] = await enrichEventsWithVoteUrlsCached([event]);
    event = withVoteUrl;
  } catch (error) {
    console.warn('English detail pages vote enrichment skipped', error);
  }
}

maybePrintBuildTiming();

const formatDate = (value: string) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${value}T00:00:00`));
const calendarOptions = event ? {
  googleUrl: buildGoogleCalendarEventUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl, language: 'en' }),
  icsUrl: buildIcsDataUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl, language: 'en' }),
  icsFilename: buildIcsFilename({ title: event.title, date: event.date }),
  outlookUrl: buildOutlookCalendarEventUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl, language: 'en' })
} : null;
const voteUrl = event?.voteUrl && isVoteUrlSafeForEvent(event, event.voteUrl).safe ? event.voteUrl : '';
const description = event
  ? `${event.title} – ${formatDate(event.date)}${event.place ? `, ${event.place}` : ''}. Distances: ${event.distances ? formatSloveneDistances(event.distances) : 'not listed'}. Details, official notice, registration and calendar links on Slovenski Tekaški Koledar.`
  : 'Race details are currently unavailable. Check the race finder.';
const title = event ? `${event.title} | Run Slovenia Race Calendar` : 'Race not found | Run Slovenia Race Calendar';
const canonicalPath = event ? buildEnglishEventDetailPath(event) : `/en/find-races/${year === '2027' ? '?year=2027' : ''}`;
const searchPath = year === '2027' ? '/en/find-races/?year=2027' : '/en/find-races/';
const copyDescription = event ? buildRaceCopyDescription({ event, language: 'en', formatDate }) : '';
const shareLinks = event ? buildRaceShareUrls({ event, language: 'en', formatDate }) : null;
const shareUrl = shareLinks?.detailUrl ?? '';
const buildCorrectionUrl = (event: DetailEvent, language: 'sl' | 'en', returnUrl: string) => {
  const params = new URLSearchParams({
    event: event.title,
    year: event.year,
    date: event.date ?? '',
    place: event.place ?? '',
    source: 'detail',
    lang: language,
    returnUrl
  });
  return `/dodaj-ali-popravi-tek/?${params.toString()}`;
};
const correctionUrl = event ? buildCorrectionUrl(event, 'en', shareUrl) : '/dodaj-ali-popravi-tek/';
const slovenePath = event ? buildEventDetailPath(event) : searchPath;

const getDateStatus = (value: string) => {
  const eventTime = new Date(`${value}T00:00:00`).getTime();
  const now = new Date();
  const todayTime = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  if (!Number.isFinite(eventTime)) return '';
  const days = Math.round((eventTime - todayTime) / 86_400_000);
  if (days === 0) return 'Today';
  if (days > 0) return `Coming in ${days} ${days === 1 ? 'day' : 'days'}`;
  return 'This race has already passed';
};
const locationQuery = event ? [event.place, event.region].filter(Boolean).join(', ') : '';
const locationUrl = locationQuery ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(locationQuery)}` : '';
const eventStatus = event ? getDateStatus(event.date) : '';
const parseRegistrationAmount = (value: string) => {
  if (!value) return null;
  const amount = Number(value.replace(',', '.').replace(/[^\d.-]/g, ''));
  return Number.isFinite(amount) ? amount : null;
};

const primaryActions = event ? buildPrimaryActions(event, 'en') : [];
const savedRaceEventId = event ? getStableEventId(event) : '';
const heroBadges = event ? [
  event.surface ? { label: 'Surface', value: formatDetailSurface(event.surface, 'en') } : null,
  event.familyFriendly ? { label: 'Families', value: 'Family-friendly' } : null
].filter((item): item is { label: string; value: string } => Boolean(item)) : [];
const detailItems = event ? buildKeyFacts(event, 'en') : [];
const raceHighlights = event ? buildRaceHighlights(event, 'en') : [];
const registrationItems = event ? buildRegistrationRows(event, 'en', formatDate) : [];
const routeItems = event ? buildCourseRows(event, 'en') : [];
const courseHeading = event ? buildCourseHeading(event, 'en') : '';
const familyInfo = event ? buildFamilyInfo(event, 'en') : [];
const publicNotes = event ? buildPublicNotes(event, 'en', familyInfo) : '';
const offerPrice = event?.additionalData ? parseRegistrationAmount(event.additionalData.registrationMinEur || event.additionalData.registrationMaxEur) : null;
const jsonLd = event ? {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.date,
  endDate: event.date,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  ...(event.place ? {
    location: {
      '@type': 'Place',
      name: event.place,
      address: [event.place, event.region, 'Slovenia'].filter(Boolean).join(', ')
    }
  } : {}),
  url: shareUrl,
  description,
  ...(offerPrice !== null ? {
    offers: {
      '@type': 'Offer',
      price: offerPrice,
      priceCurrency: 'EUR',
      url: event.registrationUrl || event.noticeUrl || shareUrl,
      availability: 'https://schema.org/InStock'
    }
  } : {})
} : null;

---

<BaseLayout title={title} description={description} lang="en" canonicalPath={canonicalPath} canonicalUrl={event ? shareUrl : undefined} alternateLinks={event ? [{ lang: 'sl', href: slovenePath }, { lang: 'en', href: buildEnglishEventDetailPath(event) }] : []} languageSwitchHref={slovenePath} navItems={[{ href: '/en/', label: 'Home' }, { href: '/en/find-races/', label: 'Find' }, { href: '/en/family-friendly-races/', label: 'Family-friendly' }, { href: '/en/group-runs/', label: 'Group runs' }, { href: '/en/most-voted-races/', label: 'Most voted' }, { href: '/en/personal-calendar/', label: 'Calendar' }, { href: '/en/stk-tekobot/', label: 'STK Tekobot' }]} brandHref="/en/" brandLabel="Slovenski Tekaški Koledar - English home" navLabel="Main navigation" menuLabel="Menu">
  {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <main>
    {event ? (
      <>
        <section class="section container event-detail-top-section" aria-labelledby="event-detail-title">
          <div class="event-detail-profile-hero">
            <nav class="event-detail-breadcrumb" aria-label="Navigation">
              <a href={searchPath}>Race finder</a>
              <span aria-hidden="true">›</span>
              <span>{event.title}</span>
            </nav>
            <div class="event-detail-language-switch"><span class="eyebrow">Race profile · {year}</span><a href={slovenePath} hreflang="sl">Slovenščina</a></div>
            <h1 id="event-detail-title">{event.title}</h1>
            <p class="event-detail-date-line">
              <time datetime={event.date}>{formatDate(event.date)}</time>{event.place && <> · {event.place}</>}{event.region && <> · {event.region}</>}
            </p>
            {heroBadges.length > 0 && (
              <div class="event-detail-hero-badges" aria-label="Race summary">
                {heroBadges.map((badge) => (
                  <span class="event-chip event-detail-hero-chip" aria-label={`${badge.label}: ${badge.value}`}>{badge.value}</span>
                ))}
              </div>
            )}
            <div class="event-detail-status-row">
              {eventStatus && <span class="pill event-detail-status-pill">{eventStatus}</span>}
            </div>
            <div class="event-detail-primary-actions event-detail-action-list" aria-label="Main links">
              {primaryActions.map((action) => (
                <a class="button button-primary" href={action.url} target="_blank" rel="noopener noreferrer" data-analytics-link-type={action.analyticsType}><span class="action-icon" aria-hidden="true">{action.kind === 'registration' ? '✍️' : '📄'}</span><span>{action.label}</span></a>
              ))}
              <button class="button button-secondary-light saved-race-button" type="button" data-saved-race-button data-event-id={savedRaceEventId} data-event-year={event.year} data-event-date={event.date} data-event-title={event.title} data-language="en" aria-pressed="false" aria-label="Save race"><span class="action-icon" aria-hidden="true">☆</span><span data-saved-race-label>Save race</span></button>
            </div>
          </div>
        </section>

        <section class="section container event-detail-section" aria-label="Race details">
          <div class="event-detail-page-grid" data-event-row={event.row} data-analytics-event-id={event.id} data-analytics-event-name={event.title} data-analytics-event-date={event.date} data-analytics-event-year={event.year}>
            <div class="event-detail-main-column">
              <article class="info-card event-detail-panel">
                <h2><span aria-hidden="true">⚡</span> Quick facts</h2>
                <div class="event-detail-summary-grid" aria-label="Short race summary">
                  {detailItems.map((item) => (
                    <div class="event-detail-summary-item">
                      <span class="event-detail-summary-content">
                        <span class="event-detail-summary-label">{item.label}</span>
                        <strong>{item.value}</strong>
                      </span>
                    </div>
                  ))}
                </div>
              </article>
              {raceHighlights.length > 0 && (
                <article class="info-card event-detail-panel event-detail-highlights" aria-labelledby="race-highlights-title">
                  <h2 id="race-highlights-title">What stands out about this race</h2>
                  <ul>
                    {raceHighlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </article>
              )}


              {registrationItems.length > 0 && (
                <article class="info-card event-detail-panel">
                  <h2><span aria-hidden="true">🎟</span> Registration and participation</h2>
                  <dl class="event-detail-list">
                    {registrationItems.map((item) => (
                      <div>
                        <dt>{item.label}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                  </dl>
                </article>
              )}

              {routeItems.length > 0 && (
                <article class="info-card event-detail-panel">
                  <h2><span aria-hidden="true">🗺</span> {courseHeading}</h2>
                  <dl class="event-detail-list">
                    {routeItems.map((item) => (
                      <div>
                        <dt>{item.label}</dt>
                        <dd>{item.url ? <a class="button button-small button-secondary-light event-detail-inline-action" href={item.url} target="_blank" rel="noopener noreferrer" data-analytics-link-type={item.analyticsType} aria-label={item.ariaLabel}>{item.value}</a> : item.value}</dd>
                      </div>
                    ))}
                  </dl>
                </article>
              )}

              {familyInfo.length > 0 && (
                <article class="info-card event-detail-panel">
                  <h2><span aria-hidden="true">👨‍👩‍👧‍👦</span> Families and children</h2>
                  {familyInfo.map((text) => <p>{text}</p>)}
                </article>
              )}

              {publicNotes && (
                <article class="info-card event-detail-panel">
                  <h2><span aria-hidden="true">ℹ️</span> Notes</h2>
                  <p>{publicNotes}</p>
                </article>
              )}

              <p class="data-note event-detail-disclaimer">Information is provided for guidance. Before registering, check the official announcement or organizer’s website.</p>
            </div>

            <aside class="info-card event-detail-action-panel" aria-label="Main links">
              {voteUrl && (
                <div>
                  <h2>Voting</h2>
                  <div class="event-detail-action-list">
                    <a class="button button-secondary-light" href={voteUrl} target="_blank" rel="noopener noreferrer" data-analytics-action="vote" aria-label={`Vote for ${event.title}`}><span class="action-icon" aria-hidden="true">👍</span><span>Vote</span></a>
                  </div>
                </div>
              )}

              <div class="event-detail-organizer-panel">
                <h2>Are you the organizer of this race?</h2>
                <p>Help runners find accurate information. Send an update for the official notice, registration, course, entry fees, children’s races or other race details.</p>
                <div class="event-detail-organizer-actions">
                  <a class="button button-small button-secondary-light" href={correctionUrl} data-analytics-event-type="correction_clicked" data-analytics-action-type="correction_cta_click">Suggest an update or correction</a>
                </div>
              </div>

              {shareLinks && (
                <div class="event-detail-share-panel">
                  <h2>Share race</h2>
                  <button class="button button-small button-secondary-light event-detail-copy-description-button" type="button" data-copy-share-text={copyDescription} data-analytics-event-type="copy_clicked" data-analytics-action-type="copy_description_click" data-analytics-target-url={shareUrl}>Copy description</button>
                  <div class="event-detail-share-options" aria-label="Sharing options">
                    <button class="button button-small button-secondary-light event-detail-icon-button" type="button" data-copy-share-url={shareUrl} data-analytics-event-type="copy_clicked" data-analytics-action-type="copy_url_click" data-analytics-target-url={shareUrl} aria-label="Copy link"><span aria-hidden="true">🔗</span></button>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" data-facebook-share-button data-copy-share-text={copyDescription} data-facebook-copy-success="The description was copied. Paste it into your Facebook post." data-facebook-copy-failure="Facebook is open. Use the Copy description button for the description." data-analytics-event-type="share_clicked" data-analytics-action-type="share_facebook_click" data-analytics-target-url={shareUrl} aria-label="Share on Facebook"><span aria-hidden="true">f</span></a>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" data-analytics-event-type="share_clicked" data-analytics-action-type="share_whatsapp_click" data-analytics-target-url={shareUrl} aria-label="Share on WhatsApp"><span aria-hidden="true">WA</span></a>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" data-analytics-event-type="share_clicked" data-analytics-action-type="share_x_click" data-analytics-target-url={shareUrl} aria-label="Share on X"><span aria-hidden="true">𝕏</span></a>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.email} data-analytics-event-type="share_clicked" data-analytics-action-type="share_email_click" data-analytics-target-url={shareUrl} aria-label="Send by email"><span aria-hidden="true">✉</span></a>
                  </div>
                  <p class="event-detail-share-feedback" data-share-feedback role="status" aria-live="polite"></p>
                </div>
              )}

              {calendarOptions && (calendarOptions.googleUrl || calendarOptions.icsUrl || calendarOptions.outlookUrl) && (
                <div class="event-detail-calendar-panel">
                  <h2>Add to your calendar</h2>
                  <div class="event-detail-calendar-actions">
                    {calendarOptions.googleUrl && <a class="button button-small button-secondary-light event-detail-icon-button" href={calendarOptions.googleUrl} target="_blank" rel="noopener noreferrer" data-analytics-calendar-type="google" aria-label="Add to Google Calendar"><span aria-hidden="true">G</span></a>}
                    {calendarOptions.icsUrl && <a class="button button-small button-secondary-light event-detail-icon-button" href={calendarOptions.icsUrl} download={calendarOptions.icsFilename} data-analytics-calendar-type="ics" aria-label="Download iCal file"><span aria-hidden="true"></span></a>}
                    {calendarOptions.outlookUrl ? <a class="button button-small button-secondary-light event-detail-icon-button" href={calendarOptions.outlookUrl} target="_blank" rel="noopener noreferrer" data-analytics-calendar-type="outlook" aria-label="Add to Outlook"><span aria-hidden="true">O</span></a> : calendarOptions.icsUrl && <a class="button button-small button-secondary-light event-detail-icon-button" href={calendarOptions.icsUrl} download={calendarOptions.icsFilename} data-analytics-calendar-type="ics" aria-label="Download Outlook iCal file"><span aria-hidden="true">O</span></a>}
                  </div>
                </div>
              )}

              {locationUrl && (
                <div class="event-detail-location-panel">
                  <h2>Location</h2>
                  <a class="button button-small button-secondary-light event-detail-icon-button" href={locationUrl} target="_blank" rel="noopener noreferrer" data-analytics-link-type="map_click" aria-label="Open location"><span aria-hidden="true">📍</span></a>
                </div>
              )}
            </aside>
          </div>
          <RelatedRaceCards races={relatedRaces} language="en" />
          <p class="event-detail-back"><a class="button button-secondary-light" href={searchPath}>Back to race finder</a></p>
        </section>
      </>
    ) : (
      <section class="page-hero container" aria-labelledby="event-not-found-title">
        <span class="eyebrow">Race not found</span>
        <h1 id="event-not-found-title">We cannot show this race</h1>
        <p>The race does not exist, is not public, or the link is incorrect. Data for another year is not shown under this URL.</p>
        <a class="button button-primary" href={searchPath}>Back to race finder</a>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  import { initSavedRaceButtons } from '../../../../saved-races-client';
  initSavedRaceButtons();
  const copyLinkButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-share-url]');
  const copyTextButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-share-text]');

  const facebookShareButtons = document.querySelectorAll<HTMLAnchorElement>('[data-facebook-share-button]');
  const feedback = document.querySelector<HTMLElement>('[data-share-feedback]');

  const setShareFeedback = (message: string) => {
    if (feedback) feedback.textContent = message;
  };

  const copyWithFallback = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return true;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'absolute';
    textarea.style.left = '-9999px';
    document.body.appendChild(textarea);
    textarea.select();

    const copied = document.execCommand('copy');
    textarea.remove();

    if (!copied) throw new Error('copy failed');
    return true;
  };


  facebookShareButtons.forEach((shareButton) => {
    shareButton.addEventListener('click', async () => {
      const shareText = shareButton.getAttribute('data-copy-share-text') || '';
      try {
        await copyWithFallback(shareText);
        setShareFeedback(shareButton.getAttribute('data-facebook-copy-success') || '');
      } catch {
        setShareFeedback(shareButton.getAttribute('data-facebook-copy-failure') || '');
      }
    });
  });

  copyLinkButtons.forEach((copyButton) => {
    copyButton.addEventListener('click', async () => {
      const shareUrl = copyButton.getAttribute('data-copy-share-url') || window.location.href;
      try {
        await copyWithFallback(shareUrl);
        setShareFeedback('Link copied.');
      } catch {
        setShareFeedback('Could not copy the link.');
      }
    });
  });

  copyTextButtons.forEach((copyButton) => {
    copyButton.addEventListener('click', async () => {
      const shareText = copyButton.getAttribute('data-copy-share-text') || '';
      try {
        await copyWithFallback(shareText);
        setShareFeedback('Copied.');
      } catch {
        setShareFeedback('Could not copy the description.');
      }
    });
  });
</script>
