---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks from '../../components/SocialLinks.astro';

---

<BaseLayout
  title="Run Slovenia: Race Calendar | Slovenski Tekaški Koledar"
  description="Slovenia’s independent running guide with confirmed races, official links, registration pages, family-friendly events, group runs and practical details for runners."
  lang="en"
  canonicalPath="/en/"
  alternateLinks={[
    { lang: 'sl', href: '/' },
    { lang: 'en', href: '/en/' }
  ]}
  brandHref="/en/"
  brandLabel="Slovenski Tekaški Koledar - English home"
  navLabel="Main navigation"
  menuLabel="Menu"
>
  <main>
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-card">
        <div class="hero-content">
          <span class="eyebrow">Slovenia’s independent running guide</span>
          <h1 id="hero-title">Find your next race in Slovenia</h1>
          <p class="hero-lead">A clean starting point for confirmed races, practical details and official race links across Slovenia.</p>
          <p class="hero-sublead">
            Search by date, region, terrain or distance.
          </p>
          <div class="hero-actions" aria-label="Main links">
            <div class="cta-row cta-primary-row">
              <a class="button button-primary hero-primary-cta" href="/en/find-races/">Find a race</a>
            </div>
            <p class="hero-helper-link">Not sure what to choose? <a href="/en/stk-tekobot/">Ask STK Tekobot.</a></p>
            <p class="hero-helper-link hero-my-races-link">Save interesting races and find them later in <a href="/en/my-races/">My races</a>.</p>
          </div>
        </div>
        <aside class="hero-preview" aria-label="Calendar preview">
          <div class="hero-preview-heading">
            <span class="hero-preview-kicker" data-hero-preview-title>Highlighted in the next days</span>
            <p class="hero-preview-helper" data-hero-preview-helper>Nearby upcoming races attracting the most interest.</p>
          </div>
          <ol class="hero-preview-list" data-hero-preview-list>
            <li><span>loading</span><strong>Upcoming races will appear here.</strong></li>
          </ol>
        </aside>
      </div>

      <div class="stats-intro">
        <h2>2026 calendar at a glance</h2>
        <p>The figures cover the full public calendar from January to December 2026.</p>
      </div>
      <div class="stats-strip" aria-label="Calendar statistics">
        <article class="stat-card stat-card-races">
          <span class="stat-mark" aria-hidden="true"></span>
          <span class="stat-value" data-stat="confirmed_public_events_total">…</span>
          <span class="stat-label">confirmed races</span>
        </article>
        <article class="stat-card stat-card-family">
          <span class="stat-mark" aria-hidden="true"></span>
          <span class="stat-value" data-stat="family_friendly_total">…</span>
          <span class="stat-label">family-friendly</span>
        </article>
        <article class="stat-card stat-card-group">
          <span class="stat-mark" aria-hidden="true"></span>
          <span class="stat-value" data-stat="group_runs_total">…</span>
          <span class="stat-label">group runs</span>
        </article>
      </div>
    </section>

    <section class="section container registration-deadlines-section" aria-labelledby="registration-deadlines-title" data-registration-deadlines-section hidden>
      <article class="registration-deadlines-card">
        <div class="registration-deadlines-heading">
          <div>
            <h2 id="registration-deadlines-title">Registration deadlines</h2>
            <p>Upcoming registration and cheaper-entry deadlines for races in Slovenia.</p>
          </div>
        </div>
        <ol class="registration-deadlines-list" data-registration-deadlines></ol>
        <a class="registration-deadlines-cta" href="/en/find-races/">View all deadlines in race search</a>
      </article>
    </section>

    <section class="section container feature-strip-section" aria-labelledby="extra-data-title">
      <article class="feature-strip">
        <div class="feature-strip-copy">
          <h2 id="extra-data-title">More than race dates</h2>
          <p>STK also includes entry fees, registration deadlines, elevation gain, routes / GPX and kids’ races.</p>
        </div>
        <div class="feature-strip-actions">
          <div class="feature-chip-list" aria-label="Extra details in race search">
            <span class="feature-chip">Entry fees</span>
            <span class="feature-chip">Registration deadlines</span>
            <span class="feature-chip">Elevation gain</span>
            <span class="feature-chip">Routes / GPX</span>
            <span class="feature-chip">Kids’ races</span>
          </div>
          <a class="button button-small button-secondary-light" href="/en/find-races/">Open race search</a>
        </div>
      </article>
    </section>

    <section class="section container" aria-labelledby="nearest-title">
      <div class="section-heading section-heading-with-action">
        <div>
          <h2 id="nearest-title">This week’s races</h2>
          <p>Upcoming confirmed races from the Slovenian Race Calendar.</p>
        </div>
        <a class="button button-secondary-light" href="/en/find-races/">View all races</a>
      </div>
      <div class="card-grid" data-nearest-events>
        <article class="event-card">
          <h3>Loading data</h3>
          <p>Upcoming races will be shown here.</p>
          <div class="event-meta">
            <span class="pill">Calendar</span>
          </div>
        </article>
      </div>
      <p class="data-note nearest-search-note">For entry fees, race-day registration, routes and elevation gain, open the <a href="/en/find-races/">race search</a>.</p>
    </section>

    <section class="section container" aria-labelledby="voted-title">
      <div class="section-heading section-heading-with-action">
        <div>
          <h2 id="voted-title">Races attracting the most interest</h2>
          <p data-top-description>Upcoming races attracting the most visitor interest in registration, official information, calendar and route links.</p>
        </div>
        <div class="section-heading-actions">
          <a class="button button-secondary-light" href="/en/find-races/">View all races</a>
        </div>
      </div>
      <div class="card-grid" data-top-events>
        <article class="event-card">
          <h3>Loading data</h3>
          <p>Races attracting the most interest will be shown here.</p>
          <div class="event-meta">
            <span class="pill">Visitor interest</span>
          </div>
        </article>
      </div>
      <p class="data-note" data-status="top">The selection is based on visitor interest in registration, official information, calendar and route links.</p>
    </section>

    <section class="section container" aria-labelledby="organizer-cta-title">
      <article class="info-card organizer-cta-card">
        <div>
          <span class="eyebrow eyebrow-light">For organisers</span>
          <h2 id="organizer-cta-title">Organising a race?</h2>
          <p>Add a new event or correct race details so runners can find accurate information more easily. The form is currently available in Slovenian.</p>
        </div>
        <a class="button button-secondary-light" href="/dodaj-ali-popravi-tek/">Add or correct a race</a>
      </article>
    </section>

    <section class="section container" aria-labelledby="trust-title">
      <article class="info-card trust-card">
        <div>
          <span class="eyebrow eyebrow-light">About the calendar</span>
          <h2 id="trust-title">Why use the Slovenian Race Calendar?</h2>
          <p>The calendar brings together confirmed running events across Slovenia, including links to official announcements, registration pages and personal calendar options. Before registering, always check the official race announcement or the organiser’s website.</p>
          <p class="tekobot-note">STK Tekobot helps you find races using natural-language questions.</p>
        </div>
        <a class="button button-secondary-light" href="/en/stk-tekobot/">Ask STK Tekobot</a>
      </article>
    </section>

    <section class="section container" aria-labelledby="calendar-cta-title">
      <article class="info-card calendar-cta-card">
        <div>
          <span class="eyebrow eyebrow-light">Personal calendar</span>
          <h2 id="calendar-cta-title">Add races to your personal calendar</h2>
          <p>You can follow STK races in your personal calendar and see them next to your other plans.</p>
        </div>
        <a class="button button-secondary-light" href="/en/personal-calendar/">Personal calendar instructions</a>
      </article>
    </section>

    <section class="section container" aria-labelledby="updates-title">
      <div class="section-heading">
        <h2 id="updates-title">Latest updates</h2>
        <p>The latest calendar changes help you quickly see what was added or corrected.</p>
      </div>
      <div class="card-grid" data-recent-updates>
        <article class="update-card">
          <h3>Loading data</h3>
          <p>Latest changes will appear here.</p>
        </article>
      </div>
    </section>

    <section class="section container social-cta-section" aria-labelledby="social-cta-title">
      <article class="info-card social-cta-card">
        <div>
          <h2 id="social-cta-title">Follow STK</h2>
          <p>Follow STK for weekly race highlights, new events, updates, voting and running calendar posts.</p>
        </div>
        <SocialLinks lang="en" labelledby="social-cta-title" />
      </article>
    </section>

  </main>
</BaseLayout>

<script>
  import { buildGoogleCalendarEventUrl, buildIcsDataUrl, buildIcsFilename, buildOutlookCalendarEventUrl } from '../../utils-calendar';
  import { buildPrimaryActions } from '../../utils-race-detail-view';
  import { getDisplayEventTitle } from '../../utils-events';
  import { buildEnglishEventDetailPath, getStableEventId } from '../../utils-event-detail';
  import { initSavedRaceButtons } from '../../saved-races-client';

  type ApiRecord = Record<string, unknown>;

  const API_BASE = 'https://stk-master-api.igor-kalsek.workers.dev';
  const INTEREST_PREVIEW_URL = '/api/interest-preview';
  const numberFormatter = new Intl.NumberFormat('en-US');
  const dateFormatter = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  const ARRAY_KEYS = ['events', 'next_week', 'updates', 'recent_updates', 'recent', 'data', 'items', 'rows', 'changes', 'results'];
  const STATS_CONTAINERS = ['stats', 'totals', 'summary', 'data', 'counts'];
  const TITLE_CONTAINERS = ['event', 'race', 'data', 'item', 'row', 'fields'];
  const enableApiDebug = import.meta.env.DEV;
  const debugEnabled = enableApiDebug && new URLSearchParams(window.location.search).get('debug') === '1';

  const setStatus = (name: string, message: string) => {
    const element = document.querySelector(`[data-status="${name}"]`);
    if (element) element.textContent = message;
  };

  const asRecord = (value: unknown): ApiRecord | null =>
    value && typeof value === 'object' && !Array.isArray(value) ? value as ApiRecord : null;

  const toArray = (payload: unknown): ApiRecord[] => {
    if (Array.isArray(payload)) return payload.filter(asRecord) as ApiRecord[];

    const record = asRecord(payload);
    if (!record) return [];

    for (const key of ARRAY_KEYS) {
      const value = record[key];
      if (Array.isArray(value)) return value.filter(asRecord) as ApiRecord[];
    }

    for (const key of ARRAY_KEYS) {
      const nested = asRecord(record[key]);
      if (!nested) continue;
      const nestedArray = toArray(nested);
      if (nestedArray.length) return nestedArray;
    }

    return [];
  };

  const getRecordArray = (record: ApiRecord | null, key: string): ApiRecord[] => {
    const value = record?.[key];
    return Array.isArray(value) ? value.filter(asRecord) as ApiRecord[] : [];
  };

  const getRecentUpdateGroups = (payload: unknown) => {
    const root = asRecord(payload);
    const recentUpdatesLastDays = asRecord(root?.recent_updates_last_days);
    const source = recentUpdatesLastDays ?? root;

    return {
      updatedEvents: getRecordArray(source, 'updated_events'),
      newEvents: getRecordArray(source, 'new_events'),
      confirmedEvents: getRecordArray(source, 'confirmed_events')
    };
  };

  const pick = (item: ApiRecord, keys: string[], fallback = ''): string => {
    for (const key of keys) {
      const value = item[key];
      if (value !== undefined && value !== null && String(value).trim() !== '') return String(value).trim();
    }
    return fallback;
  };

  const valueAtPath = (item: ApiRecord, path: string): unknown => {
    let current: unknown = item;
    for (const part of path.split('.')) {
      const record = asRecord(current);
      if (!record) return undefined;
      current = record[part];
    }
    return current;
  };

  const pickPath = (item: ApiRecord, paths: string[], fallback = ''): string => {
    for (const path of paths) {
      const value = valueAtPath(item, path);
      if (value !== undefined && value !== null && String(value).trim() !== '') return String(value).trim();
    }
    return fallback;
  };

  const normalizeKey = (key: string) => key.toLowerCase().trim().replace(/[\s_-]+/g, '');

  const getVoteUrlTitle = (item: ApiRecord) => {
    if (typeof item?.vote_url !== 'string' || !item.vote_url.trim()) return '';
    try {
      const url = new URL(item.vote_url);
      return url.searchParams.get('entry.1386641006')?.trim() ?? '';
    } catch (error) {
      const match = item.vote_url.match(/[?&]entry\.1386641006=([^&]+)/);
      return match ? decodeURIComponent(match[1].replace(/\+/g, ' ')).trim() : '';
    }
  };


  const getTopEventTitle = (item: ApiRecord) => {
    if (typeof item?.naziv_prireditve === 'string' && item.naziv_prireditve.trim()) {
      return item.naziv_prireditve.trim();
    }

    if (typeof item?.naziv === 'string' && item.naziv.trim()) {
      return item.naziv.trim();
    }

    if (typeof item?.title === 'string' && item.title.trim()) {
      return item.title.trim();
    }

    if (typeof item?.name === 'string' && item.name.trim()) {
      return item.name.trim();
    }

    const event = asRecord(item?.event);
    if (typeof event?.naziv_prireditve === 'string' && event.naziv_prireditve.trim()) {
      return event.naziv_prireditve.trim();
    }

    if (typeof event?.naziv === 'string' && event.naziv.trim()) {
      return event.naziv.trim();
    }

    const race = asRecord(item?.race);
    if (typeof race?.naziv_prireditve === 'string' && race.naziv_prireditve.trim()) {
      return race.naziv_prireditve.trim();
    }

    if (typeof race?.naziv === 'string' && race.naziv.trim()) {
      return race.naziv.trim();
    }

    const data = asRecord(item?.data);
    if (typeof data?.naziv_prireditve === 'string' && data.naziv_prireditve.trim()) {
      return data.naziv_prireditve.trim();
    }

    if (typeof data?.naziv === 'string' && data.naziv.trim()) {
      return data.naziv.trim();
    }

    const voteUrlTitle = getVoteUrlTitle(item);
    return voteUrlTitle || 'Race name unavailable';
  };

  const objectKeys = (value: unknown) => asRecord(value) ? Object.keys(value as ApiRecord) : [];

  const describeKeys = (value: unknown) => {
    const record = asRecord(value);
    if (!record) return '—';
    const entries = Object.entries(record).slice(0, 18).map(([key, entryValue]) => {
      const type = Array.isArray(entryValue) ? 'array' : typeof entryValue;
      return `${key}:${type}`;
    });
    return entries.length ? entries.join(', ') : 'brez ključev';
  };

  const rawValueText = (value: unknown) =>
    value === undefined || value === null || String(value) === '' ? 'not detected' : String(value);

  const compactJsonPreview = (value: unknown) => {
    try {
      return JSON.stringify(value, null, 2).slice(0, 1600);
    } catch (error) {
      return 'JSON preview ni na voljo.';
    }
  };

  const isMissing = (value: unknown) =>
    value === undefined || value === null || String(value).trim() === '';

  const rowKey = (value: unknown) => {
    const record = asRecord(value);
    if (!record) return '';
    const row = record.row ?? record.Row ?? record.ROW ?? record.row_number ?? record.rowNumber;
    return row === undefined || row === null ? '' : String(row).trim();
  };

  const getFieldValue = (item: ApiRecord, key: string) => {
    const exact = item[key];
    if (!isMissing(exact)) return String(exact).trim();

    const wanted = normalizeKey(key);
    for (const [itemKey, value] of Object.entries(item)) {
      if (normalizeKey(itemKey) === wanted && !isMissing(value)) return String(value).trim();
    }

    return '';
  };

  const getMasterRows = (payload: unknown): ApiRecord[] => {
    const record = asRecord(payload);
    if (record && Array.isArray(record.data)) return record.data.filter(asRecord) as ApiRecord[];

    const fallbackRows = toArray(payload);
    if (fallbackRows.length) return fallbackRows;

    if (record) {
      for (const value of Object.values(record)) {
        const rows = toArray(value);
        if (rows.length) return rows;
      }
    }

    return [];
  };

  const normalizedText = (value: unknown) =>
    String(value ?? '').trim().toLowerCase().replace(/\s+/g, ' ');

  const fieldMatches = (topEvent: ApiRecord, masterEvent: ApiRecord, key: string) => {
    const topValue = normalizedText(getFieldValue(topEvent, key));
    const masterValue = normalizedText(getFieldValue(masterEvent, key));
    return Boolean(topValue && masterValue && topValue === masterValue);
  };

  const matchScore = (topEvent: ApiRecord, masterEvent: ApiRecord) => {
    const matchingFields = ['datum', 'kraj', 'regija', 'razdalje_km']
      .filter((key) => fieldMatches(topEvent, masterEvent, key)).length;
    const rowMatches = rowKey(topEvent) && rowKey(topEvent) === rowKey(masterEvent);
    const rowScore = rowMatches && matchingFields > 0 ? 2 : 0;
    return rowScore + matchingFields;
  };

  const findMasterMatch = (topEvent: ApiRecord, masterRows: ApiRecord[]) => {
    let bestMatch: ApiRecord | null = null;
    let bestScore = 0;

    for (const masterEvent of masterRows) {
      const score = matchScore(topEvent, masterEvent);
      if (score > bestScore) {
        bestScore = score;
        bestMatch = masterEvent;
      }
    }

    return bestScore >= 3 ? bestMatch : null;
  };

  const copyIfMissing = (target: ApiRecord, source: ApiRecord, key: string) => {
    if (!isMissing(target[key])) return false;
    const sourceValue = getFieldValue(source, key);
    if (!sourceValue) return false;
    target[key] = sourceValue;
    return true;
  };

  const enrichTopEventsFromMaster = (events: ApiRecord[], masterRows: ApiRecord[]) => events.map((event) => {
    const enriched = { ...event };
    const topTitle = getTopEventTitle(event);
    const voteUrlTitle = getVoteUrlTitle(event);
    const match = findMasterMatch(event, masterRows);
    enriched.__master_matched = Boolean(match);
    enriched.__matched_master_row = match ? rowKey(match) : '';
    enriched.__matched_master_title = match ? getFieldValue(match, 'naziv_prireditve') : '';
    enriched.__vote_url_title = voteUrlTitle;
    enriched.__title_source = topTitle !== 'Race name unavailable' && topTitle !== voteUrlTitle ? 'top' : 'not detected';

    if (match) {
      const filledTitle = copyIfMissing(enriched, match, 'naziv_prireditve');
      copyIfMissing(enriched, match, 'datum');
      copyIfMissing(enriched, match, 'kraj');
      copyIfMissing(enriched, match, 'regija');
      copyIfMissing(enriched, match, 'tip_podlage');
      copyIfMissing(enriched, match, 'razdalje_km');
      if (filledTitle) enriched.__title_source = 'master';
    }

    if (getTopEventTitle(enriched) === 'Race name unavailable' && voteUrlTitle) {
      enriched.naziv_prireditve = voteUrlTitle;
      enriched.__title_source = 'vote_url';
    } else if (getTopEventTitle(enriched) === voteUrlTitle && voteUrlTitle) {
      enriched.__title_source = 'vote_url';
    }

    return enriched;
  });

  const createDebugPanel = () => {
    if (!debugEnabled) return;
    const main = document.querySelector('main');
    if (!main) return;
    main.insertAdjacentHTML('beforeend', `
      <section class="section container api-debug" data-api-debug aria-label="Development diagnostics">
        <details>
          <summary>Development diagnostics</summary>
          <div class="debug-grid">
            <p><strong>/stats loaded:</strong> <span data-debug-stats>no</span></p>
            <p><strong>/top loaded:</strong> <span data-debug-top>no</span></p>
            <p><strong>/top item count:</strong> <span data-debug-top-count>0</span></p>
            <p><strong>First top item keys:</strong> <code data-debug-top-keys>—</code></p>
            <div><strong>First top raw JSON:</strong> <pre class="debug-json" data-debug-top-json>—</pre></div>
            <p><strong>First top raw row:</strong> <code data-debug-top-row>not detected</code></p>
            <p><strong>Top nested keys:</strong> <code data-debug-top-nested>—</code></p>
            <p><strong>Raw naziv_prireditve:</strong> <code data-debug-top-title-raw>not detected</code></p>
            <p><strong>Raw votes_total:</strong> <code data-debug-top-votes-raw>not detected</code></p>
            <p><strong>Master loaded:</strong> <span data-debug-master>no</span></p>
            <p><strong>Master data item count:</strong> <span data-debug-master-count>0</span></p>
            <p><strong>vote_url title fallback:</strong> <code data-debug-vote-url-title>not detected</code></p>
            <p><strong>Matched master row:</strong> <span data-debug-master-match>no</span></p>
            <p><strong>Matched master title:</strong> <code data-debug-master-title>not detected</code></p>
            <p><strong>Detected top title:</strong> <code data-debug-top-title>not detected</code></p>
            <p><strong>Detected title source:</strong> <code data-debug-top-title-source>not detected</code></p>
            <p><strong>Detected top votes:</strong> <code data-debug-top-votes>not detected</code></p>
            <p><strong>/recent_updates loaded:</strong> <span data-debug-recent>no</span></p>
            <p><strong>/recent_updates item count:</strong> <span data-debug-recent-count>0</span></p>
            <p><strong>First recent item keys:</strong> <code data-debug-recent-keys>—</code></p>
          </div>
        </details>
      </section>
    `);
  };

  const setDebug = (target: string, text: string) => {
    if (!debugEnabled) return;
    const element = document.querySelector(`[data-debug-${target}]`);
    if (element) element.textContent = text;
  };

  const setDebugKeys = (target: string, value: unknown) => {
    if (!debugEnabled) return;
    const element = document.querySelector(`[data-debug-${target}-keys]`);
    if (element) element.textContent = describeKeys(value);
  };

  const nestedKeySummary = (item: unknown) => {
    const record = asRecord(item);
    if (!record) return '—';
    const parts = TITLE_CONTAINERS.map((container) => {
      const nested = asRecord(valueAtPath(record, container))
        ?? asRecord(Object.entries(record).find(([key]) => normalizeKey(key) === normalizeKey(container))?.[1]);
      return nested ? `${container}: ${describeKeys(nested)}` : '';
    }).filter(Boolean);
    return parts.length ? parts.join(' | ') : '—';
  };

  const setDebugTopDetails = (items: ApiRecord[], rawItems = items) => {
    if (!debugEnabled) return;
    const first = items[0];
    const rawFirst = rawItems[0];
    setDebug('top-count', String(rawItems.length));
    setDebugKeys('top', rawFirst);
    setDebug('top-json', rawFirst ? compactJsonPreview(rawFirst) : '—');
    setDebug('top-row', rowKey(rawFirst) || 'not detected');
    setDebug('top-nested', nestedKeySummary(rawFirst));
    setDebug('top-title-raw', rawValueText(rawFirst?.naziv_prireditve));
    setDebug('top-votes-raw', rawValueText(rawFirst?.votes_total));
    setDebug('vote-url-title', rawValueText(first?.__vote_url_title ?? getVoteUrlTitle(rawFirst ?? {})));
    setDebug('master-match', first?.__master_matched ? `yes (${rawValueText(first.__matched_master_row)})` : 'no');
    setDebug('master-title', rawValueText(first?.__matched_master_title));
    setDebug('top-title', first ? getTopEventTitle(first) : 'not detected');
    setDebug('top-title-source', first?.__title_source ? String(first.__title_source) : 'not detected');
    setDebug('top-votes', first ? formatVoteCount(getTopEventVotes(first)) : 'not detected');
  };

  const setDebugRecentDetails = (items: ApiRecord[]) => {
    if (!debugEnabled) return;
    setDebug('recent-count', String(items.length));
    setDebugKeys('recent', items[0]);
  };

  const parsePositiveInteger = (value: unknown) => {
    if (value === null || value === undefined) return null;
    const number = Number.parseInt(String(value).trim(), 10);
    return Number.isFinite(number) && number > 0 ? number : null;
  };

  const getTopEventVotes = (item: ApiRecord) =>
    parsePositiveInteger(item?.votes_total)
    ?? parsePositiveInteger(item?.votes_last_7_days)
    ?? parsePositiveInteger(item?.glasovi)
    ?? parsePositiveInteger(item?.votes)
    ?? parsePositiveInteger(item?.vote_count)
    ?? parsePositiveInteger(item?.total_votes);

  const formatVoteCount = (votes: number | null) => {
    if (votes === null) return 'not detected';
    return `${numberFormatter.format(votes)} ${votes === 1 ? 'vote' : 'votes'}`;
  };

  const normalizeVisibleTitleDash = (title: string) => title.replace(/\s+-\s+/g, ' – ');

  const titleForEvent = (event: ApiRecord) => {
    const title = normalizeVisibleTitleDash(getDisplayEventTitle(getTopEventTitle(event)));
    if (title) return title;

    if (import.meta.env.DEV) {
      console.warn('STK top event title missing. Available keys:', objectKeys(event));
    }

    return 'Race name unavailable';
  };

  const pickNumber = (item: ApiRecord, keys: string[]): number | null => {
    for (const key of keys) {
      const value = item[key];
      if (value === undefined || value === null || String(value).trim() === '') continue;
      const numberValue = Number(value);
      if (Number.isFinite(numberValue)) return numberValue;
    }
    return null;
  };


  const numberFromStatArray = (items: ApiRecord[], keys: string[]): number | null => {
    for (const item of items) {
      const statName = pick(item, ['key', 'name', 'metric', 'field', 'id']);
      if (!keys.includes(statName)) continue;
      const value = pickNumber(item, ['value', 'count', 'total', 'amount']);
      if (value !== null) return value;
    }
    return null;
  };

  const pickNestedNumber = (payload: unknown, keys: string[]): number | null => {
    const root = asRecord(payload);
    if (!root) return null;

    const direct = pickNumber(root, keys);
    if (direct !== null) return direct;

    const rootArrayValue = numberFromStatArray(toArray(root), keys);
    if (rootArrayValue !== null) return rootArrayValue;

    for (const containerKey of STATS_CONTAINERS) {
      const nested = asRecord(root[containerKey]);
      if (!nested) continue;
      const nestedValue = pickNumber(nested, keys);
      if (nestedValue !== null) return nestedValue;

      const nestedArrayValue = numberFromStatArray(toArray(nested), keys);
      if (nestedArrayValue !== null) return nestedArrayValue;
    }

    return null;
  };

  const formatDate = (value: string) => {
    if (!value) return '';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
  };


  const formatDateBadge = (value: string) => {
    if (!value) return '';

    const date = new Date(`${value}T00:00:00`);
    if (Number.isNaN(date.getTime())) return value;

    const weekday = new Intl.DateTimeFormat('en-GB', { weekday: 'short' }).format(date).toLocaleUpperCase('en-GB');
    const compactDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' }).format(date);

    return `${weekday} · ${compactDate}`;
  };

  const escapeHtml = (value: string | number) => {
    const characters: Record<string, string> = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;'
    };
    return String(value).replace(/[&<>'"]/g, (character) => characters[character] ?? character);
  };

  const joinParts = (parts: string[]) => parts.filter(Boolean).join(' · ');

  const getEventStableId = (event: ApiRecord, title: string, date: string, place: string) => getStableEventId({
    row: pickPath(event, ['row', 'event.row', 'race.row', 'data.row']),
    date,
    naziv_prireditve: getEventTitle(event, title),
    place
  });

  const renderSavedRaceButton = (event: ApiRecord, title: string, date: string, place: string, iconOnly = false) => {
    const eventId = getEventStableId(event, title, date, place);
    const year = date.slice(0, 4) || '2026';
    if (!eventId || !/^202[67]$/.test(year)) return '';
    return `<button class="button button-small button-secondary-light saved-race-button${iconOnly ? ' saved-race-icon-button' : ''}" type="button" data-saved-race-button${iconOnly ? ' data-saved-race-icon-only="true" data-saved-race-remove-label="Remove from My races"' : ''} data-event-id="${escapeHtml(eventId)}" data-event-year="${escapeHtml(year)}" data-event-date="${escapeHtml(date)}" data-event-title="${escapeHtml(title)}" data-language="en" aria-pressed="false" aria-label="Save race"><span class="action-icon" aria-hidden="true">☆</span>${iconOnly ? '' : '<span data-saved-race-label>Save race</span>'}</button>`;
  };

  const normalizeDescription = (value: string) => value.toLocaleLowerCase('sl-SI').normalize('NFKC').replace(/\s+/g, ' ').trim();

  const RECENT_UPDATE_DESCRIPTIONS: Record<string, string> = {
    [normalizeDescription('Dodan otroški Tek Štrkcev 0.5 km, popravljena družinska opomba in dodana prijavna/informacijska povezava.')]:
      'Children’s race, family-friendly note and information/registration links were updated.'
  };

  const getRecentUpdateDescription = (value: string) => {
    if (!value) return '';
    return RECENT_UPDATE_DESCRIPTIONS[normalizeDescription(value)] ?? 'Calendar details for this race were updated.';
  };

  const normalize = (value: string) => value.toLocaleLowerCase('sl-SI').normalize('NFKC');

  const safeUrl = (value: string) => {
    if (!value) return '';
    try {
      const url = new URL(value);
      return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
    } catch {
      return '';
    }
  };


  const renderPrimaryActionLink = (action: ReturnType<typeof buildPrimaryActions>[number]) =>
    `<a class="button button-small ${action.kind === 'registration' ? 'button-primary' : 'button-secondary-light'}" href="${escapeHtml(action.url)}" target="_blank" rel="noopener noreferrer" data-analytics-link-type="${escapeHtml(action.analyticsType)}"><span class="action-icon" aria-hidden="true">${action.kind === 'registration' ? '✍️' : '📄'}</span><span>${escapeHtml(action.label)}</span></a>`;

  const renderCalendarOptions = ({ title, date, location = '', noticeUrl = '', registrationUrl = '' }: {
    title: string;
    date: string;
    location?: string;
    noticeUrl?: string;
    registrationUrl?: string;
  }) => {
    const event = { title, date, location, noticeUrl, registrationUrl, language: 'en' as const };
    const googleUrl = buildGoogleCalendarEventUrl(event);
    const icsUrl = buildIcsDataUrl(event);
    const icsFilename = buildIcsFilename(event);
    const outlookUrl = buildOutlookCalendarEventUrl(event);
    if (!googleUrl && !icsUrl && !outlookUrl) return '';

    const options = [
      googleUrl && `<a href="${escapeHtml(googleUrl)}" target="_blank" rel="noopener noreferrer">Google</a>`,
      icsUrl && `<a href="${escapeHtml(icsUrl)}" download="${escapeHtml(icsFilename)}">Apple / iCal</a>`,
      outlookUrl
        ? `<a href="${escapeHtml(outlookUrl)}" target="_blank" rel="noopener noreferrer">Outlook</a>`
        : icsUrl && `<a href="${escapeHtml(icsUrl)}" download="${escapeHtml(icsFilename)}">Outlook / .ics</a>`
    ].filter(Boolean).join('');

    return `
      <details class="calendar-menu">
        <summary class="button button-small button-secondary-light"><span aria-hidden="true">📅</span><span>Add to calendar</span></summary>
        <div class="calendar-menu-options">${options}</div>
      </details>
    `;
  };



  const nestedEventPaths = (field: string) => [
    field,
    `event.${field}`,
    `race.${field}`,
    `data.${field}`,
    `item.${field}`,
    `row.${field}`,
    `fields.${field}`
  ];

  const getEventTitle = (event: ApiRecord, fallback = 'Race name unavailable') =>
    pickPath(event, [
      ...nestedEventPaths('naziv_prireditve'),
      ...nestedEventPaths('naziv'),
      ...nestedEventPaths('title'),
      ...nestedEventPaths('name')
    ], fallback);

  const getEventField = (event: ApiRecord, field: string, aliases: string[] = []) =>
    pickPath(event, [
      ...nestedEventPaths(field),
      ...aliases.flatMap(nestedEventPaths)
    ], '');


  const LJUBLJANA_TIME_ZONE = 'Europe/Ljubljana';
  const ljubljanaDatePartsFormatter = new Intl.DateTimeFormat('en-CA', {
    timeZone: LJUBLJANA_TIME_ZONE,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  });

  const parseIsoDateValue = (value: string) => {
    const trimmedDate = value.trim();
    const match = trimmedDate.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!match) return Number.NaN;

    const [, year, month, day] = match;
    const dateValue = Date.UTC(Number(year), Number(month) - 1, Number(day));
    const date = new Date(dateValue);
    if (
      date.getUTCFullYear() !== Number(year) ||
      date.getUTCMonth() !== Number(month) - 1 ||
      date.getUTCDate() !== Number(day)
    ) {
      return Number.NaN;
    }

    return dateValue;
  };

  const todayStartValue = () => {
    const parts = Object.fromEntries(
      ljubljanaDatePartsFormatter.formatToParts(new Date())
        .filter((part) => part.type !== 'literal')
        .map((part) => [part.type, part.value])
    ) as Record<string, string>;

    return parseIsoDateValue(`${parts.year}-${parts.month}-${parts.day}`);
  };

  const daysFromToday = (days: number) => {
    const dateValue = todayStartValue();
    if (!Number.isFinite(dateValue)) return Number.NaN;
    const date = new Date(dateValue);
    date.setUTCDate(date.getUTCDate() + days);
    return date.getTime();
  };

  const eventDateValue = (event: ApiRecord) => {
    const date = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
    const dateValue = parseIsoDateValue(date);
    return Number.isFinite(dateValue) ? dateValue : null;
  };

  const compareEventDateThenTitle = (a: ApiRecord, b: ApiRecord) => {
    const dateDifference = (eventDateValue(a) ?? Number.POSITIVE_INFINITY) - (eventDateValue(b) ?? Number.POSITIVE_INFINITY);
    if (dateDifference !== 0) return dateDifference;

    return getDisplayEventTitle(getEventTitle(a)).localeCompare(getDisplayEventTitle(getEventTitle(b)), 'sl-SI');
  };

  const eventRowKey = (event: ApiRecord) => {
    const row = rowKey(event);
    if (row) return row;

    return pick(event, ['master_row', 'masterRow', 'master row']);
  };

  const eventIdentity = (event: ApiRecord) => {
    const row = eventRowKey(event);
    if (row) return `row:${row}`;

    const date = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
    const place = getEventField(event, 'kraj', ['place', 'city', 'location', 'Kraj']);
    return [date, getDisplayEventTitle(getEventTitle(event)), place]
      .map((part) => normalizedText(part))
      .filter(Boolean)
      .join('|');
  };

  const detailEventData = (event: ApiRecord) => ({
    year: getEventYear(event),
    row: rowKey(event),
    date: getEventField(event, 'datum', ['date', 'event_date', 'Datum']),
    title: getDisplayEventTitle(getEventTitle(event)),
    naziv_prireditve: getDisplayEventTitle(getEventTitle(event)),
    place: getEventField(event, 'kraj', ['place', 'city', 'location'])
  });

  const canonicalDetailEvent = (event: ApiRecord) => asRecord(event.__master_event) ?? event;

  const eventDetailPath = (event: ApiRecord) => buildEnglishEventDetailPath(detailEventData(canonicalDetailEvent(event)));

  const INTEREST_ID_KEYS = ['event_id', 'eventId', 'id', 'row', 'Row', 'master_row', 'masterRow'];

  const normalizeInterestEventId = (value: unknown) => {
    if (value === undefined || value === null) return '';
    const normalized = String(value).trim().toLocaleUpperCase('sl-SI').replace(/[\s_-]+/g, '');
    if (!normalized) return '';

    const prefixedMatch = normalized.match(/^R0*(\d+)$/);
    const numericMatch = normalized.match(/^0*(\d+)$/);
    const numericPart = prefixedMatch?.[1] ?? numericMatch?.[1];
    if (!numericPart) return '';

    const numberValue = Number.parseInt(numericPart, 10);
    if (!Number.isFinite(numberValue) || numberValue <= 0) return '';
    return `R${String(numberValue).padStart(6, '0')}`;
  };

  const eventIdValue = (event: ApiRecord) => {
    for (const key of INTEREST_ID_KEYS) {
      const value = getEventField(event, key);
      const normalizedId = normalizeInterestEventId(value);
      if (normalizedId) return normalizedId;
    }
    return '';
  };

  const buildUniqueEventIdIndex = (events: ApiRecord[]) => {
    const candidates = new Map<string, ApiRecord[]>();
    for (const event of events) {
      const id = eventIdValue(event);
      if (!id) continue;
      const bucket = candidates.get(id) ?? [];
      bucket.push(event);
      candidates.set(id, bucket);
    }

    const unique = new Map<string, ApiRecord>();
    for (const [id, matches] of candidates.entries()) {
      if (matches.length === 1) unique.set(id, matches[0]);
    }
    return unique;
  };

  const loadInterestPreviewPayload = async () => {
    const response = await fetch(INTEREST_PREVIEW_URL, { headers: { accept: 'application/json' } });
    const payload = await response.json().catch(() => null);
    if (!response.ok) throw new Error(`Interest preview request failed: ${response.status}`);
    const record = asRecord(payload);
    if (!record || record.ok !== true || record.type !== 'interest_preview') throw new Error('Interest preview response was not valid.');
    return record;
  };

  const isValidInterestPreviewMasterEvent = (event: ApiRecord, todayValue: number) => {
    if (!isConfirmedPublicUpcomingEvent(event, todayValue)) return false;
    if (getEventYear(event) !== '2026') return false;
    if (!getDisplayEventTitle(getEventTitle(event, '')).trim()) return false;
    if (!getEventField(event, 'datum', ['date', 'event_date', 'Datum'])) return false;
    return Boolean(eventDetailPath(event));
  };

  const getInterestPreviewRaces = async (masterRows: ApiRecord[], displayLimit = 5) => {
    const payload = await loadInterestPreviewPayload();
    const interestItems = getRecordArray(payload, 'items');
    if (!interestItems.length) return [];

    const todayValue = todayStartValue();
    const masterEventsById = buildUniqueEventIdIndex(
      masterRows.filter((event) => isValidInterestPreviewMasterEvent(event, todayValue))
    );
    const selectedIds = new Set<string>();
    const rankedEvents: ApiRecord[] = [];

    for (const item of interestItems) {
      const id = eventIdValue(item);
      if (!id || selectedIds.has(id)) continue;
      const match = masterEventsById.get(id);
      if (!match) continue;
      selectedIds.add(id);
      rankedEvents.push({ ...match, __interest_preview_ranked: true });
      if (rankedEvents.length >= displayLimit) break;
    }

    return rankedEvents;
  };

  const getHeroPreviewVotes = (event: ApiRecord) => parsePositiveInteger(event?.votes_total);

  const normalizeTopUpcomingRace = (event: ApiRecord) => {
    const votes = getTopEventVotes(event);
    return votes !== null ? { ...event, votes_total: votes } : { ...event };
  };

  const getTopUpcomingRaces = async () => {
    const payload = await loadJson('/top?scope=upcoming&limit=50');
    const rawEvents = toArray(payload);
    let events = rawEvents.map(normalizeTopUpcomingRace);

    try {
      const masterPayload = await loadJson('/');
      const masterRows = getMasterRows(masterPayload);
      setDebug('master', 'yes');
      setDebug('master-count', String(masterRows.length));
      events = enrichTopEventsFromMaster(events, masterRows).map(normalizeTopUpcomingRace);
    } catch (error) {
      setDebug('master', 'no');
      setDebug('master-count', '0');
    }

    return { events, rawEvents };
  };

  const hasConfirmedPublicFields = (event: ApiRecord) => {
    const status = getEventField(event, 'status_dogodka');
    if (status && normalize(status) !== 'potrjeno') return false;

    const isPublic = getEventField(event, 'vidno_v_javnem_koledarju');
    if (isPublic && isPublic.toLocaleUpperCase('sl-SI') !== 'DA') return false;

    return true;
  };

  const removeHeroVotes = (event: ApiRecord) => ({ ...event, votes_total: undefined });

  const renderHeroPreview = (interestEvents: ApiRecord[], fallbackCandidates: ApiRecord[] = []) => {
    const titleElement = document.querySelector('[data-hero-preview-title]');
    const helperElement = document.querySelector('[data-hero-preview-helper]');
    const listElement = document.querySelector('[data-hero-preview-list]');
    if (!listElement) return;

    const todayValue = todayStartValue();
    const cutoffValue = daysFromToday(14);
    const selectedIds = new Set<string>();
    const upcomingInterestEvents: ApiRecord[] = [];

    for (const event of interestEvents) {
      if (upcomingInterestEvents.length >= 3) break;
      const dateValue = eventDateValue(event);
      if (dateValue === null || dateValue < todayValue || dateValue > cutoffValue) continue;
      const identity = eventIdentity(event);
      if (identity && selectedIds.has(identity)) continue;
      if (identity) selectedIds.add(identity);
      upcomingInterestEvents.push(event);
    }

    const fallbackEvents: ApiRecord[] = [];
    const nearestFallbackEvents = fallbackCandidates
      .filter((event) => {
        const dateValue = eventDateValue(event);
        return dateValue !== null && dateValue >= todayValue;
      })
      .sort(compareEventDateThenTitle);
    for (const event of nearestFallbackEvents) {
      if (upcomingInterestEvents.length + fallbackEvents.length >= 3) break;
      const identity = eventIdentity(event);
      if (identity && selectedIds.has(identity)) continue;
      if (identity) selectedIds.add(identity);
      fallbackEvents.push(removeHeroVotes(event));
    }
    const previewEvents = [...upcomingInterestEvents, ...fallbackEvents].sort(compareEventDateThenTitle);

    if (titleElement) {
      titleElement.textContent = 'Highlighted in the next days';
    }
    if (helperElement) {
      helperElement.textContent = upcomingInterestEvents.length
        ? 'Nearby upcoming races attracting the most interest.'
        : 'Nearby upcoming races.';
    }

    if (!previewEvents.length) {
      listElement.innerHTML = '<li><span>soon</span><strong>Upcoming races will appear here.</strong></li>';
      return;
    }

    listElement.innerHTML = previewEvents.map((event) => {
      const dateValue = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
      const detailPath = eventDetailPath(event);
      const title = getDisplayEventTitle(getEventTitle(event));
      const place = getEventField(event, 'kraj', ['place', 'city', 'location']);
      return `<li><span>${escapeHtml(formatDateBadge(dateValue))}</span><strong><a href="${escapeHtml(detailPath)}">${escapeHtml(title)}</a></strong>${renderSavedRaceButton(event, title, dateValue, place, true)}</li>`;
    }).join('');
    initSavedRaceButtons(listElement);
  };

  type DeadlineType = 'early' | 'registration';
  type DeadlineCandidate = {
    event: ApiRecord;
    additional: ApiRecord;
    deadlineDate: string;
    deadlineValue: number;
    deadlineType: DeadlineType;
    deadlineWindowRank: number;
    eventDateValue: number;
    title: string;
  };

  const deadlineDateFormatter = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: LJUBLJANA_TIME_ZONE });

  const trimmedValue = (value: unknown) => String(value || '').trim();

  const joinKey = (value: unknown) => trimmedValue(value);

  const getAdditionalField = (item: ApiRecord, key: string) => getFieldValue(item, key);

  const formatDeadlineDate = (value: string) => {
    const dateValue = parseIsoDateValue(value);
    return Number.isFinite(dateValue) ? deadlineDateFormatter.format(new Date(dateValue)) : '';
  };

  const isTodayValue = (value: number) => value === todayStartValue();

  const formatDeadlineLabel = (item: DeadlineCandidate, deadlineDate: string) => {
    if (isTodayValue(item.deadlineValue)) {
      return item.deadlineType === 'early' ? 'Cheaper entry ends today' : 'Registration deadline is today';
    }

    return item.deadlineType === 'early' ? `Cheaper entry until ${deadlineDate}` : `Registration deadline ${deadlineDate}`;
  };

  const formatDeadlineBadge = (item: DeadlineCandidate, deadlineDate: string) =>
    isTodayValue(item.deadlineValue) ? 'Today' : deadlineDate;

  const isConfirmedPublicUpcomingEvent = (event: ApiRecord, todayValue: number) => {
    const date = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
    const dateValue = parseIsoDateValue(date);

    return (
      Boolean(joinKey(event.row)) &&
      Number.isFinite(dateValue) &&
      dateValue >= todayValue &&
      normalize(getEventField(event, 'status_dogodka')) === 'potrjeno' &&
      getEventField(event, 'vidno_v_javnem_koledarju').toLocaleUpperCase('sl-SI') === 'DA' &&
      Boolean(getEventTitle(event, ''))
    );
  };

  const hasHighReliability = (additional: ApiRecord) =>
    getAdditionalField(additional, 'zanesljivost').trim().toLocaleLowerCase('sl-SI') === 'visoka';

  const upcomingDeadlineFor = (additional: ApiRecord, todayValue: number) => {
    const earlyDeadline = getAdditionalField(additional, 'rok_cenejse_prijave');
    const earlyDeadlineValue = parseIsoDateValue(earlyDeadline);
    if (Number.isFinite(earlyDeadlineValue) && earlyDeadlineValue >= todayValue) {
      return { date: earlyDeadline, value: earlyDeadlineValue, type: 'early' as const };
    }

    const registrationDeadline = getAdditionalField(additional, 'rok_prijave');
    const registrationDeadlineValue = parseIsoDateValue(registrationDeadline);
    if (Number.isFinite(registrationDeadlineValue) && registrationDeadlineValue >= todayValue) {
      return { date: registrationDeadline, value: registrationDeadlineValue, type: 'registration' as const };
    }

    return null;
  };

  const parseMoneyAmount = (value: unknown) => {
    const rawValue = String(value ?? '').trim();
    const normalizedValue = rawValue.replace(',', '.').replace(/[^\d.-]/g, '');
    if (!normalizedValue) return null;
    const amount = Number(normalizedValue);
    return Number.isFinite(amount) ? amount : null;
  };

  const formatDeadlinePrice = (additional: ApiRecord) => {
    const min = parseMoneyAmount(getAdditionalField(additional, 'prijavnina_min_eur'));
    const max = parseMoneyAmount(getAdditionalField(additional, 'prijavnina_max_eur'));
    if (min === null || max === null) return '';
    const formatAmount = (amount: number) => new Intl.NumberFormat('en-GB', { maximumFractionDigits: 2 }).format(amount);
    return min === max ? `€${formatAmount(min)}` : `€${formatAmount(min)}–${formatAmount(max)}`;
  };

  const buildDeadlineCandidates = (masterPayload: unknown, additionalPayload: unknown) => {
    const todayValue = todayStartValue();
    const deadlineWindowEndValue = daysFromToday(14);
    const masterEventsByRow = new Map<string, ApiRecord>();

    for (const event of toArray(masterPayload)) {
      if (!isConfirmedPublicUpcomingEvent(event, todayValue)) continue;
      const key = joinKey(event.row);
      if (key && !masterEventsByRow.has(key)) masterEventsByRow.set(key, event);
    }

    const seenEventRows = new Set<string>();
    const candidates: DeadlineCandidate[] = [];

    for (const additional of toArray(additionalPayload)) {
      if (!hasHighReliability(additional)) continue;

      const key = joinKey(additional.master_row);
      if (!key || seenEventRows.has(key)) continue;

      const event = masterEventsByRow.get(key);
      if (!event) continue;

      const deadline = upcomingDeadlineFor(additional, todayValue);
      if (!deadline) continue;

      const eventDate = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
      const eventDateValue = parseIsoDateValue(eventDate);
      if (!Number.isFinite(eventDateValue)) continue;

      seenEventRows.add(key);
      candidates.push({
        event,
        additional,
        deadlineDate: deadline.date,
        deadlineValue: deadline.value,
        deadlineType: deadline.type,
        deadlineWindowRank: deadline.value <= deadlineWindowEndValue ? 0 : 1,
        eventDateValue,
        title: getDisplayEventTitle(getEventTitle(event))
      });
    }

    return candidates
      .sort((a, b) =>
        a.deadlineWindowRank - b.deadlineWindowRank ||
        a.deadlineValue - b.deadlineValue ||
        (a.deadlineType === 'early' ? 0 : 1) - (b.deadlineType === 'early' ? 0 : 1) ||
        a.eventDateValue - b.eventDateValue ||
        a.title.localeCompare(b.title, 'sl-SI')
      )
      .slice(0, 3);
  };

  const renderRegistrationDeadlineItems = (items: DeadlineCandidate[]) => items.map((item) => {
    const deadlineDate = formatDeadlineDate(item.deadlineDate);
    const deadlineBadge = formatDeadlineBadge(item, deadlineDate);
    const label = formatDeadlineLabel(item, deadlineDate);
    const price = formatDeadlinePrice(item.additional);

    return `
      <li class="registration-deadlines-item">
        <div class="registration-deadlines-line">
          <time datetime="${escapeHtml(item.deadlineDate)}">${escapeHtml(deadlineBadge)}</time>
          <span aria-hidden="true">·</span>
          <strong>${escapeHtml(item.title)}</strong>
          ${price ? `<span class="registration-price-chip">${escapeHtml(price)}</span>` : ''}
        </div>
        <p>${escapeHtml(label)}</p>
      </li>
    `;
  }).join('');

  async function loadRegistrationDeadlines() {
    const section = document.querySelector<HTMLElement>('[data-registration-deadlines-section]');
    const list = document.querySelector<HTMLElement>('[data-registration-deadlines]');
    if (!section || !list) return;

    section.hidden = true;
    list.innerHTML = '';

    try {
      const [masterPayload, additionalPayload] = await Promise.all([
        loadJson('/'),
        loadJson('/additional')
      ]);
      const deadlineEvents = buildDeadlineCandidates(masterPayload, additionalPayload);

      if (!deadlineEvents.length) return;

      list.innerHTML = renderRegistrationDeadlineItems(deadlineEvents);
      section.hidden = false;
    } catch (error) {
      section.hidden = true;
      list.innerHTML = '';
    }
  }

  const apiRequestCache = new Map<string, Promise<unknown>>();

  async function getMasterRaceRows() {
    const payload = await loadJson('/');
    const rows = getMasterRows(payload);
    setDebug('master', 'yes');
    setDebug('master-count', String(rows.length));
    return rows;
  }

  async function loadJson(path: string): Promise<unknown> {
    if (!apiRequestCache.has(path)) {
      apiRequestCache.set(path, fetch(`${API_BASE}${path}`, { headers: { accept: 'application/json' } }).then((response) => {
        if (!response.ok) throw new Error(`API request failed: ${response.status}`);
        return response.json();
      }));
    }

    return apiRequestCache.get(path)!;
  }


  async function loadNearestEvents() {
    const container = document.querySelector('[data-nearest-events]');
    if (!container) return;

    try {
      const payload = await loadJson('/');
      const todayValue = todayStartValue();
      const events = toArray(payload)
        .filter((event) => isConfirmedPublicUpcomingEvent(event, todayValue))
        .sort((a, b) => {
          const dateDifference = (eventDateValue(a) ?? Number.POSITIVE_INFINITY) - (eventDateValue(b) ?? Number.POSITIVE_INFINITY);
          if (dateDifference !== 0) return dateDifference;

          const placeDifference = getEventField(a, 'kraj', ['place', 'city', 'location']).localeCompare(getEventField(b, 'kraj', ['place', 'city', 'location']), 'sl-SI');
          if (placeDifference !== 0) return placeDifference;

          return getEventTitle(a).localeCompare(getEventTitle(b), 'sl-SI');
        });
      const interestPreviewEvents = await getInterestPreviewRaces(events, 20).catch(() => []);
      renderHeroPreview(interestPreviewEvents, events);
      const visibleEvents = events.slice(0, 4);

      if (!events.length) {
        container.innerHTML = `
          <article class="event-card">
            <h3>No upcoming races are shown right now</h3>
            <p>Open the race search for a wider calendar overview.</p>
            <div class="event-meta">
              <a class="pill" href="/en/find-races/">View all races</a>
            </div>
          </article>
        `;
        setStatus('nearest', 'No confirmed upcoming public races are shown right now.');
        return;
      }

      const eventCards = visibleEvents.map((event) => {
        const sourceTitle = getEventTitle(event);
        const title = getDisplayEventTitle(sourceTitle);
        const dateValue = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
        const date = formatDate(dateValue);
        const location = getEventField(event, 'kraj', ['place', 'city', 'location']);
        const region = getEventField(event, 'regija', ['region']);
        const analyticsEventId = getEventStableId(event, title, dateValue, location);
        const noticeUrl = safeUrl(getEventField(event, 'povezava_razpis', ['notice_url', 'razpis_url']));
        const registrationUrl = safeUrl(getEventField(event, 'povezava_prijava', ['registration_url', 'prijava_url']));
        const calendarOptions = renderCalendarOptions({ title, date: dateValue, location, noticeUrl, registrationUrl });
        const summary = joinParts([location, region]);
        const links = [
          ...buildPrimaryActions({ registrationUrl, noticeUrl }, 'en').map(renderPrimaryActionLink),
          calendarOptions,
          renderSavedRaceButton(event, title, dateValue, location)
        ].filter(Boolean).join('');

        return `
          <article class="event-card" data-analytics-placement="home_this_week" data-analytics-event-id="${escapeHtml(analyticsEventId)}" data-analytics-event-name="${escapeHtml(title)}" data-analytics-event-date="${escapeHtml(dateValue)}" data-analytics-event-year="2026">
            <div class="event-card-heading">
              <time class="event-card-date" datetime="${escapeHtml(dateValue)}" aria-label="${escapeHtml(date)}">${escapeHtml(formatDateBadge(dateValue))}</time>
              <h3>${escapeHtml(title)}</h3>
            </div>
            ${summary ? `<p>${escapeHtml(summary)}</p>` : ''}
            ${links ? `<div class="event-actions">${links}</div>` : ''}
          </article>
        `;
      }).join('');

      container.innerHTML = eventCards;
      initSavedRaceButtons(container);
      setStatus('nearest', '');
    } catch (error) {
      container.innerHTML = `
        <article class="event-card">
          <h3>The list is currently unavailable</h3>
          <p>Upcoming races will appear here when the data is available again.</p>
        </article>
      `;
      setStatus('nearest', 'The upcoming race list is currently unavailable, so a fallback view is shown.');
    }
  }

  async function loadStats() {
    try {
      const [statsResult, groupRunsResult] = await Promise.allSettled([
        loadJson('/stats'),
        loadJson('/group-runs')
      ]);
      const statsPayload = statsResult.status === 'fulfilled' ? statsResult.value : null;
      const groupRunsPayload = groupRunsResult.status === 'fulfilled' ? groupRunsResult.value : null;
      const confirmedTotal = pickNestedNumber(statsPayload, ['confirmed_public_events_total']);
      const familyTotal = pickNestedNumber(statsPayload, ['family_friendly_total']);
      const groupRunsTotal = pickNestedNumber(groupRunsPayload, ['row_count', 'group_runs_total', 'total', 'count']);
      const values = {
        confirmed_public_events_total: confirmedTotal,
        family_friendly_total: familyTotal,
        group_runs_total: groupRunsTotal
      };

      for (const [key, value] of Object.entries(values)) {
        const element = document.querySelector(`[data-stat="${key}"]`);
        if (element) {
          element.textContent = value === null ? 'No data' : numberFormatter.format(value);
        }
      }

      setDebug('stats', `yes (${confirmedTotal !== null ? 'confirmed ok' : 'confirmed missing'}, ${familyTotal !== null ? 'family ok' : 'family missing'}, ${groupRunsTotal !== null ? 'group runs ok' : 'group runs missing'})`);

      if (confirmedTotal !== null && familyTotal !== null && groupRunsTotal !== null) {
        setStatus('stats', '');
      } else {
        setStatus('stats', 'One or more statistic values are currently missing.');
      }
    } catch (error) {
      setDebug('stats', 'no');
      setStatus('stats', 'Statistics are currently unavailable, so the basic view is shown.');
    }
  }

  async function loadTopEvents() {
    const container = document.querySelector('[data-top-events]');
    const description = document.querySelector('[data-top-description]');
    if (!container) return;

    const renderEvents = (events: ApiRecord[], options: { interestPreview: boolean }) => {
      container.innerHTML = events.map((event) => {
        const title = titleForEvent(event);
        const location = pickPath(event, ['kraj', 'event.kraj', 'race.kraj', 'data.kraj', 'location', 'place', 'city', 'regija', 'Regija'], 'Slovenia');
        const region = pickPath(event, ['regija', 'event.regija', 'race.regija', 'data.regija', 'region'], '');
        const dateValue = pickPath(event, ['datum', 'event.datum', 'race.datum', 'data.datum', 'date', 'event_date', 'Datum']);
        const date = formatDate(dateValue);
        const analyticsEventId = getEventStableId(event, title, dateValue, location);
        const votes = getTopEventVotes(event);
        const meta = joinParts([location, region && region !== location ? region : '']);
        const metaItems = options.interestPreview
          ? ''
          : [
              votes !== null
                ? `<span class="event-chip pill-orange">${escapeHtml(formatVoteCount(votes))}</span>`
                : '<span class="event-chip pill-orange">Voting open</span>'
            ].filter(Boolean).join('');

        return `
          <article class="event-card" data-analytics-placement="home_interest" data-analytics-event-id="${escapeHtml(analyticsEventId)}" data-analytics-event-name="${escapeHtml(title)}" data-analytics-event-date="${escapeHtml(dateValue)}" data-analytics-event-year="${escapeHtml(getEventYear(event))}">
            <div class="event-card-heading">
              <time class="event-card-date" datetime="${escapeHtml(dateValue)}" aria-label="${escapeHtml(date)}">${escapeHtml(formatDateBadge(dateValue))}</time>
              <h3><a href="${escapeHtml(eventDetailPath(event))}">${escapeHtml(title)}</a></h3>
            </div>
            ${meta ? `<p>${escapeHtml(meta)}</p>` : ''}
            ${metaItems ? `<div class="event-details">${metaItems}</div>` : ''}
            ${renderSavedRaceButton(event, title, dateValue, location) ? `<div class="event-actions">${renderSavedRaceButton(event, title, dateValue, location)}</div>` : ''}
          </article>
        `;
      }).join('');
    };

    try {
      const masterRows = await getMasterRaceRows();
      const interestEvents = await getInterestPreviewRaces(masterRows, 5);
      if (interestEvents.length) {
        setDebug('top', 'yes');
        setDebugTopDetails(interestEvents, interestEvents);
        renderEvents(interestEvents, { interestPreview: true });
        initSavedRaceButtons(container);
        if (description) description.textContent = 'Upcoming races attracting the most visitor interest in registration, official information, calendar and route links.';
        setStatus('top', 'The selection is based on visitor interest in registration, official information, calendar and route links.');
        return;
      }
    } catch (error) {
      if (import.meta.env.DEV) console.warn('STK interest preview unavailable, falling back to voted races.', error);
    }

    try {
      const topUpcomingResult = await getTopUpcomingRaces();
      const topEvents = topUpcomingResult.events.slice(0, 5);
      const rawTopEvents = topUpcomingResult.rawEvents.slice(0, 5);
      setDebug('top', 'yes');
      if (!topEvents.length) {
        setDebugTopDetails(topEvents, rawTopEvents);
        setStatus('top', 'No races attracting interest are shown right now.');
        return;
      }

      setDebugTopDetails(topEvents, rawTopEvents);
      renderEvents(topEvents, { interestPreview: false });
      initSavedRaceButtons(container);
      if (description) description.textContent = 'Upcoming races with the most runner votes.';
      setStatus('top', 'This view is based on runner votes. If vote counts are tied, nearer upcoming races are shown first.');
    } catch (error) {
      setDebug('top', 'no');
      setStatus('top', 'The list is currently unavailable.');
    }
  }

  async function loadRecentUpdates() {
    const container = document.querySelector('[data-recent-updates]');
    if (!container) return;

    try {
      const payload = await loadJson('/recent_updates?days=7&limit=20');
      const { updatedEvents, newEvents, confirmedEvents } = getRecentUpdateGroups(payload);
      const updates = [
        ...updatedEvents,
        ...newEvents,
        ...confirmedEvents
      ].slice(0, 20);
      setDebug('recent', 'yes');
      setDebugRecentDetails(updates);

      if (!updatedEvents.length && !newEvents.length && !confirmedEvents.length) {
        container.innerHTML = `
          <article class="update-card">
            <p>There were no new public calendar updates in the last 7 days.</p>
          </article>
        `;
        setStatus('updates', '');
        return;
      }

      container.innerHTML = updates.map((update) => {
        const title = pickPath(update, [
          'naziv_prireditve',
          'naziv',
          'event.naziv_prireditve',
          'event.naziv',
          'title',
          'name'
        ], 'Calendar update');
        const eventDate = formatDate(pickPath(update, ['datum', 'event.datum', 'date', 'event_date', 'Datum']));
        const recentUpdateDate = formatDate(pickPath(update, ['recent_update_date', 'event.recent_update_date']));
        const updateDateMeta = recentUpdateDate
          ? joinParts([`Updated ${recentUpdateDate}`, eventDate ? `event ${eventDate}` : ''])
          : eventDate;
        const changed = getRecentUpdateDescription(pickPath(update, ['zadnja_sprememba', 'event.zadnja_sprememba']));
        const location = pickPath(update, ['kraj', 'event.kraj', 'place', 'city', 'location'], '');
        const region = pickPath(update, ['regija', 'event.regija', 'region'], '');
        const place = joinParts([location, region && region !== location ? region : '']);

        return `
          <article class="update-card">
            ${updateDateMeta ? `<p class="update-meta">${escapeHtml(updateDateMeta)}</p>` : ''}
            <h3>${escapeHtml(title)}</h3>
            ${place ? `<p>${escapeHtml(place)}</p>` : ''}
            ${changed ? `<p>${escapeHtml(changed)}</p>` : ''}
          </article>
        `;
      }).join('');
      setStatus('updates', '');
    } catch (error) {
      setDebug('recent', 'no');
      setStatus('updates', 'Latest updates are currently unavailable, so the fallback view remains.');
    }
  }

  if (enableApiDebug) createDebugPanel();
  loadStats();
  loadNearestEvents();
  loadRegistrationDeadlines();
  loadTopEvents();
  loadRecentUpdates();
</script>
