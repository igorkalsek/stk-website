---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Moji teki | Slovenski Tekaški Koledar" description="Seznam tekov, ki ste jih shranili v tem brskalniku." languageSwitchHref="/en/my-races/">
  <main class="page-section my-races-page">
    <div class="container narrow-container">
      <h1>Moji teki</h1>
      <p class="lead">Tu so zbrani teki, ki ste jih shranili med brskanjem po koledarju.</p>
      <div class="my-races-tabs" role="tablist" aria-label="Pogledi Mojih tekov">
        <button id="my-races-plan-tab" type="button" role="tab" aria-controls="my-races-plan-panel" aria-selected="true" data-my-races-tab="plan">Načrt</button>
        <button id="my-races-season-tab" type="button" role="tab" aria-controls="my-races-season-panel" aria-selected="false" data-my-races-tab="season">Moja sezona</button>
      </div>
      <div id="my-races-plan-panel" role="tabpanel" aria-labelledby="my-races-plan-tab" data-my-races-panel="plan"><div data-my-races-app data-language="sl" class="my-races-app" aria-live="polite"></div></div>
      <div id="my-races-season-panel" role="tabpanel" aria-labelledby="my-races-season-tab" data-my-races-panel="season" hidden><div data-my-season-app class="my-season-app" aria-live="polite"></div></div>
    </div>
  </main>
</BaseLayout>

<script>
  import { initMyRacesPage, initMyRacesTabs } from '../my-races-client';
  initMyRacesTabs();
  initMyRacesPage();
</script>
