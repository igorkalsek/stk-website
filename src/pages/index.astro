---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<BaseLayout
  alternateLinks={[
    { lang: 'sl', href: '/' },
    { lang: 'en', href: '/en/' }
  ]}
  description="Neodvisen in redno posodobljen tekaški koledar za Slovenijo s potrjenimi prireditvami, razpisi, prijavami, družinam prijaznimi teki, skupinskimi teki in dodatnimi informacijami."
>
  <main>
    <section class="hero container" aria-labelledby="hero-title">
      <div class="home-hero-card hero-card">
        <div class="home-hero-main">
          <div class="home-hero-copy hero-content">
            <div class="home-hero-brand">
              <img class="home-hero-logo" src="/stk-logo.jpeg" alt="" aria-hidden="true" />
              <div>
                <span class="home-hero-brand-name">Slovenski Tekaški Koledar</span>
                <span class="home-hero-brand-note">Neodvisen tekaški vodič za Slovenijo</span>
              </div>
            </div>
            <h1 id="hero-title">Poiščite svoj naslednji tek v Sloveniji</h1>
            <p class="hero-lead">Potrjene tekaške prireditve, prijave, razpisi in koristni podatki na enem mestu.</p>
            <p class="hero-sublead">
              Iščite po datumu, regiji, podlagi ali razdalji ter zanimive teke shranite med Moje teke.
            </p>
            <div class="home-hero-actions hero-actions" aria-label="Glavne povezave">
              <a class="button button-primary hero-primary-cta" href="/iskalnik-tekov/">Poiščite tek</a>
              <a class="button button-secondary hero-secondary-cta" href="/moji-teki/">Moji teki</a>
              <a class="home-hero-text-link" href="/stk-tekobot/">Vprašajte Tekobota</a>
            </div>
          </div>
          <aside class="hero-preview" aria-label="Predogled koledarja">
            <div class="hero-preview-heading">
              <span class="hero-preview-kicker" data-hero-preview-title>Izpostavljeno v naslednjih dneh</span>
              <p class="hero-preview-helper" data-hero-preview-helper>Izbor prihodnjih tekov.</p>
            </div>
            <ol class="hero-preview-list" data-hero-preview-list>
              <li><span>nalagamo</span><strong>Prihajajoči teki bodo prikazani tukaj.</strong></li>
            </ol>
          </aside>
        </div>
      </div>

      <div class="home-entry-grid" aria-label="Glavne možnosti">
        <article class="home-entry-card">
          <div class="home-entry-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" focusable="false"><circle cx="14" cy="14" r="7"/><path d="m20 20 6 6"/></svg>
          </div>
          <h2>Najdite pravi tek</h2>
          <p>Filtrirajte po datumu, regiji, podlagi ali razdalji.</p>
          <a class="home-entry-link" href="/iskalnik-tekov/">Odprite iskalnik</a>
        </article>
        <article class="home-entry-card">
          <div class="home-entry-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" focusable="false"><rect x="7" y="8" width="18" height="18" rx="3"/><path d="M11 5v6M21 5v6M7 14h18M16 18l1.5 3 3.5.5-2.5 2.4.6 3.4-3.1-1.6-3.1 1.6.6-3.4-2.5-2.4 3.5-.5z"/></svg>
          </div>
          <h2>Načrtujte svoje teke</h2>
          <p>Shranite teke in spremljajte prijavne roke.</p>
          <a class="home-entry-link" href="/moji-teki/">Odprite Moje teke</a>
        </article>
        <article class="home-entry-card">
          <div class="home-entry-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" focusable="false"><rect x="6" y="9" width="20" height="15" rx="5"/><path d="M12 24l-4 4v-6M12 16h.01M20 16h.01M12 20h8M16 6v3"/></svg>
          </div>
          <h2>Vprašajte Tekobota</h2>
          <p>Poiščite tek z vprašanjem.</p>
          <a class="home-entry-link" href="/stk-tekobot/">Odprite Tekobota</a>
        </article>
      </div>

    </section>

    <section class="section container home-current-sections" aria-labelledby="current-title">
      <div class="section-heading home-current-heading">
        <span class="eyebrow">Na enem mestu</span>
        <h2 id="current-title">Aktualno</h2>
      </div>
      <div class="home-current-layout">
      <section class="registration-deadlines-section" aria-labelledby="registration-deadlines-title" data-registration-deadlines-section hidden>
        <article class="registration-deadlines-card">
          <div class="registration-deadlines-heading">
            <div>
              <h2 id="registration-deadlines-title">Prijave se iztekajo</h2>
              <p>Roki prijav in cenejših prijavnin za prihajajoče teke.</p>
            </div>
          </div>
          <ol class="registration-deadlines-list" data-registration-deadlines></ol>
          <a class="registration-deadlines-cta" href="/iskalnik-tekov/">Poglej vse roke v iskalniku</a>
        </article>
      </section>

      <section class="home-primary-section" aria-labelledby="nearest-title">
        <div class="section-heading section-heading-with-action">
          <div>
            <h2 id="nearest-title">Naslednji teki</h2>
            <p>Najbližje potrjene tekaške prireditve iz Slovenskega Tekaškega Koledarja.</p>
          </div>
          <a class="button button-secondary-light" href="/iskalnik-tekov/">Poglejte vse teke</a>
        </div>
        <div class="card-grid" data-nearest-events>
          <article class="event-card">
            <h3>Podatke še nalagamo</h3>
            <p>Najbližji teki bodo prikazani tukaj.</p>
            <div class="event-meta">
              <span class="pill">Koledar</span>
            </div>
          </article>
        </div>
        <p class="data-note nearest-search-note">Za prijavnine, prijave na dan, trase in višinske metre odprite <a href="/iskalnik-tekov/">iskalnik tekov</a>.</p>
      </section>

      </div>
    </section>

    <section class="container home-calendar-stats" aria-labelledby="calendar-stats-title">
      <div class="stats-intro">
        <h2 id="calendar-stats-title">Koledar 2026 v številkah</h2>
        <p>Podatki zajemajo celoten javni koledar od januarja do decembra 2026.</p>
      </div>
      <div class="home-stats-band stats-strip" aria-label="Statistika koledarja">
        <article class="stat-card stat-card-races">
          <span class="stat-mark" aria-hidden="true"></span>
          <span class="stat-value" data-stat="confirmed_public_events_total">…</span>
          <span class="stat-label">potrjenih prireditev</span>
        </article>
        <article class="stat-card stat-card-family">
          <span class="stat-mark" aria-hidden="true"></span>
          <span class="stat-value" data-stat="family_friendly_total">…</span>
          <span class="stat-label">družinam prijaznih prireditev</span>
        </article>
        <article class="stat-card stat-card-group">
          <span class="stat-mark" aria-hidden="true"></span>
          <span class="stat-value" data-stat="group_runs_total">…</span>
          <span class="stat-label">skupinskih tekov</span>
        </article>
      </div>
    </section>

      <section class="section container home-secondary-section" aria-labelledby="voted-title">
        <div class="section-heading section-heading-with-action">
          <div>
            <h2 id="voted-title">Največ zanimanja</h2>
            <p data-top-description>Izbor prihodnjih tekov.</p>
          </div>
          <div class="section-heading-actions">
            <a class="button button-secondary-light" href="/iskalnik-tekov/">Poglejte vse teke</a>
          </div>
        </div>
        <div class="card-grid" data-top-events>
          <article class="event-card">
            <h3>Podatke še nalagamo</h3>
            <p>Izbrani prihodnji teki bodo prikazani tukaj.</p>
            <div class="event-meta">
              <span class="pill">Prihajajoči teki</span>
            </div>
          </article>
        </div>
        <p class="data-note" data-status="top">Izbor prihodnjih tekov.</p>
      </section>

    <section class="section container home-trust-updates" aria-labelledby="trust-updates-title">
      <div class="section-heading">
        <h2 id="trust-updates-title">Zanesljivi podatki, ki se redno posodabljajo</h2>
      </div>
      <div class="home-trust-updates-grid">
        <article class="home-trust-panel" aria-labelledby="trust-title">
          <span class="eyebrow eyebrow-light">Zakaj STK</span>
          <h3 id="trust-title">Potrjene informacije za lažje načrtovanje</h3>
          <p>STK na enem mestu združuje potrjene tekaške dogodke, uradne povezave do razpisov in prijav ter praktične podatke za načrtovanje nastopa.</p>
          <ul class="home-trust-benefits">
            <li>Potrjeni javni dogodki</li>
            <li>Povezave do uradnih razpisov in prijav</li>
            <li>Redno pregledani in posodobljeni podatki</li>
            <li>Neodvisen pregled tekaških prireditev po Sloveniji</li>
          </ul>
          <div class="feature-chip-list home-trust-chips" aria-label="Dodatni podatki v iskalniku">
            <span class="feature-chip">Startnine</span>
            <span class="feature-chip">Roki prijav</span>
            <span class="feature-chip">Višinski metri</span>
            <span class="feature-chip">Trase / GPX</span>
            <span class="feature-chip">Otroški teki</span>
          </div>
          <div class="home-trust-actions">
            <a class="button button-primary" href="/iskalnik-tekov/">Odprite iskalnik</a>
            <a class="button button-secondary-light" href="/o-projektu-in-zasebnost/">O projektu in zasebnosti</a>
          </div>
        </article>
        <article class="home-update-panel" aria-labelledby="updates-title">
          <div class="home-update-heading">
            <span class="eyebrow eyebrow-light">Zadnje posodobitve</span>
            <h3 id="updates-title">Sveže spremembe v koledarju</h3>
            <p>Najnovejše spremembe pomagajo hitro preveriti, kaj je bilo dodano ali popravljeno.</p>
          </div>
          <div class="card-grid" data-recent-updates>
            <article class="update-card">
              <h3>Podatke še nalagamo</h3>
              <p>Zadnje spremembe se bodo prikazale tukaj.</p>
            </article>
          </div>
        </article>
      </div>
    </section>

    <section class="section container home-utility-section" aria-labelledby="utility-title">
      <div class="section-heading">
        <h2 id="utility-title">Še več možnosti</h2>
      </div>
      <div class="home-utility-grid">
        <article class="home-utility-card">
          <span class="home-utility-mark" aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false"><rect x="7" y="8" width="18" height="18" rx="3"/><path d="M11 5v6M21 5v6M7 14h18M12 19h8M12 23h5"/></svg></span>
          <h3>Osebni koledar</h3>
          <p>Dodajte tekaške dogodke med druge obveznosti v svojem koledarju.</p>
          <a class="home-utility-link" href="/osebni-koledar/">Navodila za osebni koledar</a>
        </article>
        <article class="home-utility-card">
          <span class="home-utility-mark" aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false"><path d="M16 7v18M7 16h18"/><circle cx="16" cy="16" r="11"/></svg></span>
          <h3>Za organizatorje</h3>
          <p>Dodajte nov tek ali pošljite popravek že objavljenih podatkov.</p>
          <a class="home-utility-link" href="/dodaj-ali-popravi-tek/">Dodajte ali popravite tek</a>
        </article>
        <article class="home-utility-card">
          <span class="home-utility-mark" aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false"><path d="M7 23c4-5 9-8 18-8M19 9l6 6-6 6"/><circle cx="10" cy="11" r="3"/></svg></span>
          <h3 id="social-cta-title">Spremljajte STK</h3>
          <p>Tedenske napovedi, novi teki in pomembne posodobitve koledarja.</p>
          <SocialLinks lang="sl" labelledby="social-cta-title" />
        </article>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  import { buildGoogleCalendarEventUrl, buildIcsDataUrl, buildIcsFilename, buildOutlookCalendarEventUrl } from '../utils-calendar';
  import { buildPrimaryActions } from '../utils-race-detail-view';
  import { renderActionIcon } from '../utils-action-icons';
  import { buildEventDetailPath, getStableEventId } from '../utils-event-detail';
  import { initSavedRaceButtons } from '../saved-races-client';
  import { getDisplayEventTitle } from '../utils-events';
  import { formatSloveneDateBadge, formatSloveneVoteCount } from '../utils-slovenian';
  import { buildHomepageMasterEventIndex, matchRecentUpdateToMasterEvent, buildHomepageEventDetailPath } from '../utils-home-events';

  type ApiRecord = Record<string, unknown>;

  const API_BASE = 'https://stk-master-api.igor-kalsek.workers.dev';
  const INTEREST_PREVIEW_URL = '/api/interest-preview';
  const numberFormatter = new Intl.NumberFormat('sl-SI');
  const dateFormatter = new Intl.DateTimeFormat('sl-SI', { day: 'numeric', month: 'short', year: 'numeric' });

  const ARRAY_KEYS = ['events', 'next_week', 'updates', 'recent_updates', 'recent', 'data', 'items', 'rows', 'changes', 'results'];
  const STATS_CONTAINERS = ['stats', 'totals', 'summary', 'data', 'counts'];
  const TITLE_CONTAINERS = ['event', 'race', 'data', 'item', 'row', 'fields'];
  const isPreviewHost = window.location.hostname.endsWith('.pages.dev');
  const enableApiDebug = import.meta.env.DEV || isPreviewHost;
  const debugEnabled = enableApiDebug && new URLSearchParams(window.location.search).get('debug') === '1';

  const setStatus = (name: string, message: string) => {
    const element = document.querySelector(`[data-status="${name}"]`);
    if (element) element.textContent = message;
  };

  const asRecord = (value: unknown): ApiRecord | null =>
    value && typeof value === 'object' && !Array.isArray(value) ? value as ApiRecord : null;

  const toArray = (payload: unknown): ApiRecord[] => {
    if (Array.isArray(payload)) return payload.filter(asRecord) as ApiRecord[];

    const record = asRecord(payload);
    if (!record) return [];

    for (const key of ARRAY_KEYS) {
      const value = record[key];
      if (Array.isArray(value)) return value.filter(asRecord) as ApiRecord[];
    }

    for (const key of ARRAY_KEYS) {
      const nested = asRecord(record[key]);
      if (!nested) continue;
      const nestedArray = toArray(nested);
      if (nestedArray.length) return nestedArray;
    }

    return [];
  };

  const getRecordArray = (record: ApiRecord | null, key: string): ApiRecord[] => {
    const value = record?.[key];
    return Array.isArray(value) ? value.filter(asRecord) as ApiRecord[] : [];
  };

  const getRecentUpdateGroups = (payload: unknown) => {
    const root = asRecord(payload);
    const recentUpdatesLastDays = asRecord(root?.recent_updates_last_days);
    const source = recentUpdatesLastDays ?? root;

    return {
      updatedEvents: getRecordArray(source, 'updated_events'),
      newEvents: getRecordArray(source, 'new_events'),
      confirmedEvents: getRecordArray(source, 'confirmed_events')
    };
  };

  const pick = (item: ApiRecord, keys: string[], fallback = ''): string => {
    for (const key of keys) {
      const value = item[key];
      if (value !== undefined && value !== null && String(value).trim() !== '') return String(value).trim();
    }
    return fallback;
  };

  const valueAtPath = (item: ApiRecord, path: string): unknown => {
    let current: unknown = item;
    for (const part of path.split('.')) {
      const record = asRecord(current);
      if (!record) return undefined;
      current = record[part];
    }
    return current;
  };

  const pickPath = (item: ApiRecord, paths: string[], fallback = ''): string => {
    for (const path of paths) {
      const value = valueAtPath(item, path);
      if (value !== undefined && value !== null && String(value).trim() !== '') return String(value).trim();
    }
    return fallback;
  };

  const normalizeKey = (key: string) => key.toLowerCase().trim().replace(/[\s_-]+/g, '');

  const getVoteUrlTitle = (item: ApiRecord) => {
    if (typeof item?.vote_url !== 'string' || !item.vote_url.trim()) return '';
    try {
      const url = new URL(item.vote_url);
      return url.searchParams.get('entry.1386641006')?.trim() ?? '';
    } catch (error) {
      const match = item.vote_url.match(/[?&]entry\.1386641006=([^&]+)/);
      return match ? decodeURIComponent(match[1].replace(/\+/g, ' ')).trim() : '';
    }
  };


  const getTopEventTitle = (item: ApiRecord) => {
    if (typeof item?.naziv_prireditve === 'string' && item.naziv_prireditve.trim()) {
      return item.naziv_prireditve.trim();
    }

    if (typeof item?.naziv === 'string' && item.naziv.trim()) {
      return item.naziv.trim();
    }

    if (typeof item?.title === 'string' && item.title.trim()) {
      return item.title.trim();
    }

    if (typeof item?.name === 'string' && item.name.trim()) {
      return item.name.trim();
    }

    const event = asRecord(item?.event);
    if (typeof event?.naziv_prireditve === 'string' && event.naziv_prireditve.trim()) {
      return event.naziv_prireditve.trim();
    }

    if (typeof event?.naziv === 'string' && event.naziv.trim()) {
      return event.naziv.trim();
    }

    const race = asRecord(item?.race);
    if (typeof race?.naziv_prireditve === 'string' && race.naziv_prireditve.trim()) {
      return race.naziv_prireditve.trim();
    }

    if (typeof race?.naziv === 'string' && race.naziv.trim()) {
      return race.naziv.trim();
    }

    const data = asRecord(item?.data);
    if (typeof data?.naziv_prireditve === 'string' && data.naziv_prireditve.trim()) {
      return data.naziv_prireditve.trim();
    }

    if (typeof data?.naziv === 'string' && data.naziv.trim()) {
      return data.naziv.trim();
    }

    const voteUrlTitle = getVoteUrlTitle(item);
    return voteUrlTitle || 'Naziv teka ni na voljo';
  };

  const objectKeys = (value: unknown) => asRecord(value) ? Object.keys(value as ApiRecord) : [];

  const describeKeys = (value: unknown) => {
    const record = asRecord(value);
    if (!record) return '—';
    const entries = Object.entries(record).slice(0, 18).map(([key, entryValue]) => {
      const type = Array.isArray(entryValue) ? 'array' : typeof entryValue;
      return `${key}:${type}`;
    });
    return entries.length ? entries.join(', ') : 'brez ključev';
  };

  const rawValueText = (value: unknown) =>
    value === undefined || value === null || String(value) === '' ? 'not detected' : String(value);

  const compactJsonPreview = (value: unknown) => {
    try {
      return JSON.stringify(value, null, 2).slice(0, 1600);
    } catch (error) {
      return 'JSON preview ni na voljo.';
    }
  };

  const isMissing = (value: unknown) =>
    value === undefined || value === null || String(value).trim() === '';

  const rowKey = (value: unknown) => {
    const record = asRecord(value);
    if (!record) return '';
    const row = record.row ?? record.Row ?? record.ROW ?? record.row_number ?? record.rowNumber;
    return row === undefined || row === null ? '' : String(row).trim();
  };

  const getFieldValue = (item: ApiRecord, key: string) => {
    const exact = item[key];
    if (!isMissing(exact)) return String(exact).trim();

    const wanted = normalizeKey(key);
    for (const [itemKey, value] of Object.entries(item)) {
      if (normalizeKey(itemKey) === wanted && !isMissing(value)) return String(value).trim();
    }

    return '';
  };

  const getMasterRows = (payload: unknown): ApiRecord[] => {
    const record = asRecord(payload);
    if (record && Array.isArray(record.data)) return record.data.filter(asRecord) as ApiRecord[];

    const fallbackRows = toArray(payload);
    if (fallbackRows.length) return fallbackRows;

    if (record) {
      for (const value of Object.values(record)) {
        const rows = toArray(value);
        if (rows.length) return rows;
      }
    }

    return [];
  };

  const normalizedText = (value: unknown) =>
    String(value ?? '')
      .trim()
      .toLowerCase()
      .replace(/[\u2010-\u2015]/g, '-')
      .replace(/\s*-\s*/g, ' - ')
      .replace(/\s+/g, ' ');

  const eventNaturalParts = (event: ApiRecord) => {
    const date = pickPath(event, ['datum', 'event.datum', 'race.datum', 'data.datum', 'date', 'event_date', 'Datum']);
    const title = getDisplayEventTitle(getTopEventTitle(event));
    const place = pickPath(event, ['kraj', 'event.kraj', 'race.kraj', 'data.kraj', 'place', 'city', 'location', 'Kraj']);
    const explicitYear = pickPath(event, ['year', 'event.year', 'race.year', 'data.year', 'leto', 'event.leto'], '');
    const dateYear = date.match(/^(\d{4})-/)?.[1] ?? '';

    return {
      year: /^\d{4}$/.test(explicitYear) ? explicitYear : dateYear || '2026',
      date,
      title,
      place
    };
  };

  const eventNaturalKey = (event: ApiRecord) => {
    const { year, date, title, place } = eventNaturalParts(event);
    return [year, date, title, place]
      .map((part) => normalizedText(part))
      .filter(Boolean)
      .join('|');
  };

  const masterMatchesNaturalEvent = (topEvent: ApiRecord, masterEvent: ApiRecord) => {
    const topParts = eventNaturalParts(topEvent);
    const masterParts = eventNaturalParts(masterEvent);
    if (!normalizedText(topParts.year) || normalizedText(topParts.year) !== normalizedText(masterParts.year)) return false;
    if (!normalizedText(topParts.date) || normalizedText(topParts.date) !== normalizedText(masterParts.date)) return false;
    if (!normalizedText(topParts.title) || normalizedText(topParts.title) !== normalizedText(masterParts.title)) return false;

    const topPlace = normalizedText(topParts.place);
    const masterPlace = normalizedText(masterParts.place);
    return !topPlace || !masterPlace || topPlace === masterPlace;
  };

  const findMasterMatch = (topEvent: ApiRecord, masterRows: ApiRecord[]) =>
    masterRows.find((masterEvent) => masterMatchesNaturalEvent(topEvent, masterEvent)) ?? null;

  const copyIfMissing = (target: ApiRecord, source: ApiRecord, key: string) => {
    if (!isMissing(target[key])) return false;
    const sourceValue = getFieldValue(source, key);
    if (!sourceValue) return false;
    target[key] = sourceValue;
    return true;
  };

  const enrichTopEventsFromMaster = (events: ApiRecord[], masterRows: ApiRecord[]) => events.map((event) => {
    const enriched = { ...event };
    const topTitle = getTopEventTitle(event);
    const voteUrlTitle = getVoteUrlTitle(event);
    const match = findMasterMatch(event, masterRows);
    enriched.__master_matched = Boolean(match);
    enriched.__matched_master_row = match ? rowKey(match) : '';
    enriched.__matched_master_title = match ? getFieldValue(match, 'naziv_prireditve') : '';
    enriched.__canonical_master_event = match ?? undefined;
    enriched.__vote_url_title = voteUrlTitle;
    enriched.__title_source = topTitle !== 'Naziv teka ni na voljo' && topTitle !== voteUrlTitle ? 'top' : 'not detected';

    if (match) {
      const filledTitle = copyIfMissing(enriched, match, 'naziv_prireditve');
      copyIfMissing(enriched, match, 'datum');
      copyIfMissing(enriched, match, 'kraj');
      copyIfMissing(enriched, match, 'regija');
      copyIfMissing(enriched, match, 'tip_podlage');
      copyIfMissing(enriched, match, 'razdalje_km');
      if (filledTitle) enriched.__title_source = 'master';
    }

