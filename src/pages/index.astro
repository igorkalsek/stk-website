    if (!eventId || !/^202[67]$/.test(year)) return '';
    return `<button class="button button-small button-secondary-light saved-race-button${iconOnly ? ' saved-race-icon-button' : ''}" type="button" data-saved-race-button${iconOnly ? ' data-saved-race-icon-only="true" data-saved-race-remove-label="Odstrani iz Mojih tekov"' : ''} data-event-id="${escapeHtml(eventId)}" data-event-year="${escapeHtml(year)}" data-event-date="${escapeHtml(date)}" data-event-title="${escapeHtml(title)}" data-language="sl" aria-pressed="false" aria-label="Shrani tek"><span class="action-icon" aria-hidden="true">☆</span>${iconOnly ? '' : '<span data-saved-race-label>Shrani tek</span>'}</button>`;
  };

  const normalize = (value: string) => value.toLocaleLowerCase('sl-SI').normalize('NFKC');

  const safeUrl = (value: string) => {
    if (!value) return '';
    try {
      const url = new URL(value);
      return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
    } catch {
      return '';
    }
  };


  const renderPrimaryActionLink = (action: ReturnType<typeof buildPrimaryActions>[number]) =>
    `<a class="button button-small ${action.kind === 'registration' ? 'button-primary' : 'button-secondary-light'}" href="${escapeHtml(action.url)}" target="_blank" rel="noopener noreferrer" data-analytics-link-type="${escapeHtml(action.analyticsType)}"><span class="action-icon" aria-hidden="true">${renderActionIcon(action.kind === 'registration' ? 'registration' : 'notice')}</span><span>${escapeHtml(action.label)}</span></a>`;

  const renderCalendarOptions = ({ title, date, location = '', noticeUrl = '', registrationUrl = '' }: {
    title: string;
    date: string;
    location?: string;
    noticeUrl?: string;
    registrationUrl?: string;
  }) => {
    const event = { title, date, location, noticeUrl, registrationUrl };
    const googleUrl = buildGoogleCalendarEventUrl(event);
    const icsUrl = buildIcsDataUrl(event);
    const icsFilename = buildIcsFilename(event);
    const outlookUrl = buildOutlookCalendarEventUrl(event);
    if (!googleUrl && !icsUrl && !outlookUrl) return '';

    const options = [
      googleUrl && `<a href="${escapeHtml(googleUrl)}" target="_blank" rel="noopener noreferrer">Google</a>`,
      icsUrl && `<a href="${escapeHtml(icsUrl)}" download="${escapeHtml(icsFilename)}">Apple / iCal</a>`,
      outlookUrl
        ? `<a href="${escapeHtml(outlookUrl)}" target="_blank" rel="noopener noreferrer">Outlook</a>`
        : icsUrl && `<a href="${escapeHtml(icsUrl)}" download="${escapeHtml(icsFilename)}">Outlook / .ics</a>`
    ].filter(Boolean).join('');

    return `
      <details class="calendar-menu">
        <summary class="button button-small button-secondary-light"><span class="action-icon">${renderActionIcon('calendar')}</span><span>V koledar</span></summary>
        <div class="calendar-menu-options">${options}</div>
      </details>
    `;
  };



  const nestedEventPaths = (field: string) => [
    field,
    `event.${field}`,
    `race.${field}`,
    `data.${field}`,
    `item.${field}`,
    `row.${field}`,
    `fields.${field}`
  ];

  const getEventTitle = (event: ApiRecord, fallback = 'Naziv teka ni na voljo') =>
    pickPath(event, [
      ...nestedEventPaths('naziv_prireditve'),
      ...nestedEventPaths('naziv'),
      ...nestedEventPaths('title'),
      ...nestedEventPaths('name')
    ], fallback);

  const getEventField = (event: ApiRecord, field: string, aliases: string[] = []) =>
    pickPath(event, [
      ...nestedEventPaths(field),
      ...aliases.flatMap(nestedEventPaths)
    ], '');


  const LJUBLJANA_TIME_ZONE = 'Europe/Ljubljana';
  const ljubljanaDatePartsFormatter = new Intl.DateTimeFormat('en-CA', {
    timeZone: LJUBLJANA_TIME_ZONE,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  });

  const parseIsoDateValue = (value: string) => {
    const trimmedDate = value.trim();
    const match = trimmedDate.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!match) return Number.NaN;

    const [, year, month, day] = match;
    const dateValue = Date.UTC(Number(year), Number(month) - 1, Number(day));
    const date = new Date(dateValue);
    if (
      date.getUTCFullYear() !== Number(year) ||
      date.getUTCMonth() !== Number(month) - 1 ||
      date.getUTCDate() !== Number(day)
    ) {
      return Number.NaN;
    }

    return dateValue;
  };

  const todayStartValue = () => {
    const parts = Object.fromEntries(
      ljubljanaDatePartsFormatter.formatToParts(new Date())
        .filter((part) => part.type !== 'literal')
        .map((part) => [part.type, part.value])
    ) as Record<string, string>;

    return parseIsoDateValue(`${parts.year}-${parts.month}-${parts.day}`);
  };

  const daysFromToday = (days: number) => {
    const dateValue = todayStartValue();
    if (!Number.isFinite(dateValue)) return Number.NaN;
    const date = new Date(dateValue);
    date.setUTCDate(date.getUTCDate() + days);
    return date.getTime();
  };

  const eventDateValue = (event: ApiRecord) => {
    const date = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
    const dateValue = parseIsoDateValue(date);
    return Number.isFinite(dateValue) ? dateValue : null;
  };

  const compareEventDateThenTitle = (a: ApiRecord, b: ApiRecord) => {
    const dateDifference = (eventDateValue(a) ?? Number.POSITIVE_INFINITY) - (eventDateValue(b) ?? Number.POSITIVE_INFINITY);
    if (dateDifference !== 0) return dateDifference;

    return getDisplayEventTitle(getEventTitle(a)).localeCompare(getDisplayEventTitle(getEventTitle(b)), 'sl-SI');
  };

  const eventRowKey = (event: ApiRecord) => {
    const matchedMasterRow = pick(event, ['__matched_master_row']);
    if (matchedMasterRow) return matchedMasterRow;

    const row = rowKey(event);
    if (row) return row;

    return pick(event, ['master_row', 'masterRow', 'master row']);
  };

  const getEventYear = (event: ApiRecord) => {
    const explicitYear = getEventField(event, 'year', ['leto']);
    if (/^\d{4}$/.test(explicitYear)) return explicitYear;

    const date = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
    const dateYear = date.match(/^(\d{4})-/)?.[1];
    return dateYear || '2026';
  };

  const detailEventData = (event: ApiRecord) => ({
    year: getEventYear(event),
    row: eventRowKey(event),
    date: getEventField(event, 'datum', ['date', 'event_date', 'Datum']),
    title: getDisplayEventTitle(getEventTitle(event)),
    naziv_prireditve: getEventTitle(event),
    place: getEventField(event, 'kraj', ['place', 'city', 'location', 'Kraj'])
  });

  const canonicalDetailEvent = (event: ApiRecord) => asRecord(event.__canonical_master_event) ?? event;

  const eventDetailPath = (event: ApiRecord) => buildEventDetailPath(detailEventData(canonicalDetailEvent(event)));

  const eventIdentity = (event: ApiRecord) => eventNaturalKey(canonicalDetailEvent(event)) || eventNaturalKey(event) || `row:${eventRowKey(event)}`;


  const normalizeTopUpcomingRace = (event: ApiRecord) => {
    const votes = getTopEventVotes(event);
    return votes !== null ? { ...event, votes_total: votes } : { ...event };
  };

  const getMasterRaceRows = async () => {
    const masterPayload = await loadJson('/');
    const masterRows = getMasterRows(masterPayload);
    setDebug('master', 'yes');
    setDebug('master-count', String(masterRows.length));
    return masterRows;
  };

  const getTopUpcomingRaces = async () => {
    const payload = await loadJson('/top?scope=upcoming&limit=50');
    const rawEvents = toArray(payload);
    let events = rawEvents.map(normalizeTopUpcomingRace);

    try {
      const masterRows = await getMasterRaceRows();
      events = enrichTopEventsFromMaster(events, masterRows).map(normalizeTopUpcomingRace);
    } catch (error) {
      setDebug('master', 'no');
      setDebug('master-count', '0');
    }

    return { events, rawEvents };
  };



  const INTEREST_ID_KEYS = ['event_id', 'eventId', 'id', 'row', 'Row', 'master_row', 'masterRow'];

  const normalizeInterestEventId = (value: unknown) => {
    const rawValue = String(value ?? '').trim();
    if (!rawValue) return '';

    const normalized = rawValue.toLocaleUpperCase('sl-SI').replace(/\s+/g, '');
    const prefixedMatch = normalized.match(/^R0*(\d+)$/);
    const numericMatch = normalized.match(/^0*(\d+)$/);
    const numericPart = prefixedMatch?.[1] ?? numericMatch?.[1];
    if (!numericPart) return '';

    const numberValue = Number.parseInt(numericPart, 10);
    if (!Number.isFinite(numberValue) || numberValue <= 0) return '';
    return `R${String(numberValue).padStart(6, '0')}`;
  };

  const eventIdValue = (event: ApiRecord) => {
    for (const key of INTEREST_ID_KEYS) {
      const value = getEventField(event, key);
      const normalizedId = normalizeInterestEventId(value);
      if (normalizedId) return normalizedId;
    }
    return '';
  };

  const buildUniqueEventIdIndex = (events: ApiRecord[]) => {
    const candidates = new Map<string, ApiRecord[]>();
    for (const event of events) {
      const id = eventIdValue(event);
      if (!id) continue;
      const bucket = candidates.get(id) ?? [];
      bucket.push(event);
      candidates.set(id, bucket);
    }

    const unique = new Map<string, ApiRecord>();
    for (const [id, matches] of candidates.entries()) {
      if (matches.length === 1) unique.set(id, matches[0]);
    }
    return unique;
  };


  const loadInterestPreviewPayload = async () => {
    const response = await fetch(INTEREST_PREVIEW_URL, { headers: { accept: 'application/json' } });
    const payload = await response.json().catch(() => null);
    if (!response.ok) {
      const errorRecord = asRecord(payload);
      const reason = errorRecord?.error ? `: ${String(errorRecord.error)}` : '';
      throw new Error(`Interest preview request failed: ${response.status}${reason}`);
    }
    const record = asRecord(payload);
    if (!record || record.ok !== true || record.type !== 'interest_preview') {
      throw new Error('Interest preview response was not valid.');
    }
    return record;
  };

  const isValidInterestPreviewMasterEvent = (event: ApiRecord, todayValue: number) => {
    if (!isConfirmedPublicUpcomingEvent(event, todayValue)) return false;
    if (getEventYear(event) !== '2026') return false;
    if (!getDisplayEventTitle(getEventTitle(event, '')).trim()) return false;
    if (!getEventField(event, 'datum', ['date', 'event_date', 'Datum'])) return false;
    return Boolean(eventDetailPath(event));
  };

  const getInterestPreviewRaces = async (masterRows: ApiRecord[], displayLimit = 5) => {
    const payload = await loadInterestPreviewPayload();
    const interestItems = getRecordArray(payload, 'items');
    if (!interestItems.length) return [];

    const todayValue = todayStartValue();
    const masterEventsById = buildUniqueEventIdIndex(
      masterRows.filter((event) => isValidInterestPreviewMasterEvent(event, todayValue))
    );
    const selectedIds = new Set<string>();
    const rankedEvents: ApiRecord[] = [];

    for (const item of interestItems) {
      const id = eventIdValue(item);
      if (!id || selectedIds.has(id)) continue;
      const match = masterEventsById.get(id);
      if (!match) continue;
      selectedIds.add(id);
      rankedEvents.push({ ...match, __interest_preview_ranked: true });
      if (rankedEvents.length >= displayLimit) break;
    }

    if (debugEnabled) {
      const interestIds = interestItems.map(eventIdValue).filter(Boolean);
      console.warn('STK interest preview match summary', {
        interestItemCount: interestItems.length,
        interestIds,
        uniqueMasterIdCount: masterEventsById.size,
        matchedIds: rankedEvents.map(eventIdValue),
        skippedIds: interestIds.filter((id) => !selectedIds.has(id))
      });
    }

    return rankedEvents;
  };


  const renderHeroPreview = (interestEvents: ApiRecord[], fallbackCandidates: ApiRecord[] = []) => {
    const titleElement = document.querySelector('[data-hero-preview-title]');
    const helperElement = document.querySelector('[data-hero-preview-helper]');
    const listElement = document.querySelector('[data-hero-preview-list]');
    if (!listElement) return;

    const todayValue = todayStartValue();
    const cutoffValue = daysFromToday(14);
    const selectedIds = new Set<string>();
    const upcomingInterestEvents: ApiRecord[] = [];

    for (const event of interestEvents) {
      if (upcomingInterestEvents.length >= 3) break;
      const dateValue = eventDateValue(event);
      if (dateValue === null || dateValue < todayValue || dateValue > cutoffValue) continue;
      const identity = eventIdentity(event);
      if (identity && selectedIds.has(identity)) continue;
      if (identity) selectedIds.add(identity);
      upcomingInterestEvents.push(event);
    }

    const fallbackEvents: ApiRecord[] = [];
    const nearestFallbackEvents = fallbackCandidates
      .filter((event) => {
        const dateValue = eventDateValue(event);
        return dateValue !== null && dateValue >= todayValue;
      })
      .sort(compareEventDateThenTitle);
    for (const event of nearestFallbackEvents) {
      if (upcomingInterestEvents.length + fallbackEvents.length >= 3) break;
      const identity = eventIdentity(event);
      if (identity && selectedIds.has(identity)) continue;
      if (identity) selectedIds.add(identity);
      fallbackEvents.push(event);
    }
    const previewEvents = [...upcomingInterestEvents, ...fallbackEvents].sort(compareEventDateThenTitle);

    if (titleElement) {
      titleElement.textContent = 'Izpostavljeno v naslednjih dneh';
    }
    if (helperElement) {
      helperElement.textContent = 'Izbor prihodnjih tekov.';
    }

    if (!previewEvents.length) {
      listElement.innerHTML = '<li><span>kmalu</span><strong>Prihajajoči teki bodo prikazani tukaj.</strong></li>';
      return;
    }

    listElement.innerHTML = previewEvents.map((event) => {
      const dateValue = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
      const detailPath = eventDetailPath(event);
      const title = getDisplayEventTitle(getEventTitle(event));
      const place = getEventField(event, 'kraj', ['place', 'city', 'location']);
      return `<li><span>${escapeHtml(formatDateBadge(dateValue))}</span><strong><a href="${escapeHtml(detailPath)}">${escapeHtml(title)}</a></strong>${renderSavedRaceButton(event, title, dateValue, place, true)}</li>`;
    }).join('');
    initSavedRaceButtons(listElement);
  };

  type DeadlineType = 'early' | 'registration';
  type DeadlineCandidate = {
    event: ApiRecord;
    additional: ApiRecord;
    deadlineDate: string;
    deadlineValue: number;
    deadlineType: DeadlineType;
    deadlineWindowRank: number;
    eventDateValue: number;
    title: string;
  };

  const deadlineDateFormatter = new Intl.DateTimeFormat('sl-SI', { day: 'numeric', month: 'short', timeZone: LJUBLJANA_TIME_ZONE });

  const trimmedValue = (value: unknown) => String(value || '').trim();

  const joinKey = (value: unknown) => trimmedValue(value);

  const getAdditionalField = (item: ApiRecord, key: string) => getFieldValue(item, key);

  const formatDeadlineDate = (value: string) => {
    const dateValue = parseIsoDateValue(value);
    return Number.isFinite(dateValue) ? deadlineDateFormatter.format(new Date(dateValue)) : '';
  };

  const isTodayValue = (value: number) => value === todayStartValue();

  const formatDeadlineLabel = (item: DeadlineCandidate, deadlineDate: string) => {
    if (isTodayValue(item.deadlineValue)) {
      return item.deadlineType === 'early' ? 'Cenejša prijava se izteče danes' : 'Rok prijave je danes';
    }

    return item.deadlineType === 'early' ? `Cenejša prijava do ${deadlineDate}` : `Rok prijave ${deadlineDate}`;
  };

  const formatDeadlineBadge = (item: DeadlineCandidate, deadlineDate: string) =>
    isTodayValue(item.deadlineValue) ? 'Danes' : deadlineDate;

  const isConfirmedPublicUpcomingEvent = (event: ApiRecord, todayValue: number) => {
    const date = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
    const dateValue = parseIsoDateValue(date);

    return (
      Boolean(joinKey(event.row)) &&
      Number.isFinite(dateValue) &&
      dateValue >= todayValue &&
      normalize(getEventField(event, 'status_dogodka')) === 'potrjeno' &&
      getEventField(event, 'vidno_v_javnem_koledarju').toLocaleUpperCase('sl-SI') === 'DA' &&
      Boolean(getEventTitle(event, ''))
    );
  };

  const hasHighReliability = (additional: ApiRecord) =>
    getAdditionalField(additional, 'zanesljivost').trim().toLocaleLowerCase('sl-SI') === 'visoka';

  const upcomingDeadlineFor = (additional: ApiRecord, todayValue: number) => {
    const earlyDeadline = getAdditionalField(additional, 'rok_cenejse_prijave');
    const earlyDeadlineValue = parseIsoDateValue(earlyDeadline);
    if (Number.isFinite(earlyDeadlineValue) && earlyDeadlineValue >= todayValue) {
      return { date: earlyDeadline, value: earlyDeadlineValue, type: 'early' as const };
    }

    const registrationDeadline = getAdditionalField(additional, 'rok_prijave');
    const registrationDeadlineValue = parseIsoDateValue(registrationDeadline);
    if (Number.isFinite(registrationDeadlineValue) && registrationDeadlineValue >= todayValue) {
      return { date: registrationDeadline, value: registrationDeadlineValue, type: 'registration' as const };
    }

    return null;
  };

  const parseMoneyAmount = (value: unknown) => {
    const rawValue = String(value ?? '').trim();
    const normalizedValue = rawValue.replace(',', '.').replace(/[^\d.-]/g, '');
    if (!normalizedValue) return null;
    const amount = Number(normalizedValue);
    return Number.isFinite(amount) ? amount : null;
  };

  const formatDeadlinePrice = (additional: ApiRecord) => {
    const min = parseMoneyAmount(getAdditionalField(additional, 'prijavnina_min_eur'));
    const max = parseMoneyAmount(getAdditionalField(additional, 'prijavnina_max_eur'));
    if (min === null || max === null) return '';
    const formatAmount = (amount: number) => new Intl.NumberFormat('sl-SI', { maximumFractionDigits: 2 }).format(amount);
    return min === max ? `${formatAmount(min)} €` : `${formatAmount(min)}–${formatAmount(max)} €`;
  };

  const buildDeadlineCandidates = (masterPayload: unknown, additionalPayload: unknown) => {
    const todayValue = todayStartValue();
    const deadlineWindowEndValue = daysFromToday(14);
    const masterEventsByRow = new Map<string, ApiRecord>();

    for (const event of toArray(masterPayload)) {
      if (!isConfirmedPublicUpcomingEvent(event, todayValue)) continue;
      const key = joinKey(event.row);
      if (key && !masterEventsByRow.has(key)) masterEventsByRow.set(key, event);
    }

    const seenEventRows = new Set<string>();
    const candidates: DeadlineCandidate[] = [];

    for (const additional of toArray(additionalPayload)) {
      if (!hasHighReliability(additional)) continue;

      const key = joinKey(additional.master_row);
      if (!key || seenEventRows.has(key)) continue;

      const event = masterEventsByRow.get(key);
      if (!event) continue;

      const deadline = upcomingDeadlineFor(additional, todayValue);
      if (!deadline) continue;

      const eventDate = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
      const eventDateValue = parseIsoDateValue(eventDate);
      if (!Number.isFinite(eventDateValue)) continue;

      seenEventRows.add(key);
      candidates.push({
        event,
        additional,
        deadlineDate: deadline.date,
        deadlineValue: deadline.value,
        deadlineType: deadline.type,
        deadlineWindowRank: deadline.value <= deadlineWindowEndValue ? 0 : 1,
        eventDateValue,
        title: getDisplayEventTitle(getEventTitle(event))
      });
    }

    return candidates
      .sort((a, b) =>
        a.deadlineWindowRank - b.deadlineWindowRank ||
        a.deadlineValue - b.deadlineValue ||
        (a.deadlineType === 'early' ? 0 : 1) - (b.deadlineType === 'early' ? 0 : 1) ||
        a.eventDateValue - b.eventDateValue ||
        a.title.localeCompare(b.title, 'sl-SI')
      )
      .slice(0, 3);
  };

  const renderRegistrationDeadlineItems = (items: DeadlineCandidate[]) => items.map((item) => {
    const deadlineDate = formatDeadlineDate(item.deadlineDate);
    const deadlineBadge = formatDeadlineBadge(item, deadlineDate);
    const label = formatDeadlineLabel(item, deadlineDate);
    const price = formatDeadlinePrice(item.additional);

    return `
      <li class="registration-deadlines-item">
        <div class="registration-deadlines-line">
          <time datetime="${escapeHtml(item.deadlineDate)}">${escapeHtml(deadlineBadge)}</time>
          <span aria-hidden="true">·</span>
          <strong><a href="${escapeHtml(eventDetailPath(item.event))}">${escapeHtml(item.title)}</a></strong>
          ${price ? `<span class="registration-price-chip">${escapeHtml(price)}</span>` : ''}
        </div>
        <p>${escapeHtml(label)}</p>
      </li>
    `;
  }).join('');

  async function loadRegistrationDeadlines() {
    const section = document.querySelector<HTMLElement>('[data-registration-deadlines-section]');
    const list = document.querySelector<HTMLElement>('[data-registration-deadlines]');
    if (!section || !list) return;

    section.hidden = true;
    list.innerHTML = '';

    try {
      const [masterPayload, additionalPayload] = await Promise.all([
        loadJson('/'),
        loadJson('/additional')
      ]);
      const deadlineEvents = buildDeadlineCandidates(masterPayload, additionalPayload);

      if (!deadlineEvents.length) return;

      list.innerHTML = renderRegistrationDeadlineItems(deadlineEvents);
      section.hidden = false;
    } catch (error) {
      section.hidden = true;
      list.innerHTML = '';
    }
  }

  const apiRequestCache = new Map<string, Promise<unknown>>();

  async function loadJson(path: string): Promise<unknown> {
    if (!apiRequestCache.has(path)) {
      apiRequestCache.set(path, fetch(`${API_BASE}${path}`, { headers: { accept: 'application/json' } }).then((response) => {
        if (!response.ok) throw new Error(`API request failed: ${response.status}`);
        return response.json();
      }));
    }

    return apiRequestCache.get(path)!;
  }


  async function loadNearestEvents() {
    const container = document.querySelector('[data-nearest-events]');
    if (!container) return;

    try {
      const payload = await loadJson('/');
      const todayValue = todayStartValue();
      const events = toArray(payload)
        .filter((event) => isConfirmedPublicUpcomingEvent(event, todayValue))
        .sort((a, b) => {
          const dateDifference = (eventDateValue(a) ?? Number.POSITIVE_INFINITY) - (eventDateValue(b) ?? Number.POSITIVE_INFINITY);
          if (dateDifference !== 0) return dateDifference;

          const placeDifference = getEventField(a, 'kraj', ['place', 'city', 'location']).localeCompare(getEventField(b, 'kraj', ['place', 'city', 'location']), 'sl-SI');
          if (placeDifference !== 0) return placeDifference;

          return getEventTitle(a).localeCompare(getEventTitle(b), 'sl-SI');
        });
      const interestPreviewEvents = await getInterestPreviewRaces(events, 20).catch(() => []);
      renderHeroPreview(interestPreviewEvents, events);
      const visibleEvents = events.slice(0, 4);

      if (!events.length) {
        container.innerHTML = `
          <article class="event-card">
            <h3>Trenutno ni prikazanih najbližjih tekov</h3>
            <p>Preverite iskalnik tekov za širši pregled koledarja.</p>
            <div class="event-meta">
              <a class="pill" href="/iskalnik-tekov/">Poglejte vse teke</a>
            </div>
          </article>
        `;
        setStatus('nearest', 'Trenutno ni prikazanih potrjenih prihajajočih javnih tekov.');
        return;
      }

      const eventCards = visibleEvents.map((event) => {
        const sourceTitle = getEventTitle(event);
        const title = getDisplayEventTitle(sourceTitle);
        const dateValue = getEventField(event, 'datum', ['date', 'event_date', 'Datum']);
        const date = formatDate(dateValue);
        const location = getEventField(event, 'kraj', ['place', 'city', 'location']);
        const region = getEventField(event, 'regija', ['region']);
        const analyticsEventId = getEventStableId(event, title, dateValue, location);
        const noticeUrl = safeUrl(getEventField(event, 'povezava_razpis', ['notice_url', 'razpis_url']));
        const registrationUrl = safeUrl(getEventField(event, 'povezava_prijava', ['registration_url', 'prijava_url']));
        const calendarOptions = renderCalendarOptions({ title, date: dateValue, location, noticeUrl, registrationUrl });
        const summary = joinParts([location, region]);
        const links = [
          ...buildPrimaryActions({ registrationUrl, noticeUrl }, 'sl').map(renderPrimaryActionLink),
          calendarOptions,
          renderSavedRaceButton(event, title, dateValue, location)
        ].filter(Boolean).join('');

        return `
          <article class="event-card" data-analytics-placement="home_this_week" data-analytics-event-id="${escapeHtml(analyticsEventId)}" data-analytics-event-name="${escapeHtml(title)}" data-analytics-event-date="${escapeHtml(dateValue)}" data-analytics-event-year="2026">
            <div class="event-card-heading">
              <time class="event-card-date" datetime="${escapeHtml(dateValue)}" aria-label="${escapeHtml(date)}">${escapeHtml(formatDateBadge(dateValue))}</time>
              <h3><a href="${escapeHtml(eventDetailPath(event))}">${escapeHtml(title)}</a></h3>
            </div>
            ${summary ? `<p>${escapeHtml(summary)}</p>` : ''}
            ${links ? `<div class="event-actions">${links}</div>` : ''}
          </article>
        `;
      }).join('');

      container.innerHTML = eventCards;
      initSavedRaceButtons(container);
      setStatus('nearest', '');
    } catch (error) {
      container.innerHTML = `
        <article class="event-card">
          <h3>Seznam trenutno ni dosegljiv</h3>
          <p>Ko bodo podatki znova na voljo, se bodo najbližji teki prikazali tukaj.</p>
        </article>
      `;
      setStatus('nearest', 'Seznam najbližjih tekov trenutno ni dosegljiv, zato prikazujemo nadomestni prikaz.');
    }
  }

  async function loadStats() {
    try {
      const [statsResult, groupRunsResult] = await Promise.allSettled([
        loadJson('/stats'),
        loadJson('/group-runs')
      ]);
      const statsPayload = statsResult.status === 'fulfilled' ? statsResult.value : null;
      const groupRunsPayload = groupRunsResult.status === 'fulfilled' ? groupRunsResult.value : null;
      const confirmedTotal = pickNestedNumber(statsPayload, ['confirmed_public_events_total']);
      const familyTotal = pickNestedNumber(statsPayload, ['family_friendly_total']);
      const groupRunsTotal = pickNestedNumber(groupRunsPayload, ['row_count', 'group_runs_total', 'total', 'count']);
      const values = {
        confirmed_public_events_total: confirmedTotal,
        family_friendly_total: familyTotal,
        group_runs_total: groupRunsTotal
      };

      for (const [key, value] of Object.entries(values)) {
        const element = document.querySelector(`[data-stat="${key}"]`);
        if (element) {
          element.textContent = value === null ? 'Ni podatka' : numberFormatter.format(value);
        }
      }

      setDebug('stats', `yes (${confirmedTotal !== null ? 'confirmed ok' : 'confirmed missing'}, ${familyTotal !== null ? 'family ok' : 'family missing'}, ${groupRunsTotal !== null ? 'group runs ok' : 'group runs missing'})`);

      if (confirmedTotal !== null && familyTotal !== null && groupRunsTotal !== null) {
        setStatus('stats', '');
      } else {
        setStatus('stats', 'Ena ali več statističnih vrednosti trenutno manjka.');
      }
    } catch (error) {
      setDebug('stats', 'no');
      setStatus('stats', 'Statistika trenutno ni dosegljiva, zato prikazujemo osnovni pogled.');
    }
  }

  async function loadTopEvents() {
    const container = document.querySelector('[data-top-events]');
    const description = document.querySelector('[data-top-description]');
    if (!container) return;

    const renderEvents = (events: ApiRecord[], options: { interestPreview: boolean }) => {
      container.innerHTML = events.map((event) => {
        const title = titleForEvent(event);
        const location = pickPath(event, ['kraj', 'event.kraj', 'race.kraj', 'data.kraj', 'location', 'place', 'city', 'regija', 'Regija'], 'Slovenija');
        const region = pickPath(event, ['regija', 'event.regija', 'race.regija', 'data.regija', 'region'], '');
        const dateValue = pickPath(event, ['datum', 'event.datum', 'race.datum', 'data.datum', 'date', 'event_date', 'Datum']);
        const date = formatDate(dateValue);
        const analyticsEventId = getEventStableId(event, title, dateValue, location);
        const votes = getTopEventVotes(event);
        const meta = joinParts([location, region && region !== location ? region : '']);
        const metaItems = options.interestPreview
          ? ''
          : [
              votes !== null
                ? `<span class="event-chip pill-orange">${escapeHtml(formatVoteCount(votes))}</span>`
                : '<span class="event-chip pill-orange">Glasovanje odprto</span>'
            ].filter(Boolean).join('');

        return `
          <article class="event-card" data-analytics-placement="home_interest" data-analytics-event-id="${escapeHtml(analyticsEventId)}" data-analytics-event-name="${escapeHtml(title)}" data-analytics-event-date="${escapeHtml(dateValue)}" data-analytics-event-year="${escapeHtml(getEventYear(event))}">
            <div class="event-card-heading">
              <time class="event-card-date" datetime="${escapeHtml(dateValue)}" aria-label="${escapeHtml(date)}">${escapeHtml(formatDateBadge(dateValue))}</time>
              <h3><a href="${escapeHtml(eventDetailPath(event))}">${escapeHtml(title)}</a></h3>
            </div>
            ${meta ? `<p>${escapeHtml(meta)}</p>` : ''}
            ${metaItems ? `<div class="event-details">${metaItems}</div>` : ''}
            ${renderSavedRaceButton(event, title, dateValue, location) ? `<div class="event-actions">${renderSavedRaceButton(event, title, dateValue, location)}</div>` : ''}
          </article>
        `;
      }).join('');
    };

    try {
      const masterRows = await getMasterRaceRows();
      const interestEvents = await getInterestPreviewRaces(masterRows, 5);
      if (interestEvents.length) {
        setDebug('top', 'yes');
        setDebugTopDetails(interestEvents, interestEvents);
        renderEvents(interestEvents, { interestPreview: true });
        initSavedRaceButtons(container);
        if (description) description.textContent = 'Izbor prihodnjih tekov.';
        setStatus('top', 'Izbor prihodnjih tekov.');
        return;
      }
    } catch (error) {
      if (import.meta.env.DEV) console.warn('STK interest preview unavailable, falling back to voted races.', error);
    }

    try {
      const topUpcomingResult = await getTopUpcomingRaces();
      const topEvents = topUpcomingResult.events.slice(0, 5);
      const rawTopEvents = topUpcomingResult.rawEvents.slice(0, 5);
      setDebug('top', 'yes');
      if (!topEvents.length) {
        setDebugTopDetails(topEvents, rawTopEvents);
        setStatus('top', 'Trenutno ni prikazanih tekov z največ zanimanja.');
        return;
      }

      setDebugTopDetails(topEvents, rawTopEvents);
      renderEvents(topEvents, { interestPreview: false });
      initSavedRaceButtons(container);
      if (description) description.textContent = 'Izbor prihodnjih tekov.';
      setStatus('top', 'Izbor prihodnjih tekov.');
    } catch (error) {
      setDebug('top', 'no');
      setStatus('top', 'Seznam trenutno ni dosegljiv, zato ostaja nadomestni prikaz.');
    }
  }

  async function loadRecentUpdates() {
    const container = document.querySelector('[data-recent-updates]');
    if (!container) return;

    try {
      const [recentResult, masterResult] = await Promise.allSettled([
        loadJson('/recent_updates?days=7&limit=20'),
        loadJson('/')
      ]);
      if (recentResult.status === 'rejected') throw recentResult.reason;
      const { updatedEvents, newEvents, confirmedEvents } = getRecentUpdateGroups(recentResult.value);
      const masterIndex = masterResult.status === 'fulfilled'
        ? buildHomepageMasterEventIndex(getMasterRows(masterResult.value))
        : null;
      if (masterResult.status === 'rejected') setDebug('master', 'no');
      const updates = [
        ...updatedEvents,
        ...newEvents,
        ...confirmedEvents
      ].slice(0, 20);
      setDebug('recent', 'yes');
      setDebugRecentDetails(updates);

      if (!updatedEvents.length && !newEvents.length && !confirmedEvents.length) {
        container.innerHTML = `
          <article class="update-card">
            <p>V zadnjih 7 dneh ni bilo novih javnih sprememb v koledarju.</p>
          </article>
        `;
        setStatus('updates', '');
        return;
      }

      container.innerHTML = updates.map((update) => {
        const title = pickPath(update, [
          'naziv_prireditve',
          'naziv',
          'event.naziv_prireditve',
          'event.naziv',
          'title',
          'name'
        ], 'Posodobitev koledarja');
        const eventDate = formatDate(pickPath(update, ['datum', 'event.datum', 'date', 'event_date', 'Datum']));
        const recentUpdateDate = formatDate(pickPath(update, ['recent_update_date', 'event.recent_update_date']));
        const updateDateMeta = recentUpdateDate
          ? joinParts([`Posodobljeno ${recentUpdateDate}`, eventDate ? `dogodek ${eventDate}` : ''])
          : eventDate;
        const changed = formatDate(pickPath(update, ['zadnja_sprememba', 'event.zadnja_sprememba', 'updated_at', 'updated', 'modified_at', 'changed_at', 'last_updated']));
        const location = pickPath(update, ['kraj', 'event.kraj', 'place', 'city', 'location'], '');
        const region = pickPath(update, ['regija', 'event.regija', 'region'], '');
        const place = joinParts([location, region && region !== location ? region : '']);

        const matchedEvent = masterIndex ? matchRecentUpdateToMasterEvent(update, masterIndex) : { event: null, reason: 'master_unavailable' };
        const detailPath = matchedEvent.event ? buildHomepageEventDetailPath(matchedEvent.event, {
          rowKey: eventRowKey,
          getTitle: getEventTitle,
          getDisplayTitle: getDisplayEventTitle
        }) : '';
        const canonicalTitle = matchedEvent.event ? getDisplayEventTitle(getEventTitle(matchedEvent.event, title)) : title;
        const canonicalDate = matchedEvent.event ? getEventField(matchedEvent.event, 'datum', ['date', 'event_date', 'Datum']) : '';
        const canonicalYear = matchedEvent.event ? getEventYear(matchedEvent.event) : '';
        const analyticsEventId = matchedEvent.event && canonicalDate ? getEventStableId(matchedEvent.event, canonicalTitle, canonicalDate, getEventField(matchedEvent.event, 'kraj', ['place', 'city', 'location'])) : '';
        if (!detailPath && debugEnabled) console.debug('[STK home] Recent update not linked', matchedEvent.reason, update);
        const analyticsAttributes = detailPath
          ? ` data-analytics-placement="home_updates" data-analytics-event-id="${escapeHtml(analyticsEventId)}" data-analytics-event-name="${escapeHtml(canonicalTitle)}" data-analytics-event-date="${escapeHtml(canonicalDate)}" data-analytics-event-year="${escapeHtml(canonicalYear)}"`
          : '';

        return `
          <article class="update-card"${analyticsAttributes}>
            ${updateDateMeta ? `<p class="update-meta">${escapeHtml(updateDateMeta)}</p>` : ''}
            <h3>${detailPath ? `<a href="${escapeHtml(detailPath)}">${escapeHtml(title)}</a>` : escapeHtml(title)}</h3>
            ${place ? `<p>${escapeHtml(place)}</p>` : ''}
            ${changed ? `<p>${escapeHtml(changed)}</p>` : ''}
          </article>
        `;
      }).join('');
      setStatus('updates', '');
    } catch (error) {
      setDebug('recent', 'no');
      setStatus('updates', 'Zadnje posodobitve trenutno niso dosegljive, zato ostaja nadomestni prikaz.');
    }
  }

  if (enableApiDebug) createDebugPanel();
  loadStats();
  loadNearestEvents();
  loadRegistrationDeadlines();
  loadTopEvents();
  loadRecentUpdates();
</script>
