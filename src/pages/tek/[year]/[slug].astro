---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { attachAdditionalDataByMasterRow, fetchAdditionalEventData, renderAdditionalDataBlock, renderAdditionalDataChips, type AdditionalEventData } from '../../../utils-additional';
import { buildGoogleCalendarEventUrl, buildIcsDataUrl, buildIcsFilename, buildOutlookCalendarEventUrl } from '../../../utils-calendar';
import { buildEventDetailPath, buildEventDetailSlug, mapPublicRaceEvent, slugMatchesEvent, toApiRecords, type PublicRaceEvent } from '../../../utils-event-detail';
import { buildMasterApiPath, isAdditionalDataEnabledForYear, SUPPORTED_PUBLIC_YEARS, type PublicYear } from '../../../utils-public-year';
import { formatSloveneDateBadge, formatSloveneDistances } from '../../../utils-slovenian';
import { enrichEventsWithVoteUrls, isVoteUrlSafeForEvent } from '../../../utils-vote';

type DetailEvent = PublicRaceEvent & { additionalData?: AdditionalEventData | null };

const API_BASE = 'https://stk-master-api.igor-kalsek.workers.dev';
const TOP_API_URL = `${API_BASE}/top?scope=upcoming&limit=1000`;

export async function getStaticPaths() {
  const paths = [];
  for (const year of SUPPORTED_PUBLIC_YEARS) {
    let response: Response;
    try {
      response = await fetch(`https://stk-master-api.igor-kalsek.workers.dev${buildMasterApiPath(year)}`, { headers: { Accept: 'application/json' } });
    } catch (error) {
      console.warn(`Detail strani getStaticPaths skipped ${year}`, error);
      continue;
    }
    if (!response.ok) continue;
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
    const events = toApiRecords(await response.json())
      .map((item) => mapPublicRaceEvent(item, year, today))
      .filter((event): event is PublicRaceEvent => Boolean(event))
      .sort((a, b) => a.dateValue - b.dateValue || a.title.localeCompare(b.title, 'sl-SI'));
    paths.push(...events.map((event) => ({
      params: { year, slug: buildEventDetailSlug(event) },
      props: { event, year }
    })));
  }
  return paths;
}

const { event: baseEvent, year } = Astro.props as { event?: PublicRaceEvent; year?: PublicYear };
const slug = Astro.params.slug ?? '';
const isValidYear = SUPPORTED_PUBLIC_YEARS.includes(year as PublicYear);
const eventYear = isValidYear ? year as PublicYear : undefined;
let event: DetailEvent | null = baseEvent && isValidYear && slugMatchesEvent(slug, baseEvent) ? baseEvent : null;

if (event && eventYear && isAdditionalDataEnabledForYear(eventYear)) {
  try {
    const [withAdditional] = attachAdditionalDataByMasterRow([event], await fetchAdditionalEventData());
    event = withAdditional;
  } catch (error) {
    console.warn('Detail strani additional data skipped', error);
  }
}

if (event && year === '2026') {
  try {
    const topResponse = await fetch(TOP_API_URL, { headers: { Accept: 'application/json' } });
    if (topResponse.ok) {
      const [withVoteUrl] = enrichEventsWithVoteUrls([event], toApiRecords(await topResponse.json()));
      event = withVoteUrl;
    }
  } catch (error) {
    console.warn('Detail strani vote enrichment skipped', error);
  }
}

const escapeHtml = (value: string | number) => String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character] ?? character));
const formatDate = (value: string) => new Intl.DateTimeFormat('sl-SI', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${value}T00:00:00`));
const formatStartTime = (value: string) => {
  const match = value.trim().match(/^(\d{1,2}):(\d{2})(.*)$/);
  return match ? `${match[1].padStart(2, '0')}:${match[2]}${match[3] ?? ''}` : value.trim();
};
const formatSurface = (value: string) => value.trim().toLocaleLowerCase('sl-SI').replace(/^./, (letter) => letter.toLocaleUpperCase('sl-SI'));
const calendarOptions = event ? {
  googleUrl: buildGoogleCalendarEventUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl }),
  icsUrl: buildIcsDataUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl }),
  icsFilename: buildIcsFilename({ title: event.title, date: event.date }),
  outlookUrl: buildOutlookCalendarEventUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl })
} : null;
const voteUrl = event?.voteUrl && isVoteUrlSafeForEvent(event, event.voteUrl).safe ? event.voteUrl : '';
const description = event
  ? `${event.title}: ${formatDate(event.date)}${event.place ? `, ${event.place}` : ''}${event.region ? ` (${event.region})` : ''}${event.distances ? `. Razdalje: ${formatSloveneDistances(event.distances)}.` : '.'}`
  : 'Podrobnosti teka trenutno niso na voljo. Preverite iskalnik tekov.';
const title = event ? `${event.title} | Slovenski Tekaški Koledar` : 'Tek ni najden | Slovenski Tekaški Koledar';
const canonicalPath = event ? buildEventDetailPath(event) : `/iskalnik-tekov/${year === '2027' ? '?year=2027' : ''}`;
const searchPath = year === '2027' ? '/iskalnik-tekov/?year=2027' : '/iskalnik-tekov/';
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <main>
    {event ? (
      <>
        <section class="page-hero container event-detail-hero" aria-labelledby="event-detail-title">
          <span class="eyebrow">Tek {year}</span>
          <h1 id="event-detail-title">{event.title}</h1>
          <p>{description}</p>
          <div class="search-event-date">
            <time class="event-card-date" datetime={event.date} aria-label={formatDate(event.date)}>{formatSloveneDateBadge(event.date)}</time>
            {event.familyFriendly && <span class="pill pill-family">Družinam prijazno</span>}
          </div>
        </section>

        <section class="section container event-detail-section" aria-label="Podrobnosti teka">
          <article class="event-card event-detail-card" data-event-row={event.row} data-analytics-event-id={event.id} data-analytics-event-name={event.title} data-analytics-event-date={event.date}>
            <div class="event-details event-detail-grid">
              {event.place && <span class="event-chip"><strong>Kraj:</strong> {event.place}</span>}
              {event.region && <span class="event-chip"><strong>Regija:</strong> {event.region}</span>}
              {event.surface && <span class="event-chip event-chip-surface">{formatSurface(event.surface)}</span>}
              {event.distances && <span class="event-chip"><strong>Razdalje:</strong> {formatSloveneDistances(event.distances)}</span>}
              {event.startTime && <span class="event-chip"><strong>Start:</strong> {formatStartTime(event.startTime)}</span>}
              {event.cup && <span class="event-chip"><strong>Pokal/serija:</strong> {event.cup}</span>}
            </div>

            {event.publicNotes && <p class="event-detail-notes"><strong>Opombe:</strong> {event.publicNotes}</p>}
            {event.additionalData && <Fragment set:html={renderAdditionalDataChips(event.additionalData, escapeHtml, { eventDate: event.date, eventId: event.id, eventName: event.title, kidsRaces: event.kidsRaces })} />}
            {event.additionalData && <Fragment set:html={renderAdditionalDataBlock(event.additionalData, escapeHtml, { eventDate: event.date })} />}

            <div class="event-actions event-detail-actions">
              {event.registrationUrl && <a class="button button-primary" href={event.registrationUrl} target="_blank" rel="noopener noreferrer" data-analytics-link-type="prijava"><span class="action-icon" aria-hidden="true">✍️</span><span>Prijava</span></a>}
              {event.noticeUrl && <a class="button button-secondary-light" href={event.noticeUrl} target="_blank" rel="noopener noreferrer" data-analytics-link-type="razpis"><span class="action-icon" aria-hidden="true">📄</span><span>Razpis</span></a>}
              {voteUrl && <a class="button button-secondary-light" href={voteUrl} target="_blank" rel="noopener noreferrer" data-analytics-action="vote" aria-label={`Glasujte za ${event.title}`}><span class="action-icon" aria-hidden="true">👍</span><span>Glasuj</span></a>}
              {calendarOptions && (calendarOptions.googleUrl || calendarOptions.icsUrl || calendarOptions.outlookUrl) && (
                <details class="calendar-menu">
                  <summary class="button button-secondary-light"><span aria-hidden="true">📅</span><span>V koledar</span></summary>
                  <div class="calendar-menu-options">
                    {calendarOptions.googleUrl && <a href={calendarOptions.googleUrl} target="_blank" rel="noopener noreferrer" data-analytics-calendar-type="google">Google</a>}
                    {calendarOptions.icsUrl && <a href={calendarOptions.icsUrl} download={calendarOptions.icsFilename} data-analytics-calendar-type="ics">Apple / iCal</a>}
                    {calendarOptions.outlookUrl ? <a href={calendarOptions.outlookUrl} target="_blank" rel="noopener noreferrer" data-analytics-calendar-type="outlook">Outlook</a> : calendarOptions.icsUrl && <a href={calendarOptions.icsUrl} download={calendarOptions.icsFilename} data-analytics-calendar-type="ics">Outlook / .ics</a>}
                  </div>
                </details>
              )}
            </div>
          </article>
          <p><a class="button button-secondary-light" href={searchPath}>Nazaj na iskalnik tekov</a></p>
        </section>
      </>
    ) : (
      <section class="page-hero container" aria-labelledby="event-not-found-title">
        <span class="eyebrow">Tek ni najden</span>
        <h1 id="event-not-found-title">Tega teka ne moremo prikazati</h1>
        <p>Dogodek ne obstaja, ni javno objavljen ali pa povezava ni pravilna. Podatkov za drugo leto ne prikazujemo pod tem URL-jem.</p>
        <a class="button button-primary" href={searchPath}>Nazaj na iskalnik tekov</a>
      </section>
    )}
  </main>
</BaseLayout>
