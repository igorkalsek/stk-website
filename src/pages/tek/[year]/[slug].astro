---
import RelatedRaceCards from '../../../components/RelatedRaceCards.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { type AdditionalEventData } from '../../../utils-additional';
import { buildGoogleCalendarEventUrl, buildIcsDataUrl, buildIcsFilename, buildOutlookCalendarEventUrl } from '../../../utils-calendar';
import { buildEnglishEventDetailPath, buildEventDetailPath, getStableEventId, slugMatchesEvent, type PublicRaceEvent } from '../../../utils-event-detail';
import { isAdditionalDataEnabledForYear, SUPPORTED_PUBLIC_YEARS, type PublicYear } from '../../../utils-public-year';
import { formatSloveneDistances } from '../../../utils-slovenian';
import { isVoteUrlSafeForEvent } from '../../../utils-vote';
import { buildRaceCopyDescription } from '../../../utils-race-copy';
import { buildRaceShareUrls } from '../../../utils-race-share';
import { type RelatedRaceCard } from '../../../utils-related-races';
import { attachAdditionalDataCached, enrichEventsWithVoteUrlsCached, getDetailStaticPaths, maybePrintBuildTiming } from '../../../utils-build-data';
import { buildCourseHeading, buildCourseRows, buildFamilyInfo, buildKeyFacts, buildPrimaryActions, buildRaceHighlightCards, buildPublicNotes, buildRegistrationRows, formatDetailSurface } from '../../../utils-race-detail-view';

type DetailEvent = PublicRaceEvent & { additionalData?: AdditionalEventData | null };
type HeroFact = { label: string; value: string; datetime?: string; isDate?: boolean };

export async function getStaticPaths() {
  return getDetailStaticPaths('sl');
}

const { event: baseEvent, year, relatedRaces = [] } = Astro.props as { event?: PublicRaceEvent; year?: PublicYear; relatedRaces?: RelatedRaceCard[] };
const slug = Astro.params.slug ?? '';
const isValidYear = SUPPORTED_PUBLIC_YEARS.includes(year as PublicYear);
const eventYear = isValidYear ? year as PublicYear : undefined;
let event: DetailEvent | null = baseEvent && isValidYear && slugMatchesEvent(slug, baseEvent) ? baseEvent : null;

if (event && eventYear && isAdditionalDataEnabledForYear(eventYear)) {
  try {
    const [withAdditional] = await attachAdditionalDataCached([event]);
    event = withAdditional;
  } catch (error) {
    console.warn('Detail strani additional data skipped', error);
  }
}

if (event && year === '2026') {
  try {
    const [withVoteUrl] = await enrichEventsWithVoteUrlsCached([event]);
    event = withVoteUrl;
  } catch (error) {
    console.warn('Detail strani vote enrichment skipped', error);
  }
}

maybePrintBuildTiming();

const formatDate = (value: string) => new Intl.DateTimeFormat('sl-SI', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${value}T00:00:00`));
const formatDateParts = (value: string) => {
  const date = new Date(`${value}T00:00:00`);
  return {
    day: new Intl.DateTimeFormat('sl-SI', { day: 'numeric' }).format(date),
    month: new Intl.DateTimeFormat('sl-SI', { month: 'short' }).format(date).replace('.', ''),
    year: new Intl.DateTimeFormat('sl-SI', { year: 'numeric' }).format(date)
  };
};
const calendarOptions = event ? {
  googleUrl: buildGoogleCalendarEventUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl }),
  icsUrl: buildIcsDataUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl }),
  icsFilename: buildIcsFilename({ title: event.title, date: event.date }),
  outlookUrl: buildOutlookCalendarEventUrl({ title: event.title, date: event.date, location: event.place, noticeUrl: event.noticeUrl, registrationUrl: event.registrationUrl })
} : null;
const voteUrl = event?.voteUrl && isVoteUrlSafeForEvent(event, event.voteUrl).safe ? event.voteUrl : '';
const description = event
  ? `${event.title} – ${formatDate(event.date)}${event.place ? `, ${event.place}` : ''}. Razdalje: ${event.distances ? formatSloveneDistances(event.distances) : 'niso dodane'}. Podrobnosti, razpis, prijava in koledar na Slovenskem Tekaškem Koledarju.`
  : 'Podrobnosti teka trenutno niso na voljo. Preverite iskalnik tekov.';
const title = event ? `${event.title} | Slovenski Tekaški Koledar` : 'Tek ni najden | Slovenski Tekaški Koledar';
const canonicalPath = event ? buildEventDetailPath(event) : `/iskalnik-tekov/${year === '2027' ? '?year=2027' : ''}`;
const searchPath = year === '2027' ? '/iskalnik-tekov/?year=2027' : '/iskalnik-tekov/';
const copyDescription = event ? buildRaceCopyDescription({ event, language: 'sl', formatDate }) : '';
const shareLinks = event ? buildRaceShareUrls({ event, language: 'sl', formatDate }) : null;
const shareUrl = shareLinks?.detailUrl ?? '';
const buildCorrectionUrl = (event: DetailEvent, language: 'sl' | 'en', returnUrl: string) => {
  const params = new URLSearchParams({
    event: event.title,
    year: event.year,
    date: event.date ?? '',
    place: event.place ?? '',
    source: 'detail',
    lang: language,
    returnUrl
  });
  return `/dodaj-ali-popravi-tek/?${params.toString()}`;
};
const correctionUrl = event ? buildCorrectionUrl(event, 'sl', shareUrl) : '/dodaj-ali-popravi-tek/';
const englishPath = event ? buildEnglishEventDetailPath(event) : (year === '2027' ? '/en/find-races/?year=2027' : '/en/find-races/');

const getDateStatus = (value: string) => {
  const eventTime = new Date(`${value}T00:00:00`).getTime();
  const now = new Date();
  const todayTime = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  if (!Number.isFinite(eventTime)) return '';
  const days = Math.round((eventTime - todayTime) / 86_400_000);
  if (days === 0) return 'Danes';
  if (days > 0) return `Prihaja čez ${days} ${days === 1 ? 'dan' : days === 2 ? 'dni' : 'dni'}`;
  return 'Dogodek je že mimo';
};
const locationQuery = event ? [event.place, event.region].filter(Boolean).join(', ') : '';
const locationUrl = locationQuery ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(locationQuery)}` : '';
const eventStatus = event ? getDateStatus(event.date) : '';
const parseRegistrationAmount = (value: string) => {
  if (!value) return null;
  const amount = Number(value.replace(',', '.').replace(/[^\d.-]/g, ''));
  return Number.isFinite(amount) ? amount : null;
};

const primaryActions = event ? buildPrimaryActions(event, 'sl') : [];
const savedRaceEventId = event ? getStableEventId(event) : '';
const heroDateParts = event ? formatDateParts(event.date) : null;
const heroFacts: HeroFact[] = event ? [
  ...(event.startTime ? [{ label: 'Ura', value: event.startTime }] : []),
  ...(event.place ? [{ label: 'Kraj', value: event.place }] : []),
  ...(event.distances ? [{ label: 'Razdalje', value: formatSloveneDistances(event.distances) }] : []),
  ...(event.surface ? [{ label: 'Podlaga', value: formatDetailSurface(event.surface, 'sl') }] : [])
] : [];
const heroBadges = event ? [
  event.region ? { label: 'Regija', value: event.region } : null,
  event.cup ? { label: 'Pokal ali serija', value: event.cup } : null,
  event.familyFriendly ? { label: 'Družine', value: 'Družinam prijazno' } : null
].filter((item): item is { label: string; value: string; featured?: boolean } => Boolean(item)) : [];
const detailItems = event ? buildKeyFacts(event, 'sl') : [];
const raceHighlights = event ? buildRaceHighlightCards(event, 'sl') : [];
const registrationItems = event ? buildRegistrationRows(event, 'sl', formatDate) : [];
const routeItems = event ? buildCourseRows(event, 'sl') : [];
const courseHeading = event ? buildCourseHeading(event, 'sl') : '';
const familyInfo = event ? buildFamilyInfo(event, 'sl') : [];
const publicNotes = event ? buildPublicNotes(event, 'sl', familyInfo) : '';
const offerPrice = event?.additionalData ? parseRegistrationAmount(event.additionalData.registrationMinEur || event.additionalData.registrationMaxEur) : null;
const jsonLd = event ? {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.date,
  endDate: event.date,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  ...(event.place ? {
    location: {
      '@type': 'Place',
      name: event.place,
      address: [event.place, event.region, 'Slovenija'].filter(Boolean).join(', ')
    }
  } : {}),
  url: shareUrl,
  description,
  ...(offerPrice !== null ? {
    offers: {
      '@type': 'Offer',
      price: offerPrice,
      priceCurrency: 'EUR',
      url: event.registrationUrl || event.noticeUrl || shareUrl,
      availability: 'https://schema.org/InStock'
    }
  } : {})
} : null;

---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} canonicalUrl={event ? shareUrl : undefined} alternateLinks={event ? [{ lang: 'sl', href: buildEventDetailPath(event) }, { lang: 'en', href: englishPath }] : []} languageSwitchHref={englishPath}>
  {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <main>
    {event ? (
      <>
        <section class="section container event-detail-top-section" aria-labelledby="event-detail-title">
          <div class="event-detail-profile-hero">
            <nav class="event-detail-breadcrumb" aria-label="Navigacija">
              <a href={searchPath}>Iskalnik tekov</a>
              <span aria-hidden="true">›</span>
              <span>{event.title}</span>
            </nav>
            <div class="event-detail-language-switch"><span class="eyebrow">Profil teka · {year}</span><a href={englishPath} hreflang="en">English</a></div>
            <div class="event-detail-hero-layout">
              {heroDateParts && (
                <time class="event-detail-date-card" datetime={event.date} aria-label={formatDate(event.date)}>
                  <span class="event-detail-date-card-day">{heroDateParts.day}</span>
                  <span class="event-detail-date-card-month">{heroDateParts.month}</span>
                  <span class="event-detail-date-card-year">{heroDateParts.year}</span>
                </time>
              )}
              <div class="event-detail-hero-copy">
                <h1 id="event-detail-title">{event.title}</h1>
                <p class="event-detail-date-line">
                  <time datetime={event.date}>{formatDate(event.date)}</time>{event.place && <> · {event.place}</>}{event.region && <> · {event.region}</>}
                </p>
                <dl class="event-detail-hero-facts" aria-label="Najpomembnejši podatki">
                  {heroFacts.map((fact) => (
                    <div class="event-detail-hero-fact">
                      <dt>{fact.label}</dt>
                      <dd>{fact.datetime ? <time datetime={fact.datetime}>{fact.value}</time> : fact.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
            {heroBadges.length > 0 && (
              <div class="event-detail-hero-badges" aria-label="Povzetek teka">
                {heroBadges.map((badge) => (
                  <span class={badge.featured ? 'event-chip event-detail-hero-chip event-detail-hero-chip-featured' : 'event-chip event-detail-hero-chip'} aria-label={`${badge.label}: ${badge.value}`}><strong>{badge.label}</strong>{badge.value}</span>
                ))}
              </div>
            )}
            <div class="event-detail-status-row">
              {eventStatus && <span class="pill event-detail-status-pill">{eventStatus}</span>}
            </div>
            <div class="event-detail-primary-actions event-detail-action-list" aria-label="Glavne povezave">
              {primaryActions.map((action) => (
                <a class={action.kind === 'registration' ? 'button button-primary event-detail-top-action' : 'button button-secondary-light event-detail-top-action'} href={action.url} target="_blank" rel="noopener noreferrer" data-analytics-link-type={action.analyticsType}><span class="action-icon" aria-hidden="true">{action.kind === 'registration' ? '✍️' : '📄'}</span><span>{action.label}</span></a>
              ))}
              <button class="button button-secondary-light saved-race-button" type="button" data-saved-race-button data-analytics-placement="race_detail" data-event-id={savedRaceEventId} data-event-year={event.year} data-event-date={event.date} data-event-title={event.title} data-language="sl" aria-pressed="false" aria-label="Shrani tek"><span class="action-icon" aria-hidden="true">☆</span><span data-saved-race-label>Shrani tek</span></button>
            </div>
          </div>
        </section>

        <section class="section container event-detail-section" aria-label="Podrobnosti teka">
          <div class="event-detail-page-grid" data-event-row={event.row} data-analytics-event-id={event.id} data-analytics-event-name={event.title} data-analytics-event-date={event.date} data-analytics-event-year={event.year} data-analytics-placement="race_detail" data-event-detail-view>
            <div class="event-detail-main-column">
              {detailItems.length > 0 && (
                <article class="info-card event-detail-panel">
                  <h2><span aria-hidden="true">⚡</span> Hitri podatki</h2>
                  <div class="event-detail-summary-grid" aria-label="Kratek povzetek teka">
                    {detailItems.map((item) => (
                      <div class="event-detail-summary-item">
                        <span class="event-detail-summary-content">
                          <span class="event-detail-summary-label">{item.label}</span>
                          <strong>{item.value}</strong>
                        </span>
                      </div>
                    ))}
                  </div>
                </article>
              )}
              {raceHighlights.length > 0 && (
                <article class="info-card event-detail-panel event-detail-highlights" aria-labelledby="race-highlights-title">
                  <h2 id="race-highlights-title">Kaj izstopa pri tem teku?</h2>
                  <div class="event-detail-highlight-grid">
                    {raceHighlights.map((highlight) => (
                      <div class="event-detail-highlight-card">
                        <span class="event-detail-highlight-icon" aria-hidden="true">{highlight.icon}</span>
                        <span class="event-detail-highlight-text">
                          <strong>{highlight.label}</strong>
                          <span>{highlight.value}</span>
                        </span>
                      </div>
                    ))}
                  </div>
                </article>
              )}


              {(registrationItems.length > 0 || routeItems.length > 0) && (
                <div class="event-detail-info-card-grid">
              {registrationItems.length > 0 && (
                    <article class="info-card event-detail-panel">
                      <h2><span aria-hidden="true">🎟</span> Prijava in udeležba</h2>
                      <dl class="event-detail-list">
                        {registrationItems.map((item) => (
                          <div>
                            <dt>{item.label}</dt>
                            <dd>{item.value}</dd>
                          </div>
                        ))}
                      </dl>
                    </article>
                  )}

                  {routeItems.length > 0 && (
                    <article class="info-card event-detail-panel">
                      <h2><span aria-hidden="true">🗺</span> {courseHeading}</h2>
                      <dl class="event-detail-list">
                        {routeItems.map((item) => (
                          <div>
                            <dt>{item.label}</dt>
                            <dd>{item.url ? <a class="button button-small button-secondary-light event-detail-inline-action" href={item.url} target="_blank" rel="noopener noreferrer" data-analytics-link-type={item.analyticsType} aria-label={item.ariaLabel}>{item.value}</a> : item.value}</dd>
                          </div>
                        ))}
                      </dl>
                    </article>
                  )}
                </div>
              )}

              {familyInfo.length > 0 && (
                <article class="info-card event-detail-panel event-detail-family-callout">
                  <h2><span aria-hidden="true">👨‍👩‍👧‍👦</span> Družine in otroci</h2>
                  {familyInfo.map((text) => <p>{text}</p>)}
                </article>
              )}

              {publicNotes && (
                <article class="info-card event-detail-panel">
                  <h2><span aria-hidden="true">ℹ️</span> Opombe</h2>
                  <p>{publicNotes}</p>
                </article>
              )}

              <p class="data-note event-detail-disclaimer">Podatki so informativni. Pred prijavo preverite uradni razpis ali stran organizatorja.</p>
            </div>

            <aside class="info-card event-detail-action-panel" aria-label="Glavne povezave">
              {voteUrl && (
                <div>
                  <h2>Glasovanje</h2>
                  <div class="event-detail-action-list">
                    <a class="button button-secondary-light" href={voteUrl} target="_blank" rel="noopener noreferrer" data-analytics-action="vote" aria-label={`Glasujte za ${event.title}`}><span class="action-icon" aria-hidden="true">👍</span><span>Glasuj</span></a>
                  </div>
                </div>
              )}

              <div class="event-detail-organizer-panel">
                <h2>Ste organizator tega teka?</h2>
                <p>Pomagajte tekačem najti točne podatke. Sporočite popravek razpisa, prijave, trase, startnine, otroških tekov ali drugih informacij.</p>
                <div class="event-detail-organizer-actions">
                  <a class="button button-small button-secondary-light" href={correctionUrl} data-analytics-event-type="correction_clicked" data-analytics-action-type="correction_cta_click">Predlagaj popravek ali dopolnitev</a>
                </div>
              </div>

              <div class="event-detail-tools-panel">
                <h2>Uporabna orodja</h2>
                {shareLinks && (
                <div class="event-detail-share-panel">
                  <h3>Deljenje</h3>
                  <button class="button button-small button-secondary-light event-detail-copy-description-button" type="button" data-copy-share-text={copyDescription} data-analytics-event-type="copy_clicked" data-analytics-action-type="copy_description_click" data-analytics-target-url={shareUrl}>Kopiraj opis</button>
                  <div class="event-detail-share-options" aria-label="Možnosti deljenja">
                    <button class="button button-small button-secondary-light event-detail-icon-button" type="button" data-copy-share-url={shareUrl} data-analytics-event-type="copy_clicked" data-analytics-action-type="copy_url_click" data-analytics-target-url={shareUrl} aria-label="Kopiraj povezavo"><span aria-hidden="true">🔗</span></button>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" data-facebook-share-button data-copy-share-text={copyDescription} data-facebook-copy-success="Opis je kopiran. Prilepite ga v Facebook objavo." data-facebook-copy-failure="Facebook je odprt. Za opis uporabite gumb Kopiraj opis." data-analytics-event-type="share_clicked" data-analytics-action-type="share_facebook_click" data-analytics-target-url={shareUrl} aria-label="Deli na Facebooku"><span aria-hidden="true">f</span></a>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" data-analytics-event-type="share_clicked" data-analytics-action-type="share_whatsapp_click" data-analytics-target-url={shareUrl} aria-label="Deli na WhatsApp"><span aria-hidden="true">WA</span></a>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" data-analytics-event-type="share_clicked" data-analytics-action-type="share_x_click" data-analytics-target-url={shareUrl} aria-label="Deli na X"><span aria-hidden="true">𝕏</span></a>
                    <a class="button button-small button-secondary-light event-detail-icon-button" href={shareLinks.email} data-analytics-event-type="share_clicked" data-analytics-action-type="share_email_click" data-analytics-target-url={shareUrl} aria-label="Pošlji po e-pošti"><span aria-hidden="true">✉</span></a>
                  </div>
                  <p class="event-detail-share-feedback" data-share-feedback role="status" aria-live="polite"></p>
                </div>
              )}

              {calendarOptions && (calendarOptions.googleUrl || calendarOptions.icsUrl || calendarOptions.outlookUrl) && (
                <div class="event-detail-calendar-panel">
                  <h3>Koledar</h3>
                  <div class="event-detail-calendar-actions">
                    {calendarOptions.googleUrl && <a class="button button-small button-secondary-light event-detail-icon-button event-detail-text-icon-button" href={calendarOptions.googleUrl} target="_blank" rel="noopener noreferrer" data-analytics-calendar-type="google" aria-label="Dodaj v Google Koledar"><span aria-hidden="true">G</span><span>Google koledar</span></a>}
                    {calendarOptions.icsUrl && <a class="button button-small button-secondary-light event-detail-icon-button event-detail-text-icon-button" href={calendarOptions.icsUrl} download={calendarOptions.icsFilename} data-analytics-calendar-type="ics" aria-label="Prenesi iCal datoteko"><span aria-hidden="true"></span><span>iCal</span></a>}
                    {calendarOptions.outlookUrl ? <a class="button button-small button-secondary-light event-detail-icon-button event-detail-text-icon-button" href={calendarOptions.outlookUrl} target="_blank" rel="noopener noreferrer" data-analytics-calendar-type="outlook" aria-label="Dodaj v Outlook"><span aria-hidden="true">O</span><span>Outlook</span></a> : calendarOptions.icsUrl && <a class="button button-small button-secondary-light event-detail-icon-button event-detail-text-icon-button" href={calendarOptions.icsUrl} download={calendarOptions.icsFilename} data-analytics-calendar-type="ics" aria-label="Prenesi Outlook iCal datoteko"><span aria-hidden="true">O</span><span>Outlook</span></a>}
                  </div>
                </div>
              )}

              {locationUrl && (
                <div class="event-detail-location-panel">
                  <h3>Lokacija</h3>
                  <a class="button button-small button-secondary-light event-detail-icon-button event-detail-text-icon-button" href={locationUrl} target="_blank" rel="noopener noreferrer" data-analytics-link-type="map_click" aria-label="Odpri lokacijo"><span aria-hidden="true">📍</span><span>Odpri zemljevid</span></a>
                </div>
              )}
              </div>
            </aside>
          </div>
          <RelatedRaceCards races={relatedRaces} language="sl" />
          <p class="event-detail-back"><a class="button button-secondary-light" href={searchPath}>Nazaj na iskalnik tekov</a></p>
        </section>
      </>
    ) : (
      <section class="page-hero container" aria-labelledby="event-not-found-title">
        <span class="eyebrow">Tek ni najden</span>
        <h1 id="event-not-found-title">Tega teka ne moremo prikazati</h1>
        <p>Dogodek ne obstaja, ni javno objavljen ali pa povezava ni pravilna. Podatkov za drugo leto ne prikazujemo pod tem URL-jem.</p>
        <a class="button button-primary" href={searchPath}>Nazaj na iskalnik tekov</a>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  import { trackStkPageLoadEventOnce } from '../../../lib/stkAnalytics';
  import { initSavedRaceButtons } from '../../../saved-races-client';
  initSavedRaceButtons();
  const detailRoot = document.querySelector<HTMLElement>('[data-event-detail-view]');
  if (detailRoot) {
    trackStkPageLoadEventOnce(`event_detail_viewed:${detailRoot.dataset.analyticsEventYear}:${detailRoot.dataset.analyticsEventId}`, {
      event_type: 'event_detail_viewed',
      event_id: detailRoot.dataset.analyticsEventId || '',
      event_name: detailRoot.dataset.analyticsEventName || '',
      event_date: detailRoot.dataset.analyticsEventDate || '',
      event_year: detailRoot.dataset.analyticsEventYear || '',
      placement: 'race_detail'
    });
  }
  const copyLinkButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-share-url]');
  const copyTextButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-share-text]');

  const facebookShareButtons = document.querySelectorAll<HTMLAnchorElement>('[data-facebook-share-button]');
  const feedback = document.querySelector<HTMLElement>('[data-share-feedback]');

  const setShareFeedback = (message: string) => {
    if (feedback) feedback.textContent = message;
  };

  const copyWithFallback = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return true;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'absolute';
    textarea.style.left = '-9999px';
    document.body.appendChild(textarea);
    textarea.select();

    const copied = document.execCommand('copy');
    textarea.remove();

    if (!copied) throw new Error('copy failed');
    return true;
  };


  facebookShareButtons.forEach((shareButton) => {
    shareButton.addEventListener('click', async () => {
      const shareText = shareButton.getAttribute('data-copy-share-text') || '';
      try {
        await copyWithFallback(shareText);
        setShareFeedback(shareButton.getAttribute('data-facebook-copy-success') || '');
      } catch {
        setShareFeedback(shareButton.getAttribute('data-facebook-copy-failure') || '');
      }
    });
  });

  copyLinkButtons.forEach((copyButton) => {
    copyButton.addEventListener('click', async () => {
      const shareUrl = copyButton.getAttribute('data-copy-share-url') || window.location.href;
      try {
        await copyWithFallback(shareUrl);
        setShareFeedback('Povezava kopirana.');
      } catch {
        setShareFeedback('Povezave ni bilo mogoče kopirati.');
      }
    });
  });

  copyTextButtons.forEach((copyButton) => {
    copyButton.addEventListener('click', async () => {
      const shareText = copyButton.getAttribute('data-copy-share-text') || '';
      try {
        await copyWithFallback(shareText);
        setShareFeedback('Kopirano.');
      } catch {
        setShareFeedback('Opisa ni bilo mogoče kopirati.');
      }
    });
  });
</script>
