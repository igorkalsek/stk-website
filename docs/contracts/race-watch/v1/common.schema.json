{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stk:race-watch:v1:common",
  "$defs": {
    "edition_id": {
      "type": "string",
      "pattern": "^ed_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rv_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "year": {
      "type": "string",
      "pattern": "^20[0-9]{2}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/@\\s]+(?:[/?#]|$)",
          "maxLength": 2048
        },
        "kind": {
          "enum": [
            "organizer_notice",
            "authorized_portal",
            "public_confirmation_summary"
          ]
        },
        "authority_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "url",
        "kind",
        "authority_basis"
      ]
    },
    "identity_proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "reviewed_same_edition"
          ]
        },
        "verified_at": {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
        },
        "public_reference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "kind": {
              "enum": [
                "organizer_notice",
                "authorized_portal",
                "public_confirmation_summary"
              ]
            },
            "authority_basis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "url",
            "kind",
            "authority_basis"
          ]
        }
      },
      "required": [
        "method",
        "verified_at",
        "public_reference"
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet": {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/year"
        },
        "row": {
          "type": "integer",
          "minimum": 2
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "sheet",
        "row",
        "generation"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^bd_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "locator": {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/locator"
        },
        "valid_from": {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "proof": {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/identity_proof"
        }
      },
      "required": [
        "binding_id",
        "locator",
        "valid_from",
        "valid_to",
        "proof"
      ]
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "enum": [
            "master_locator",
            "website_event_id",
            "organizer_event_id",
            "legacy_edition_key"
          ]
        },
        "year": {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/year"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "saved_date": {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/date"
        },
        "binding_id": {
          "type": "string",
          "pattern": "^bd_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "resolution": {
          "enum": [
            "unique",
            "ambiguous",
            "conflict"
          ]
        },
        "proof": {
          "anyOf": [
            {
              "$ref": "urn:stk:race-watch:v1:common#/$defs/identity_proof"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "namespace",
        "year",
        "key",
        "saved_date",
        "binding_id",
        "resolution",
        "proof"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "unique"
              }
            }
          },
          "then": {
            "properties": {
              "proof": {
                "$ref": "urn:stk:race-watch:v1:common#/$defs/identity_proof"
              }
            }
          }
        }
      ]
    },
    "availability": {
      "enum": [
        "available",
        "partial",
        "unavailable"
      ]
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    }
  }
}
