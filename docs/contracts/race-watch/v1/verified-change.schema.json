{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stk:race-watch:v1:revision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revision_id": {
      "$ref": "urn:stk:race-watch:v1:common#/$defs/revision_id"
    },
    "edition_id": {
      "$ref": "urn:stk:race-watch:v1:common#/$defs/edition_id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "change_set_id": {
      "type": "string",
      "pattern": "^cs_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "change_type": {
      "enum": [
        "rescheduled",
        "cancelled",
        "time_changed",
        "venue_changed"
      ]
    },
    "field": {
      "enum": [
        "date",
        "status",
        "start_time",
        "venue"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "event",
            "route"
          ]
        },
        "route_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "route_id"
      ]
    },
    "before": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "after": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "official_source": {
      "$ref": "urn:stk:race-watch:v1:common#/$defs/source"
    },
    "source_published_at": {
      "anyOf": [
        {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_at": {
      "anyOf": [
        {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_at": {
      "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
    },
    "verified_at": {
      "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
    },
    "recorded_at": {
      "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
    },
    "published_at": {
      "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
    },
    "valid_until": {
      "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
    },
    "evidence_state": {
      "enum": [
        "active",
        "expired",
        "superseded",
        "retracted",
        "conflict"
      ]
    },
    "supersedes_revision_id": {
      "anyOf": [
        {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/revision_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "retracted_at": {
      "anyOf": [
        {
          "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "revision_id",
    "edition_id",
    "sequence",
    "change_set_id",
    "change_type",
    "field",
    "scope",
    "before",
    "after",
    "official_source",
    "source_published_at",
    "effective_at",
    "confirmed_at",
    "verified_at",
    "recorded_at",
    "published_at",
    "valid_until",
    "evidence_state",
    "supersedes_revision_id",
    "retracted_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "change_type": {
            "const": "rescheduled"
          }
        }
      },
      "then": {
        "properties": {
          "field": {
            "const": "date"
          },
          "before": {
            "$ref": "urn:stk:race-watch:v1:common#/$defs/date"
          },
          "after": {
            "anyOf": [
              {
                "$ref": "urn:stk:race-watch:v1:common#/$defs/date"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_type": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "field": {
            "const": "status"
          },
          "before": {
            "enum": [
              "scheduled",
              "postponed"
            ]
          },
          "after": {
            "const": "cancelled"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_type": {
            "const": "time_changed"
          }
        }
      },
      "then": {
        "properties": {
          "field": {
            "const": "start_time"
          },
          "before": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "after": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_type": {
            "const": "venue_changed"
          }
        }
      },
      "then": {
        "properties": {
          "field": {
            "const": "venue"
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "event"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "route_id": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scope": {
            "properties": {
              "route_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_state": {
            "const": "retracted"
          }
        }
      },
      "then": {
        "properties": {
          "retracted_at": {
            "$ref": "urn:stk:race-watch:v1:common#/$defs/timestamp"
          }
        }
      },
      "else": {
        "properties": {
          "retracted_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
